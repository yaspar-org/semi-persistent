; MLTL rewrites for Semper. Ported from the FMCAD 2026 artifact's egglog rules:
; c2po/egglog/rewrites/{temporal,const_folding}.egg.
;
; Three files of that set are not ported because the declarations replace them:
;
;   associative.egg   4 rules   subsumed by :assoc
;   commutative.egg   4 rules   subsumed by :comm
;   multi_arity.egg  24 rules   arity plumbing and idempotence variants, subsumed
;                               by the single variadic node plus :idempotent
;
; and four rules of temporal.egg are dropped for the same reason: `And2 a (Bool
; true)` and `Or2 a (Bool false)` are the declared identities, `And2 a a` and
; `Or2 a a` the declared idempotence.
;
; Every rule whose egglog form mentions And2 or Or2 gains a `..rest` remainder, so
; it matches a pair inside a conjunction of any size. egglog reaches arity four and
; needs the explicit commutative rewrites to see the pair at all.
;
; Interval arithmetic that egglog writes with guard-bound helpers, as in
; `:when ((= b4 (min b0 b2)))`, is inlined on the right-hand side: Semper guards
; test, they do not bind.

; --- negation, implication, equivalence ---------------------------------------

(rewrite (Not (Not a0)) a0 :subsume)

(birewrite (Implies a0 a1) (Or (Not a0) a1))

(birewrite (Equiv a0 a1)
           (Or (And a0 a1) (And (Not a0) (Not a1))))

; De Morgan. The distributing direction covers the whole collection in one rule
; through a comprehension, where the binary egglog rules needed the associative and
; commutative set to reach a pair. The collecting direction cannot be n-ary: a
; pattern cannot destructure the elements of a remainder, so it takes two elements
; at a time out of a collection of any size, which reaches the same normal form in
; more rounds. `birewrite` is unavailable here because both of its sides must be
; patterns and a comprehension is a right-hand-side form.
(rewrite (Not (And ..rest)) (Or ..{(Not x) for x in rest}))
(rewrite (Or (Not a0) (Not a1) ..rest) (Or (Not (And a0 a1)) ..rest))
(rewrite (Not (Or ..rest)) (And ..{(Not x) for x in rest}))
(rewrite (And (Not a0) (Not a1) ..rest) (And (Not (Or a0 a1)) ..rest))

; --- duality of the temporal operators ---------------------------------------

(birewrite (Not (Until (Interval b0 b1) a0 a1))
           (Release (Interval b0 b1) (Not a0) (Not a1)))
(birewrite (Not (Release (Interval b0 b1) a0 a1))
           (Until (Interval b0 b1) (Not a0) (Not a1)))
(birewrite (Not (Future (Interval b0 b1) a0))
           (Global (Interval b0 b1) (Not a0)))
(birewrite (Not (Global (Interval b0 b1) a0))
           (Future (Interval b0 b1) (Not a0)))

(birewrite (Until (Interval b0 b1) (Bool true) a0) (Future (Interval b0 b1) a0))
(birewrite (Release (Interval b0 b1) (Bool false) a0) (Global (Interval b0 b1) a0))

; A point interval makes the two quantifiers agree.
(birewrite (Future (Interval b0 b0) a0) (Global (Interval b0 b0) a0))

; --- collapsing nested bounded operators -------------------------------------

(rewrite (Global (Interval b0 b1) (Global (Interval b2 b3) a0))
         (Global (Interval (i64::+ b0 b2) (i64::+ b1 b3)) a0))
(rewrite (Future (Interval b0 b1) (Future (Interval b2 b3) a0))
         (Future (Interval (i64::+ b0 b2) (i64::+ b1 b3)) a0))

; A point interval outside or inside turns the pair into one operator.
(rewrite (Global (Interval b0 b1) (Future (Interval b2 b2) a0))
         (Global (Interval (i64::+ b2 b0) (i64::+ b2 b1)) a0))
(rewrite (Future (Interval b0 b1) (Global (Interval b2 b2) a0))
         (Future (Interval (i64::+ b2 b0) (i64::+ b2 b1)) a0))
(rewrite (Global (Interval b0 b0) (Future (Interval b1 b2) a0))
         (Future (Interval (i64::+ b0 b1) (i64::+ b0 b2)) a0))
(rewrite (Future (Interval b0 b0) (Global (Interval b1 b2) a0))
         (Global (Interval (i64::+ b0 b1) (i64::+ b0 b2)) a0))

(rewrite (Future (Interval b0 b0) (Until (Interval b1 b2) a0 a1))
         (Until (Interval (i64::+ b1 b0) (i64::+ b2 b0)) a0 a1))
(rewrite (Until (Interval b0 b1) (Future (Interval b2 b2) a0) (Future (Interval b2 b2) a1))
         (Until (Interval (i64::+ b0 b2) (i64::+ b1 b2)) a0 a1))

(rewrite (Global (Interval 0 0) a0) a0 :subsume)
(rewrite (Future (Interval 0 0) a0) a0 :subsume)
(rewrite (Until (Interval 0 0) a0 a1) a1 :subsume)
(rewrite (Release (Interval 0 0) a0 a1) a1 :subsume)
(rewrite (Until (Interval b0 b0) a0 a1) (Future (Interval b0 b0) a1))

; --- until and release against their operands --------------------------------

(rewrite (Until (Interval b0 b1) a0 (Global (Interval 0 b2) a0))
         (Global (Interval b0 (i64::+ b0 b2)) a0))
(rewrite (Until (Interval b0 b1) a0 (Future (Interval 0 b2) a0))
         (Future (Interval b0 (i64::+ b0 b2)) a0))

; --- merging two bounded operators over the same operand ---------------------

; Adjacent or overlapping windows join. The guard `b2 <= b1 + 1` is the adjacency
; condition; Semper guards nest primitives, so it needs no helper binding.
(rewrite (And (Global (Interval b0 b1) a0) (Global (Interval b2 b3) a0) ..rest)
         (And (Global (Interval b0 (i64::max b1 b3)) a0) ..rest)
  :when ((i64::<= b0 b2) (i64::<= b2 (i64::+ b1 1))))
(rewrite (Or (Future (Interval b0 b1) a0) (Future (Interval b2 b3) a0) ..rest)
         (Or (Future (Interval b0 (i64::max b1 b3)) a0) ..rest)
  :when ((i64::<= b0 b2) (i64::<= b2 (i64::+ b1 1))))

; A contained window absorbs the containing one.
(rewrite (Or (Global (Interval b0 b1) a0) (Global (Interval b2 b3) a0) ..rest)
         (Or (Global (Interval b2 b3) a0) ..rest)
  :when ((i64::<= b0 b2) (i64::<= b3 b1)) :subsume)
(rewrite (And (Future (Interval b0 b1) a0) (Future (Interval b2 b3) a0) ..rest)
         (And (Future (Interval b2 b3) a0) ..rest)
  :when ((i64::<= b0 b2) (i64::<= b3 b1)) :subsume)

; --- factoring a common operator out of a pair -------------------------------

; The rule the paper's memory reductions come from: pulling a common window out of
; two bounded operators shortens the inner windows and lowers the queues. egglog
; binds the new bounds in a guard; here they are inlined, which needs nested
; primitive expressions on a right-hand side.
(rewrite (And (Global (Interval b0 b1) a0) (Global (Interval b2 b3) a1) ..rest)
         (And (Global (Interval (i64::min b0 b2)
                                (i64::+ (i64::min b0 b2)
                                        (i64::min (i64::- b1 b0) (i64::- b3 b2))))
                      (And (Global (Interval (i64::- b0 (i64::min b0 b2))
                                             (i64::- b1 (i64::+ (i64::min b0 b2)
                                                                (i64::min (i64::- b1 b0)
                                                                          (i64::- b3 b2)))))
                                   a0)
                           (Global (Interval (i64::- b2 (i64::min b0 b2))
                                             (i64::- b3 (i64::+ (i64::min b0 b2)
                                                                (i64::min (i64::- b1 b0)
                                                                          (i64::- b3 b2)))))
                                   a1)))
              ..rest))

(rewrite (Or (Future (Interval b0 b1) a0) (Future (Interval b2 b3) a1) ..rest)
         (Or (Future (Interval (i64::min b0 b2)
                               (i64::+ (i64::min b0 b2)
                                       (i64::min (i64::- b1 b0) (i64::- b3 b2))))
                     (Or (Future (Interval (i64::- b0 (i64::min b0 b2))
                                           (i64::- b1 (i64::+ (i64::min b0 b2)
                                                              (i64::min (i64::- b1 b0)
                                                                        (i64::- b3 b2)))))
                                 a0)
                         (Future (Interval (i64::- b2 (i64::min b0 b2))
                                           (i64::- b3 (i64::+ (i64::min b0 b2)
                                                              (i64::min (i64::- b1 b0)
                                                                        (i64::- b3 b2)))))
                                 a1)))
             ..rest))

; The point-interval variant, where only the lower bound is factored out.
(rewrite (And (Future (Interval b0 b1) a0) (Future (Interval b2 b3) a1) ..rest)
         (And (Future (Interval b0 b0)
                      (And (Future (Interval 0 (i64::- b1 b0)) a0)
                           (Future (Interval (i64::- b2 b0) (i64::- b3 b0)) a1)))
              ..rest)
  :when ((i64::<= b0 b2)))
(rewrite (Or (Global (Interval b0 b1) a0) (Global (Interval b2 b3) a1) ..rest)
         (Or (Global (Interval b0 b0)
                     (Or (Global (Interval 0 (i64::- b1 b0)) a0)
                         (Global (Interval (i64::- b2 b0) (i64::- b3 b0)) a1)))
             ..rest)
  :when ((i64::<= b0 b2)))

; --- implied bounds between an eventually and an always ----------------------

(rewrite (And (Until (Interval b0 b1) a0 a1) (Until (Interval b0 b2) a2 a1) ..rest)
         (And (Until (Interval b0 b1) (And a0 a2) a1) ..rest)
  :when ((i64::<= b1 b2)))

(rewrite (And (Until (Interval b0 b1) a0 a1) (Future (Interval b2 b3) a1) ..rest)
         (And (Until (Interval b0 b1) a0 a1) ..rest)
  :when ((i64::<= b1 b3) (i64::<= b2 b0)) :subsume)

(rewrite (Or (Global (Interval b0 b1) a0) (Release (Interval b2 b3) a1 a0) ..rest)
         (Or (Global (Interval b0 b1) a0) (Release (Interval b2 b1) a1 a0) ..rest)
  :when ((i64::<= b1 b3) (i64::<= b2 b0)))

; An always over the negation narrows the window an eventually needs to search.
(rewrite (And (Global (Interval b0 b1) (Not a0)) (Future (Interval b2 b3) a0) ..rest)
         (And (Global (Interval b0 b1) (Not a0))
              (Future (Interval (i64::+ b1 1) b3) a0) ..rest)
  :when ((i64::<= b0 b2) (i64::<= b2 (i64::+ b1 1)) (i64::< b1 b3)))
(rewrite (And (Global (Interval b0 b1) (Not a0)) (Future (Interval b2 b3) a0) ..rest)
         (And (Global (Interval b0 b1) (Not a0))
              (Future (Interval b2 (i64::- b0 1)) a0) ..rest)
  :when ((i64::< b2 b0) (i64::<= b0 b3) (i64::<= b3 b1)))

; --- the FRET response pattern ------------------------------------------------

; The remainder of the disjunction must be spliced back, not dropped. Under the
; antecedent the always-operand is implied by the until, so removing *that* disjunct
; is sound; the other disjuncts are arbitrary and discarding them would strengthen
; the consequent. The egglog original had no remainder to preserve because its
; consequent was exactly the two-disjunct form.
(rewrite (Implies (And a0 (Future (Interval b0 b1) a1) ..r1)
                  (Or (Until (Interval b0 b1) a2 a1) (Global (Interval b0 b1) a2) ..r2))
         (Implies (And a0 (Future (Interval b0 b1) a1) ..r1)
                  (Or (Until (Interval b0 b1) a2 a1) ..r2)))

; --- constant folding ---------------------------------------------------------

(rewrite (Not (Bool true)) (Bool false))
(rewrite (Not (Bool false)) (Bool true))

; The absorbing elements. Semper carries the identities by declaration, but an
; absorbing element is not a declaration tag, so these stay rules.
(rewrite (And (Bool false) ..rest) (Bool false) :subsume)
(rewrite (Or (Bool true) ..rest) (Bool true) :subsume)

; Complementary pair anywhere in the collection. This is AC matching with a
; remainder; egglog without the commutative rules cannot see the pair.
(rewrite (And a0 (Not a0) ..rest) (Bool false))
(rewrite (Or a0 (Not a0) ..rest) (Bool true))

(rewrite (Global (Interval b0 b1) (Bool false)) (Bool false) :subsume)
(rewrite (Global (Interval b0 b1) (Bool true)) (Bool true) :subsume)
(rewrite (Future (Interval b0 b1) (Bool false)) (Bool false) :subsume)
(rewrite (Future (Interval b0 b1) (Bool true)) (Bool true) :subsume)

(rewrite (Or (Future (Interval b0 b1) a0) (Global (Interval b0 b1) (Not a0)) ..rest)
         (Bool true))

(rewrite (And (Global (Interval b0 b1) (Not a0)) (Future (Interval b2 b3) a0) ..rest)
         (Bool false)
  :when ((i64::<= b0 b2) (i64::<= b3 b1)))
(rewrite (And (Global (Interval b0 b1) a0) (Future (Interval b2 b3) (Not a0)) ..rest)
         (Bool false)
  :when ((i64::<= b0 b2) (i64::<= b3 b1)))
