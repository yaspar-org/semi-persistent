(sort Int  :interp int)
(sort Bool :interp bool)
(constructor x () Int)
(constructor scale (Int) Int)
(constructor Sq (Int) Int)
(constructor IsPos (Int) Bool)
(rule ((= r (scale y)) (within y 0 9)) ((refine r (interval 0 99))))
(rule ((= r (Sq y))) ((refine r (interval 0 1000000)) (refine r (congruence 0 1))))
(rule ((= b (IsPos y)) (nonzero y)) ((refine b (true)) (Sq y)))
(scale (x))
(Sq (x))
(IsPos (x))
(run 3)
(check-eq (Sq (x)) (Sq (x)))
