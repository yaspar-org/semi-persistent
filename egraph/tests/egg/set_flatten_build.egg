;; EXPECT: ok
;; DERIVE_AC_EQS: off
;; Build-side flattening for Set (ACI) ops (WF_flat), completion OFF: nested same-op
;; children splice at construction exactly as for MSet ops. This ensures
;; `(Or (Or x y) z)` and `(Or x y z)` land in the same class without completion.
(sort E)
(function Or (E) E :assoc-comm-idem)
(function x () E)
(function y () E)
(function z () E)
(function w () E)
(let nested (Or (Or (x) (y)) (z)))
(let flat (Or (x) (y) (z)))
(let deep (Or (Or (Or (x) (y)) (z)) (w)))
(let flat4 (Or (x) (y) (z) (w)))
(run 3)
(check (= nested flat))
(check (= deep flat4))
