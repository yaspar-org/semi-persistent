;; TYPES: machine
;; The multiplicity variant closes the partition-semantics gap pinned by
;; ac_multiplicity_variant_gap.egg: an element consumes its child's whole
;; multiplicity, so `(Const a):k>=2` matches the same summand taken k times,
;; and k is readable on the RHS as an i64 (prim arg and literal position).
;; Covers the literal-element variant (k*a, a^k) and the compound-element variant
;; (rest variable inside the doubled element, k reinserted as a factor).
(datatype Math
    (Add Math :assoc-comm)
    (Mul Math :assoc-comm)
    (Const i64))

(rewrite (Add (Const a) (Const b) ..rest) (Add (Const (i64::+ a b)) ..rest))
(rewrite (Add (Const a):k>=2 ..rest) (Add (Const (i64::* a k)) ..rest))
(rewrite (Mul (Const a) (Const b) ..rest) (Mul (Const (i64::* a b)) ..rest))
(rewrite (Mul (Const a):k>=2 ..rest) (Mul (Const (i64::pow a k)) ..rest))
(rewrite (Add (Mul a ..p) (Mul a ..q) ..rest)
         (Add (Mul a (Add (Mul ..p) (Mul ..q))) ..rest))
(rewrite (Add (Mul a ..p):k>=2 ..rest)
         (Add (Mul a (Const k) ..p) ..rest))

(let sq (Add (Const 4) (Const 4)))
(let triple (Add (Const 2) (Const 2) (Const 2)))
(let cube (Mul (Const 3) (Const 3) (Const 3)))
(let fact (Add (Mul (Const 5) (Const 7)) (Mul (Const 5) (Const 7))))
(run 4)
(check (= sq (Const 8)))
(check (= triple (Const 6)))
(check (= cube (Const 27)))
(check (= fact (Const 70)))
