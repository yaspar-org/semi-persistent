;; EXPECT: ok
;; TYPES: machine
;; DERIVE_AC_EQS: on
;; WARNING: none
;; Completion normalizes Plus(c:2000000, d:2000000) by the ground rule c+d -> b in one
;; batch of 2,000,000 copies. It applied the rule one copy at a time, and the 2,000,000
;; rewrites exceeded the 1,000,000-rewrite guard and panicked.
(sort E)
(function b () E) (function c () E) (function d () E)
(function Plus (E) E :assoc-comm)
(let t (Plus (c):2000000 (d):2000000))
(union (Plus (c) (d)) (b))
(run 1)
(check (= t (Plus (b):2000000)))
