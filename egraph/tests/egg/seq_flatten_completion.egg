;; EXPECT: check-failed
;; TYPES: machine
;; DERIVE_AC_EQS: on
;; Edge cases 5 without `:flatten`, with AC completion on: completion is not what makes
;; the nested conjunction matchable. It orients equalities toward the reduced form and
;; proves And{g1, cc} equal to the flat conjunction, but it builds no flat node, so the
;; untagged rule still reads the stored children {g1, cc}, holds one `Global`, and does
;; not fire. This program pins that negative result; seq_flatten.egg is the program
;; that matches, through `:flatten`, with completion off.
(sort IntervalSort)
(function Interval (i64 i64) IntervalSort)

(sort MLTL)
(function Bool (bool) MLTL)
(function Var (String) MLTL)
(function Not (MLTL) MLTL)
(function Implies (MLTL MLTL) MLTL)
(function Equiv (MLTL MLTL) MLTL)
; Variadic, unordered, duplicate-free, with a unit. One node represents every
; reassociation and permutation of the conjunction.
(function And (MLTL) MLTL :assoc-comm-idem :identity (Bool true))
(function Or (MLTL) MLTL :assoc-comm-idem :identity (Bool false))
(function Global (IntervalSort MLTL) MLTL)
(function Future (IntervalSort MLTL) MLTL)
(function Until (IntervalSort MLTL MLTL) MLTL)
(function Release (IntervalSort MLTL MLTL) MLTL)
(let va (Var "a"))
(let vb (Var "b"))
(let vc (Var "c"))
(let g1 (Global (Interval 1 3) va))
(let g2 (Global (Interval 2 5) vb))
(let g3 (Global (Interval 3 6) vc))
(let cc (Var "cc"))
(let e (And g1 cc))
(union cc (And g2 g3))
; Factoring: all G in a conjunction share the outer window [K0, K1], K0 = min l,
; K1 = K0 + min (u - l), over one flat inner conjunction. An inner window of
; [0,0] is its operand. The outer window [0,0] would be the identity.
(rewrite (And (..gs (Global (Interval l u) p)) ..rest)
         (And (Global (Interval K0 K1)
                      (And ..{ (if (and (== l K0) (== u K1)) p (Global (Interval (- l K0) (- u K1)) p))
                               for (l u p) in (zip l u p) }))
              ..rest)
  :let ((K0 (min l)) (K1 (+ K0 (min (- u l)))))
  :when ((>= (count gs) 2) (> K1 0) (== (count (union-by p l u)) (count gs))))
(run 1)
(check (= e (Global (Interval 1 3) (And va (Global (Interval 1 2) vb) (Global (Interval 2 3) vc)))))
