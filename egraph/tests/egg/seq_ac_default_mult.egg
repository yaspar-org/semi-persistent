;; EXPECT: ok
;; TYPES: machine
;; Absent multiplicity means 1 in every rule (decided 2026-09-30). On
;; (Plus (F a):3 (F b) c), the unannotated filter (..fs (F y)) takes only (F b), the
;; child of multiplicity 1, and leaves (F a):3 and c to the rest; the annotated
;; (..ks:k (F y)) takes both F children with their multiplicities.
(sort E)
(function a () E)
(function b () E)
(function c () E)
(function F (E) E)
(function Only (E) E)
(function All (E) E)
(function Plus (E) E :assoc-comm)
(function Src () E)
(let src (Src))
(rewrite (Src) (Plus (F (a)):3 (F (b)) (c)))
(run 1)
; What the unannotated filter takes goes into Only; what the annotated one takes into All.
(rewrite (Plus (..fs (F y)) ..rest) (Only (Plus ..fs)))
(rewrite (Plus (..ks:k (F y)) ..rest) (All (Plus ..ks)))
(run 1)
(check (= src (Only (F b))))
(check (= src (All (Plus (F a) (F a) (F a) (F b)))))
