;; EXPECT: ok
;; TYPES: machine
;; "§Edge cases 3": an ACI sequence spliced under an AC operator gives each child
;; with multiplicity 1.
(sort E)
(function a () E)
(function b () E)
(function F (E) E)
(function Cat (E) E :assoc)
(function And (E) E :assoc-comm-idem)
(function Plus (E) E :assoc-comm)
(let e (And (F a) (F b) b))
(rewrite (And (..fs (F x)) ..rest) (Plus ..fs))
(run 1)
(check (= e (Plus (F a) (F b))))
