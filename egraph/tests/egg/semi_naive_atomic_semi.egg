;; EVAL: semi
;; EXPECT: check-failed
;; MESSAGE: no match for
;; ASSERTS AN INCOMPLETENESS, ON PURPOSE: naive and semi-naive reach different fixpoints here.
;; The companion `semi_naive_atomic_naive.egg` is the same program under naive, where (W (C))
;; holds; `semi_naive_atomic_eager.egg` runs it under eager completion, where both pass.
;;
;; In plain mode the node a right-hand side builds depends on whether a class is `atomic` at
;; build time (`flatten_mset_children`, design §6c), and the bit flips as the graph grows.
;; Round 1 builds Q's argument flat, `Add{A,B,C}`, before the H action makes `[Add(A,B)]`
;; atomic. Naive re-fires the old (P (C)) match and builds the nested `Add{[A+B],C}` the second
;; rule needs; semi-naive does not re-fire a match whose nodes did not change, and the atomic
;; flip is not in its delta. Design §9.2 and 13-soundness.md §5 list the limit and the fix
;; options.
(sort E)
(function A () E) (function B () E) (function C () E)
(function Add (E) E :assoc-comm)
(function P (E) E) (function Q (E) E) (function H (E) E) (function W (E) E)
(let p (P (C)))
(rule ((P y)) ((Q (Add (Add (A) (B)) y)) (H (Add (A) (B)))))
(rule ((Q (Add (Add (A) (B)) w))) ((W w)))
(run 10)
(check (W (C)))
