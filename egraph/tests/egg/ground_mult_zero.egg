;; EXPECT: sort-error
;; TYPES: machine
;; MESSAGE: a ground multiplicity is at least 1
;; A ground term writes every child it has: a count of 0 is rejected.
(sort E)
(function a () E) (function b () E)
(function Plus (E) E :assoc-comm)
(let t (Plus (a):0 (b)))
