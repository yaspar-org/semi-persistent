;; EXPECT: ok
;; TYPES: machine
;; String ops in ground terms
(datatype Expr (S String) (N usize) (B bool))

(check-eq (S (String::concat "hello " "world")) (S "hello world"))
(check-eq (B (String::contains "abcdef" "cde")) (B true))
(check-eq (B (String::contains "abc" "xyz")) (B false))
(check-eq (S (String::replace "hello world" "world" "rust")) (S "hello rust"))
(check-eq (B (String::== "abc" "abc")) (B true))
(check-eq (B (String::!= "abc" "def")) (B true))
(check-eq (N (String::len "hello")) (N 5))
(check-eq (S (String::substr "hello world" 6 5)) (S "world"))
(check-eq (S (String::at "hello" 0)) (S "h"))
(check-eq (S (String::if true "yes" "no")) (S "yes"))
