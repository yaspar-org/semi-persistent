;; EXPECT: ok
;; TYPES: machine
;; A global name inside a filter is the global: `(..gs (Wrap a))` takes `(Wrap A)`
;; and leaves `(Wrap B)` to the rest (doc/sequence-patterns.md, Grammar).
(sort E)
(function A () E)
(function B () E)
(function Wrap (E) E)
(function Mark (E) E)
(function And (E) E :assoc-comm-idem)
(let a A)
(let e (And (Wrap A) (Wrap B)))
(rewrite (And (..gs (Wrap a)) ..rest) (Mark (And ..gs)))
(run 1)
(check (= e (Mark (Wrap A))))
