;; EXPECT: check-failed
;; TYPES: machine
;; The control for flatten_nested.egg: without `:flatten` the rule reads the stored
;; children {Not p, K}, which hold one negation, so it does not fire and the check fails.
(sort E)
(function a () E) (function b () E) (function c () E) (function p () E) (function q () E)
(function r () E) (function s () E) (function t () E) (function Kc () E) (function Cc () E)
(function Not (E) E)
(function Or (E) E :assoc-comm-idem)
(function And (E) E :assoc-comm-idem)
(let k (Kc))
(let top (And (Not (p)) k))
(union k (And (Not (q)) (r)))
(rewrite (And (Not a0) (Not a1) ..rest) (And (Not (Or a0 a1)) ..rest))
(run 1)
(check (= top (And (Not (Or (p) (q))) (r))))
