;; TYPES: machine
;; Translation of egglog tests/web-demo/resolution.egg (7b1adf2).
;; Ground resolution over CNF clauses encoded as right-nested myor chains
;; terminated by false. Associativity, commutativity, absorption and
;; simplification are explicit rewrite rules, their encoding. Deviations:
;; comparison/resolution.deviations.md.
(datatype Bool
    (myor Bool Bool)
    (negate Bool))
(constructor TrueConst () Bool)
(let tt (TrueConst))
(constructor FalseConst () Bool)
(let ff (FalseConst))

(union (negate ff) tt)
(union (negate tt) ff)

; solving negation equations
(rule ((= x (negate p)) (= x tt)) ((union p ff)))
(rule ((= x (negate p)) (= x ff)) ((union p tt)))

; associativity and commutativity
(rewrite (myor (myor a b) c) (myor a (myor b c)))
(rewrite (myor a (myor b c)) (myor b (myor a c)))

; absorption
(rewrite (myor a (myor a b)) (myor a b))
(rewrite (myor a (myor (negate a) b)) tt)

; simplification
(rewrite (myor ff a) a)
(rewrite (myor a ff) a)
(rewrite (myor tt a) tt)
(rewrite (myor a tt) tt)

; unit propagation
(rule ((= x (myor p ff)) (= x tt)) ((union p tt)))

; resolution
(rule ((= c1 (myor a as)) (= c1 tt) (= c2 (myor (negate a) bs)) (= c2 tt))
      ((union (myor as bs) tt)))

; example predicate
(constructor p (i64) Bool)
(let p0 (p 0))
(let p1 (p 1))
(let p2 (p 2))
(union (myor p1 (myor (negate p2) ff)) tt)
(union (myor p2 (myor (negate p0) ff)) tt)
(union (myor p0 (myor (negate p1) ff)) tt)
(union p1 ff)
(union (myor (negate p0) (myor p1 (myor p2 ff))) tt)
(run 10)

(check (!= tt ff))
(check (= p0 ff))
(check (= p2 ff))
(print-size)
(print-stats :file "resolution.rules.stats.json")
