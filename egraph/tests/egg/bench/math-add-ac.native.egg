;; TYPES: machine
;; Translation of the `add-ac` ruleset block of egglog tests/web-demo/math.egg
;; (7b1adf2, lines 138-160), extracted standalone.
;; Config: native AC. Add is declared variadic :assoc-comm and the two rewrite rules
;; are deleted; the ruleset is kept declared and still run, so the command sequence is
;; identical to math-add-ac.rules.egg. See math-add-ac.deviations.md.
(datatype Math
    (Add Math :assoc-comm)
    (Const f64))

(ruleset add_ac)
;; Add one through seven
(let res
  (Add (Const 1.0)
       (Add (Const 2.0)
            (Add (Const 3.0)
                 (Add (Const 4.0)
                      (Add (Const 5.0)
                           (Add (Const 6.0)
                                (Const 7.0))))))))
(run add_ac 7)
(check (= res
  (Add (Const 7.0)
       (Add (Const 6.0)
            (Add (Const 5.0)
                 (Add (Const 4.0)
                      (Add (Const 3.0)
                           (Add (Const 2.0)
                                (Const 1.0)))))))))
(print-size)
(print-stats :file "math-add-ac.native.stats.json")
