;; EXPECT: ok
;; DERIVE_AC_EQS: on
;; CHECK_AC_BASIS: on
;; Idempotent per-rule axiom critical pairs (Kapur Lemma 4.1(ii)):
;; superposing a rule f(M)→f(N) with x∘x = x gives, per a ∈ M, the pair (f(M), f(N∪{a})).
;; or(a,b) = c  ⟹  or(a,c) = c and or(b,c) = c  (a∨c = a∨a∨b = a∨b = c). The derived
;; rule {a,c}→{c} must itself superpose with ordinary rules: with or(c,d) = f,
;; or(a,f) = f follows (a∨f = a∨c∨d = c∨d = f).
(sort E)
(function Or (E) E :assoc-comm-idem)
(function a () E)
(function b () E)
(function c () E)
(function d () E)
(function f () E)

(let s_ab (Or (a) (b)))
(union s_ab (c))
(let s_ac (Or (a) (c)))
(let s_bc (Or (b) (c)))
(let s_cd (Or (c) (d)))
(union s_cd (f))
(let s_af (Or (a) (f)))

(run 5)
(check (= s_ac (c)))
(check (= s_bc (c)))
(check (= s_af (f)))
