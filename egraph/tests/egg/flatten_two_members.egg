;; EXPECT: ok
;; TYPES: machine
;; `:flatten` with a class of two conjunction members: K ≡ And{Not q, r} ≡ And{Not s, t}.
;; Each member gives the root And{Not p, K} its own view, and the pairwise rule matches
;; both.
(sort E)
(function a () E) (function b () E) (function c () E) (function p () E) (function q () E)
(function r () E) (function s () E) (function t () E) (function Kc () E) (function Cc () E)
(function Not (E) E)
(function Or (E) E :assoc-comm-idem)
(function And (E) E :assoc-comm-idem)
(let k (Kc))
(let top (And (Not (p)) k))
(union k (And (Not (q)) (r)))
(union k (And (Not (s)) (t)))
(rewrite (And (Not a0) (Not a1) ..rest) (And (Not (Or a0 a1)) ..rest) :flatten)
(run 1)
(check (= top (And (Not (Or (p) (q))) (r))))
(check (= top (And (Not (Or (p) (s))) (t))))
