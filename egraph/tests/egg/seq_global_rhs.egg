;; EXPECT: ok
;; TYPES: machine
;; A global on the right-hand side builds its class.
(sort E)
(function A () E)
(function B () E)
(function Wrap (E) E)
(function Mark (E) E)
(function And (E) E :assoc-comm-idem)
(let a A)
(let e (And (Wrap A) (Wrap B)))
(rewrite (And (..gs (Wrap x)) ..rest) (Mark a))
(run 1)
(check (= e (Mark A)))
