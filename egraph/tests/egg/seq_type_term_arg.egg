;; EXPECT: sort-error
;; MESSAGE: a sequence used as a scalar
;; TYPES: machine
;; "§Typing": outside its pattern a filter's variable is a sequence, which a
;; term's argument cannot be.
(sort E)
(function a () E)
(function F (E) E)
(function G (E) E)
(function N (i64) E)
(function And (E) E :assoc-comm-idem)
(rewrite (And (..gs (F x)) ..rest) (And (G x) ..rest))
