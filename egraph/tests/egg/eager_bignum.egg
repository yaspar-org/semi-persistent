;; EXPECT: ok
;; TYPES: bignum
;; Bignum ops in ground terms
(datatype I (IV IBig))
(datatype U (UV UBig))
(datatype R (RV RBig))
(datatype Expr (B bool))

;; IBig
(check-eq (IV (IBig::+ 100 200)) (IV 300))
(check-eq (IV (IBig::- 200 50)) (IV 150))
(check-eq (IV (IBig::* 12 12)) (IV 144))
(check-eq (IV (IBig::/ 100 7)) (IV 14))
(check-eq (IV (IBig::% 100 7)) (IV 2))
(check-eq (IV (IBig::neg 42)) (IV -42))
(check-eq (IV (IBig::abs -99)) (IV 99))
(check-eq (IV (IBig::min 3 7)) (IV 3))
(check-eq (IV (IBig::max 3 7)) (IV 7))
(check-eq (B (IBig::< 3 7)) (B true))
(check-eq (B (IBig::== 5 5)) (B true))
(check-eq (IV (IBig::if true 10 20)) (IV 10))

;; Large numbers
(check-eq (IV (IBig::* 1000000000000 1000000000000)) (IV 1000000000000000000000000))

;; UBig
(check-eq (UV (UBig::+ 100 200)) (UV 300))
(check-eq (UV (UBig::- 200 50)) (UV 150))
(check-eq (UV (UBig::* 12 12)) (UV 144))
(check-eq (B (UBig::< 3 7)) (B true))

;; RBig
(check-eq (RV (RBig::+ 1/2 1/3)) (RV 5/6))
(check-eq (RV (RBig::- 1/2 1/3)) (RV 1/6))
(check-eq (RV (RBig::* 2/3 3/4)) (RV 1/2))
(check-eq (RV (RBig::/ 1/2 1/3)) (RV 3/2))
(check-eq (RV (RBig::neg 3/4)) (RV -3/4))
(check-eq (RV (RBig::abs -3/4)) (RV 3/4))
(check-eq (B (RBig::< 1/3 2/3)) (B true))
