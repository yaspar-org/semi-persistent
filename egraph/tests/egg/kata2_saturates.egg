;; EXPECT: ok
;; EVAL: both
;; Ramp-up kata 2: a rule set that reaches an operational fixpoint.

(sort N)
(function z () N)
(function s (N) N)
(function dbl (N) N)

(rewrite (dbl (z)) (z))
(rewrite (dbl (s x)) (s (s (dbl x))))

(let two (s (s z)))
(let four (s (s (s (s z)))))
(let d2 (dbl two))

(run 10)
(check (= d2 four))
(print-stats)
