;; EXPECT: sort-error
;; MESSAGE: 'x' is a filter's column; iterate the filter, or zip its columns
;; TYPES: machine
;; A comprehension iterates a sequence of children; a filter's column is one of its
;; element's values, iterated through the filter or a zip.
(sort E)
(function a () E)
(function F (E) E)
(function G (E) E)
(function N (i64) E)
(function And (E) E :assoc-comm-idem)
(rewrite (And (..gs (F x)) ..rest) (And ..{ (G e) for e in x } ..rest))
