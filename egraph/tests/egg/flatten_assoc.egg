;; EXPECT: ok
;; TYPES: machine
;; `:flatten` under `:assoc`: the view splices an opened member's children in place, so
;; Seq[a, K] with K ≡ Seq[b, c] reads [a, b, c], and Seq[K, a] reads [b, c, a]. The
;; three-child rule sees each order and no other.
(sort E)
(function a () E) (function b () E) (function c () E) (function Kc () E) (function Lc () E)
(function Seq (E) E :assoc)
(function Tri (E E E) E)
(let k (Kc))
(let l (Lc))
(let front (Seq (a) k))
(let back (Seq l (a)))
(union k (Seq (b) (c)))
(union l (Seq (b) (c)))
(rewrite (Seq x y z) (Tri x y z) :flatten)
(run 1)
(prove (= front (Tri (a) (b) (c))))
(prove (= back (Tri (b) (c) (a))))
(prove (!= front (Tri (b) (c) (a))))
(prove (!= back (Tri (a) (b) (c))))
