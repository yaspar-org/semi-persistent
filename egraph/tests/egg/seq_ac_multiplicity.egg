;; EXPECT: ok
;; TYPES: machine
;; A filter's multiplicity annotation: `(..fs:k>=2 (F x))` takes the child of
;; multiplicity 2 and leaves the child of multiplicity 1 to the rest; `(sum k)` is 2.
(sort E)
(function a () E)
(function b () E)
(function F (E) E)
(function N (i64) E)
(function Plus (E) E :assoc-comm)
(let e (Plus (F a) (F a) (F b)))
(rewrite (Plus (..fs:k>=2 (F x)) ..rest) (Plus (N (sum k)) ..rest) :when ((>= (count fs) 1)))
(run 1)
(check (= e (Plus (N 2) (F b))))
