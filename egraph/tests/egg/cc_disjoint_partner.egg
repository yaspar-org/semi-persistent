;; EXPECT: ok
;; TYPES: machine
;; A completion partner whose left-hand side is disjoint from the rule's. Partners come from
;; the use lists of the rule's children, which over-approximate the rules sharing a class:
;; a rule's left-hand side is the node's children read through the clamp (unit drop,
;; nilpotent reduction), which can remove a class the stored node still lists. Here
;; `:identity` with `:nilpotent 3` reaches such a pair; `cc_round` asserted that partners
;; overlap (`debug_assert!(!multiset_disjoint(a, m))`) and panicked in debug builds. A
;; disjoint pair has a trivially joinable critical pair, so the round now skips it (commit
;; e97b80e0). Copied from `semper-conform-cc` seed 1, case 143 (conform-cc/cc1_0143.egg) so
;; the regression does not depend on the generator's output.
(sort E)
(function C0 () E)
(function C1 () E)
(function C2 () E)
(function C3 () E)
(function C4 () E)
(function Zero () E)
(function Add (E) E :assoc-comm :identity (Zero) :nilpotent 3)
(set-option :completion eager)
(union (Add (C2) (C3)) (Add (C0) (C1) (C4)))
(union (Add (C1) (C4)) (C3))
(union (Add (C1) (C3):2) (C2))
(check-eq (C0) (C2))
(check-eq (Add (C0):2) (Add (C0) (C2)))
(check-eq (Add (C0) (C1)) (Add (C1) (C2)))
(check-eq (C3) (Add (C1) (C4)))
(check-eq (Add (C0):2) (Add (C2):2))
(check-eq (Add (C0) (C3)) (Add (C2) (C3)))
(check-eq (Add (C0) (C4)) (Add (C2) (C4)))
(check-eq (Zero) (Add (C0):3))
(check-eq (Zero) (Add (C0):2 (C2)))
(check-eq (Add (C0):2 (C1)) (Add (C0) (C1) (C2)))
(check-eq (Add (C0) (C3)) (Add (C0) (C1) (C4)))
(check-eq (Zero) (Add (C0) (C2):2))
(check-eq (Add (C0):2 (C3)) (Add (C0) (C2) (C3)))
(check-eq (Add (C0):2 (C4)) (Add (C0) (C2) (C4)))
(check-eq (Zero) (Add (C1):3))
(check-eq (Add (C0) (C1):2) (Add (C1):2 (C2)))
(check-eq (Add (C1) (C3)) (Add (C1):2 (C4)))
(check-eq (Add (C0):2 (C1)) (Add (C1) (C2):2))
(check-eq (Add (C0) (C1) (C3)) (Add (C1) (C2) (C3)))
(check-eq (Add (C0) (C3)) (Add (C1) (C2) (C4)))
(check-eq (C0) (Add (C1) (C3):2))
(check-eq (Add (C3):2) (Add (C1) (C3) (C4)))
(check-eq (Add (C3) (C4)) (Add (C1) (C4):2))
(check-eq (Zero) (Add (C2):3))
(check-eq (Add (C0):2 (C3)) (Add (C2):2 (C3)))
(check-eq (Add (C0):2 (C4)) (Add (C2):2 (C4)))
(check-eq (Add (C0) (C3):2) (Add (C2) (C3):2))
(check-eq (Add (C0) (C3) (C4)) (Add (C2) (C3) (C4)))
(check-eq (Add (C0) (C4):2) (Add (C2) (C4):2))
(check-eq (Zero) (Add (C3):3))
(check-eq (Zero) (Add (C4):3))
(check-neq (Zero) (C0))
(check-neq (Zero) (C1))
(check-neq (Zero) (C3))
(check-neq (Zero) (C4))
(check-neq (C0) (C1))
(check-neq (C0) (C3))
(check-neq (C0) (C4))
(check-neq (C1) (C3))
(check-neq (C1) (C4))
(check-neq (C3) (C4))
(check-neq (Add (C2) (C3)) (Zero))
(check-neq (Add (C2) (C3)) (C0))
(check-neq (Add (C2) (C3)) (C3))
(check-neq (Add (C2) (C3)) (C4))
(check-neq (Add (C1) (C4)) (Zero))
(check-neq (Add (C1) (C4)) (C0))
(check-neq (Add (C1) (C4)) (C1))
(check-neq (Add (C1) (C4)) (C4))
(check-neq (Add (C1) (C3):2) (Zero))
(check-neq (Add (C1) (C3):2) (C1))
(check-neq (Add (C1) (C3):2) (C3))
(check-neq (Add (C1) (C3):2) (C4))
(check-neq (C3) (Add (C0):2))
(check-neq (C4) (Add (C0) (C1)))
