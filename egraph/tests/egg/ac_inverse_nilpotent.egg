;; EXPECT: ok
;; TYPES: machine
;; CHECK_AC_BASIS: on
;; R4 (NilpotentInverseCP): under :nilpotent k the inverse of x is x^(k-1).
;; x^3 = {} and {x, Neg(x)} = {} overlap on x: Add{X, X} = Neg(X).
(sort E)
(constructor X () E)
(constructor Zero () E)
(constructor Neg (E) E)
(constructor Add (E) E :assoc :comm :nilpotent 3 :identity (Zero) :inverse Neg)
(set-option :completion eager)
(let s (Add (X) (X)))
(let t (Neg (X)))
(let u (Add (X) (X) (X)))
(check-eq u (Zero))
(check-eq s t)
