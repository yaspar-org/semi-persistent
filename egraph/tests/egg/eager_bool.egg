;; EXPECT: ok
;; TYPES: machine
;; Bool ops in ground terms
(datatype Expr (B bool))

(check-eq (B (and true false)) (B false))
(check-eq (B (or false true)) (B true))
(check-eq (B (not true)) (B false))
(check-eq (B (bool::if true true false)) (B true))
