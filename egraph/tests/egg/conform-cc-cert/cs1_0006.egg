;; EXPECT: ok
;; TYPES: machine
;; semper-conform-cc-cert seed=1 case=6 family=inv bound=3 classes=3
;; Every check-neq pair is separated by a countermodel of the declared laws and the
;; asserted equations (SemperProofs/CC/Countermodel.lean: not_E_of_separates); its
;; certificate precedes it. check-eq pairs are =_E (bounded oracle).
;; candidates: 6, certified check-neq: 6, uncertified: 0, check-eq: 16
;; MODEL Z2^1 C0=0 C1=0 C2=1
;; MODEL Z2^1 C0=1 C1=0 C2=0
(sort E)
(function C0 () E)
(function C1 () E)
(function C2 () E)
(function Zero () E)
(function Neg (E) E)
(function Add (E) E :assoc-comm :identity (Zero) :nilpotent 2 :inverse Neg)
(set-option :completion eager)
(union (Neg (Zero)) (C1))
(union (Neg (C2)) (C2))
;; CERT Z2^1 C0=1 C1=0 C2=0
(check-neq (Zero) (C0))
;; CERT Z2^1 C0=0 C1=0 C2=1
(check-neq (Zero) (C2))
;; CERT Z2^1 C0=0 C1=0 C2=1
(check-neq (Zero) (Add (C0) (C2)))
;; CERT Z2^1 C0=0 C1=0 C2=1
(check-neq (C0) (C2))
;; CERT Z2^1 C0=0 C1=0 C2=1
(check-neq (C0) (Add (C0) (C2)))
;; CERT Z2^1 C0=1 C1=0 C2=0
(check-neq (C2) (Add (C0) (C2)))
(check-eq (Zero) (C1))
(check-eq (Zero) (Add (C0):2))
(check-eq (C0) (Add (C0) (C1)))
(check-eq (Zero) (Add (C1):2))
(check-eq (C2) (Add (C1) (C2)))
(check-eq (Zero) (Add (C2):2))
(check-eq (C0) (Add (C0):3))
(check-eq (Zero) (Add (C0):2 (C1)))
(check-eq (C2) (Add (C0):2 (C2)))
(check-eq (C0) (Add (C0) (C1):2))
(check-eq (Add (C0) (C2)) (Add (C0) (C1) (C2)))
(check-eq (C0) (Add (C0) (C2):2))
(check-eq (Zero) (Add (C1):3))
(check-eq (C2) (Add (C1):2 (C2)))
(check-eq (Zero) (Add (C1) (C2):2))
(check-eq (C2) (Add (C2):3))
