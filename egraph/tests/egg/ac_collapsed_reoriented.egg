;; A collapsed node is a rule again when a merge reorients the rule that collapsed it.
;; A round collapses a node `x⁸y⁶` against the rule `x⁷y⁶ → m`, where `m` has the same
;; degree (13). After the next rebuild `x⁷y⁶` is its class's minimal monomial, so it is no
;; rule, no other rule reduces `x⁸y⁶`, and the node is an equation completion never
;; superposes. `unretire_irreducible_collapsed` reactivates it after the rebuild; without
;; it (with the absorbed-uses sweep reactivating recanonicalized nodes) the debug check
;; `check_no_irreducible_collapsed` failed on `{e0^8, e30^6}`. The check-neq pairs differ
;; in the model Z/4 with C0..C6 = 1 0 2 2 1 3 1. Expected: ok. Reduced from swgen laws
;; seed 913, case 573.
(sort E)
(function C0 () E)
(function C1 () E)
(function C2 () E)
(function C3 () E)
(function C4 () E)
(function C5 () E)
(function C6 () E)
(function Add (E) E :assoc-comm :cancellative)
(set-option :completion eager)
(union (C5) (Add (Add (C4) (C1):3 (C6):2):3 (C3)))
(union (Add (C2) (C4):4) (Add (C1):2 (C2)))
(union (C1) (Add (C0) (C1):2 (C5)))
(union (Add (C3) (C6)) (Add (C0) (C3)))
(check-eq (C6) (C0))
(check-neq (C5) (C6))
(check-neq (Add (C4):2) (C1))
