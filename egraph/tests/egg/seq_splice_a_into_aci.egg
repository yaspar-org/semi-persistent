;; EXPECT: ok
;; TYPES: machine
;; "§Edge cases 3": an A sequence spliced under an ACI operator: duplicates
;; collapse.
(sort E)
(function a () E)
(function b () E)
(function F (E) E)
(function Cat (E) E :assoc)
(function And (E) E :assoc-comm-idem)
(function Plus (E) E :assoc-comm)
(let e (Cat (F a) (F b) (F a)))
(rewrite (Cat (..fs (F x))) (And ..fs))
(run 1)
(check (= e (And (F a) (F b))))
