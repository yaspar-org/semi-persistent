;; EXPECT: ok
;; TYPES: machine
;; A binary pattern does not match a flattened fold (design 07 §7.5, "Left- and
;; right-associative operators"). Build-time flattening stores `Sub(Sub(a, b), c)` as the
;; sequence [a, b, c]. `(Sub x y)` binds one child per variable, so it matches a two-element
;; node only; neither plain matching nor a `:flatten` view regroups the run [a, b] into one
;; child. The rewrite therefore never fires on `t`, with or without `:flatten`. A pattern of
;; the stored arity, or one with a rest variable such as `(Sub ..p y)`, matches. The
;; rest-variable case runs on a second operator, `Rsub`, so that its rewrite does not put `t`
;; in the class of a `T2` term.
(sort E)
(function A () E) (function B () E) (function C () E)
(function Sub (E) E :assoc-left)
(function T2 (E E) E)
(function T3 (E E E) E)
(function Rsub (E) E :assoc-left)
(function U2 (E E) E)
(let t (Sub (Sub (A) (B)) (C)))
(rewrite (Sub x y) (T2 x y))
(rewrite (Sub x y) (T2 x y) :flatten)
(rewrite (Sub x y z) (T3 x y z))
(let u (Rsub (Rsub (A) (B)) (C)))
(rewrite (Rsub ..p y) (U2 (Rsub ..p) y))
(run 2)
(check-neq t (T2 (Sub (A) (B)) (C)))
(check-eq t (T3 (A) (B) (C)))
(check-eq u (U2 (Rsub (A) (B)) (C)))
