;; EXPECT: ok
;; TYPES: machine
;; `:flatten` under AC: an opened member's multiplicities multiply by the child's, and
;; equal classes sum. Plus{K:2, a} with K ≡ Plus{b:3} reads {b:6, a}; Plus{L:2, b} with
;; L ≡ Plus{b, c} reads {b:3, c:2}.
(sort E)
(function a () E) (function b () E) (function c () E) (function Kc () E) (function Lc () E)
(function S1 () E) (function S2 () E)
(function Plus (E) E :assoc-comm)
(function Six (E E) E) (function Th (E E) E)
(let k (Kc))
(let l (Lc))
(let one (S1))
(let two (S2))
(rewrite (S1) (Plus k k (a)))
(rewrite (S2) (Plus l l (b)))
(run 1)
(union k (Plus (b) (b) (b)))
(union l (Plus (b) (c)))
(rewrite (Plus x:6 y) (Six x y) :flatten)
(rewrite (Plus x:3 y:2) (Th x y) :flatten)
(run 1)
(check (= one (Six (b) (a))))
(check (= two (Th (b) (c))))
