;; EXPECT: ok
;; Cancelative closure without an identity (Kapur §5.2(iii)(b), `cc_round`'s `push_cancel`
;; with an empty side and no unit): `c1c2 = c1` cancels to `c2 = ∅`, and with no unit to
;; close against, the closure is `f(c2 ∪ {c}) = f({c})` for every constant `c` of Add's
;; summand pool. Two cancelative ops make the pair scan skip across ops. Each check-neq
;; is separated by the model Z (both ops addition): c1=2 c2=0 c3=1 c4=3 c5=4.
(sort E)
(function C1 () E) (function C2 () E) (function C3 () E) (function C4 () E) (function C5 () E)
(function Add (E) E :assoc-comm :cancellative)
(function Mul (E) E :assoc-comm :cancellative)
(set-option :completion eager)
(union (Add (C1) (C2)) (C1))
(union (Add (C3) (C4)) (C5))
(union (Mul (C1) (C3)) (C4))
;; Pool consequences: c2 is absorbed by every summand of the pool, and by congruence by c5.
(check-eq (Add (C2) (C3)) (C3))
(check-eq (Add (C2) (C4)) (C4))
(check-eq (Add (C2) (C2)) (C2))
(check-eq (Add (C2) (C5)) (C5))
(check-eq (Add (C2) (C3) (C4)) (C5))
;; Not entailed.
(check-neq (C3) (C4))
(check-neq (C1) (C3))
(check-neq (Add (C1) (C3)) (C4))
