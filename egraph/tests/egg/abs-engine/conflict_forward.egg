;; EXPECT: error
;; MESSAGE: abstract conflict
;; A conflict reached by propagation, not by a direct meet. x is in [0, 9], so
;; (add x 1) is in [1, 10]; seeding that class with [20, 30] empties it.
(sort Int :interp int :domains (interval))
(function add (Int Int) Int :interp +)
(function X () Int)
(let x (X))
(refine x (interval 0 9))
(let y (add x 1))
(refine y (interval 20 30))
