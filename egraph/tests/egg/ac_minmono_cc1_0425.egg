;; minimal: the program with its first failing check only
;; Registered as a regression for the completion order keys (row EG1): this
;; first failing check of the conformance case failed (check failed) before the fix,
;; with a non-minimal stored minimal monomial under --check-ac-basis; the full case is in the generator.
(sort E)
(function C0 () E)
(function C1 () E)
(function C2 () E)
(function C3 () E)
(function Zero () E)
(function Neg (E) E)
(function Add (E) E :assoc-comm :identity (Zero) :inverse Neg :cancellative)
(set-option :completion eager)
(union (Add (C1) (C2) (C3)) (C0))
(union (Add (C2) (C3)) (Add (C0) (C1)))
(union (Neg (C2)) (Zero))
(check-eq (Add (C0):3) (Add (C0) (C3):2))
