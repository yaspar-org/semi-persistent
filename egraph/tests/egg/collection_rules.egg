;; EXPECT: ok
;; TYPES: machine
;; The three collection rules and their duals: merging, factoring, narrowing.
(sort IntervalSort)
(function Interval (i64 i64) IntervalSort)
(sort MLTL)
(function Bool (bool) MLTL)
(function Var (String) MLTL)
(function Not (MLTL) MLTL)
(function And (MLTL) MLTL :assoc-comm-idem :identity (Bool true))
(function Or (MLTL) MLTL :assoc-comm-idem :identity (Bool false))
(function Global (IntervalSort MLTL) MLTL)
(function Future (IntervalSort MLTL) MLTL)

(rewrite (And (..gs (Global (Interval l u) p)) ..rest)
         (And ..{ (Global (Interval a b) q) for (q a b) in (union-by p l u) } ..rest)
  :when ((< (count (union-by p l u)) (count gs))))
(rewrite (Or (..fs (Future (Interval l u) p)) ..rest)
         (Or ..{ (Future (Interval a b) q) for (q a b) in (union-by p l u) } ..rest)
  :when ((< (count (union-by p l u)) (count fs))))

(rewrite (And (..gs (Global (Interval l u) p)) ..rest)
         (And (Global (Interval K0 K1)
                      (And ..{ (if (and (== l K0) (== u K1)) p (Global (Interval (- l K0) (- u K1)) p))
                               for (l u p) in (zip l u p) }))
              ..rest)
  :let ((K0 (min l)) (K1 (+ K0 (min (- u l)))))
  :when ((>= (count gs) 2) (> K1 0) (== (count (union-by p l u)) (count gs))))
(rewrite (Or (..fs (Future (Interval l u) p)) ..rest)
         (Or (Future (Interval K0 K1)
                     (Or ..{ (if (and (== l K0) (== u K1)) p (Future (Interval (- l K0) (- u K1)) p))
                             for (l u p) in (zip l u p) }))
             ..rest)
  :let ((K0 (min l)) (K1 (+ K0 (min (- u l)))))
  :when ((>= (count fs) 2) (> K1 0) (== (count (union-by p l u)) (count fs))))

(rewrite (And (..ns (Global (Interval a b) (Not q)))
              (..gs (Global (Interval l u) p))
              (..fs (Future (Interval c d) r)) ..rest)
         (And ..ns ..gs ..{ (Future (Interval c2 d2) r2) for (r2 c2 d2) in (narrow c d r a b q) } ..rest)
  :when ((> (count (narrowed c d r a b q)) 0)
         (== (count (union-by q a b)) (count ns))
         (== (count (union-by p l u)) (count gs))))
(let a (Var "a")) (let b (Var "b")) (let c (Var "c")) (let x (Var "x"))
(let f (And (Global (Interval 2 5) a) (Global (Interval 4 9) b) (Global (Interval 3 4) c) x))
(let m (And (Global (Interval 0 3) a) (Global (Interval 4 6) a) (Global (Interval 10 12) a) x))
(let n (And (Global (Interval 0 3) (Not a)) (Global (Interval 4 6) (Not a)) (Future (Interval 2 9) a)))
(let d (Or (Future (Interval 2 5) a) (Future (Interval 4 9) b) x))
(run 3)
(check (= f (And x (Global (Interval 2 3) (And (Global (Interval 0 2) a) (Global (Interval 2 6) b) (Global (Interval 1 1) c))))))
(check (= m (And x (Global (Interval 0 6) a) (Global (Interval 10 12) a))))
(check (= n (And (Global (Interval 0 6) (Not a)) (Future (Interval 7 9) a))))
(check (= d (Or x (Future (Interval 2 5) (Or a (Future (Interval 2 4) b))))))
