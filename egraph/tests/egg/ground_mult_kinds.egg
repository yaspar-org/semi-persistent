;; EXPECT: ok
;; TYPES: machine
;; WARNING: none
;; `x:k` in a ground term: one counted child under AC, and k positions under an
;; associative sequence. Each spelling is the same node as the one written out. An ACI
;; operator stores a set, which has no counts (ground_mult_aci_refused.egg).
(sort E)
(function a () E) (function b () E)
(function Plus (E) E :assoc-comm)
(function Cat (E) E :assoc)
(check-eq (Plus (a):3 (b)) (Plus (a) (a) (a) (b)))
(check-eq (Plus (a):2 (a) (b)) (Plus (a):3 (b)))
(check-neq (Plus (a):2 (b)) (Plus (a):3 (b)))
(check-eq (Cat (a):3 (b)) (Cat (a) (a) (a) (b)))
