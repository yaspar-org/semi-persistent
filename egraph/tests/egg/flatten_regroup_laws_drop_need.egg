;; EXPECT: ok
;; TYPES: machine
;; Regrouped views under laws (design 07 §7.5, "Regrouped views", "Laws"; Lean
;; `regroup_drop_need_*`, `RegroupLaws.lean`). The normalization of a regrouped view may drop
;; the group's class: it is the unit, its count clamps to zero, or it cancels against its
;; inverse. A regrouped record needs only the classes its view holds, and a leaf that gains a
;; dropped class is satisfied without it, so each match below is found without completion:
;; - identity: zero ∋ add{A, B}; {A, B, C, D} regroups to {zero, C, D}, normalized {C, D};
;; - nilpotent 2: G ∋ xor{A, B}; {A, B, C, D, G} regroups to {G:2, C, D}, clamped {C, D};
;; - inverse: G ∋ grp{A, B}; {A, B, C, D, neg G} regroups to {G, neg G, C, D}, cancelled {C, D};
;; - a leaf: X ∋ mul{A, B}, one ∋ mul{A, B, C}; the walk opens X in mul{X, C, D, F}, the view
;;   {A, B, C, D, F} regroups to {one, D, F}, normalized {D, F}, and the leaf (X, [A, B]) gains
;;   one, which the view does not hold.
;; Before the fix the record needed the dropped class, or kept a leaf only that class
;; satisfied, and the four matches were lost.
(sort E)
(function zero () E) (function one () E)
(function A () E) (function B () E) (function C () E) (function D () E) (function F () E)
(function G () E) (function X () E)
(function neg (E) E)
(function add (E) E :assoc :comm :identity (zero))
(function xor (E) E :assoc :comm :identity (zero) :nilpotent 2)
(function grp (E) E :assoc :comm :identity (zero) :inverse neg)
(function mul (E) E :assoc :comm :identity (one))
(function T2 (E E) E)
(function X2 (E E) E)
(function N2 (E E) E)
(function M2 (E E) E)
(union (add (A) (B)) (zero))
(let t (add (A) (B) (C) (D)))
(union (xor (A) (B)) (G))
(let u (xor (A) (B) (G) (C) (D)))
(union (grp (A) (B)) (G))
(let v (grp (A) (B) (neg (G)) (C) (D)))
(union (X) (mul (A) (B)))
(union (mul (A) (B) (C)) (one))
(let w (mul (X) (C) (D) (F)))
(rewrite (add x y) (T2 x y) :flatten)
(rewrite (xor x y) (X2 x y) :flatten)
(rewrite (grp x y) (N2 x y) :flatten)
(rewrite (mul x y) (M2 x y) :flatten)
(run 2)
(check-eq t (T2 (C) (D)))
(check-eq u (X2 (C) (D)))
(check-eq v (N2 (C) (D)))
(check-eq w (M2 (D) (F)))
