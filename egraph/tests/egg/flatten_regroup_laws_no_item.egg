;; EXPECT: ok
;; A pattern with no item matches a regrouped view (design 07 §7.5, "Regrouped views"; Lean
;; `enumerateRDBounded_ge`, `exNoItem` in `RegroupCheck.lean`). A regrouped record keeps
;; only the needed classes its normalized view holds (`flatten_regroup_laws_drop_need.egg`),
;; so a regrouping whose class the laws drop needs no class, and a pattern with no item may
;; match its view. `enumerate` therefore regroups when the decomposition has items or the
;; laws can drop a class (`laws_drop`). Here zero ∋ add{A, B}, so {A, B, C, D} regroups to
;; {zero, C, D}, normalized {C, D}: `(add x ..r)` finds x = C, r = {D}, and `(add ..r)`
;; finds both r = {A, B, C, D} and r = {C, D}. Before the gate counted the laws, the last
;; check failed.
(sort E)
(function zero () E)
(function A () E) (function B () E) (function C () E) (function D () E)
(function add (E) E :assoc :comm :identity (zero))
(function R (E) E :assoc :comm)
(function End () E)
(function T1 (E) E)
(function T2 (E E) E)
(union (add (A) (B)) (zero))
(let t (add (A) (B) (C) (D)))
(rewrite (add x ..r) (T2 x (R (End) ..r)) :flatten)
(rewrite (add ..r) (T1 (R (End) ..r)) :flatten)
(run 2)
(check-eq t (T2 (C) (R (End) (D))))
(check-eq t (T1 (R (End) (A) (B) (C) (D))))
(check-eq t (T1 (R (End) (C) (D))))
