;; EXPECT: ok
;; TYPES: machine
;; The filter is annotated `:k` so that it takes the child of multiplicity 2: an
;; unannotated AC filter takes multiplicity 1 only (decided 2026-09-30).
;; "§Edge cases 3": an AC sequence spliced under an ACI operator gives one copy of
;; each child (idempotence).
(sort E)
(function a () E)
(function b () E)
(function F (E) E)
(function Cat (E) E :assoc)
(function And (E) E :assoc-comm-idem)
(function Plus (E) E :assoc-comm)
(let e (Plus (F a) (F a) (F b)))
(rewrite (Plus (..fs:k (F x)) ..rest) (And ..fs))
(run 1)
(check (= e (And (F a) (F b))))
