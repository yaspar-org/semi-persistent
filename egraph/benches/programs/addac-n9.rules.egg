;; TYPES: machine
;; add-ac width-scaling sweep, n = 9.  Generated by gen-addac-sweep.py.
;; Config: A/C modelled as explicit rewrite rules, egglog's own encoding.
;; Same datatype, same two rules, same budget and same goal as addac-n9.egglog.egg.
;; See addac-sweep.md.

(datatype Math
    (Add Math Math)
    (Const f64))

(ruleset add_ac)
(rewrite (Add a b) (Add b a) :ruleset add_ac)
(rewrite (Add a (Add b c)) (Add (Add a b) c) :ruleset add_ac)
;; Add one through 9, right-nested
(let res
  (Add (Const 1.0)
     (Add (Const 2.0)
          (Add (Const 3.0)
               (Add (Const 4.0)
                    (Add (Const 5.0)
                         (Add (Const 6.0)
                              (Add (Const 7.0)
                                   (Add (Const 8.0)
                                        (Const 9.0))))))))))
;; The goal term, 9 down to one.
(let goal
  (Add (Const 9.0)
     (Add (Const 8.0)
          (Add (Const 7.0)
               (Add (Const 6.0)
                    (Add (Const 5.0)
                         (Add (Const 4.0)
                              (Add (Const 3.0)
                                   (Add (Const 2.0)
                                        (Const 1.0))))))))))
(run add_ac 50 :until (= res goal))
(check (= res goal))
(print-size)
(print-stats :file "addac-n9.rules.stats.json")
