import Conform.Rounds.Oracle

/-!
# `semper-conform-rounds`: multi-round conformance programs

    lake exe semper-conform-rounds <seed> <count> <outdir> --engine <semi-persistent> [--only <idx>]

writes `<outdir>/r<seed>_<idx>.egg` for `idx` in `[0, count)`. Each program
builds a small e-graph, declares two to four rules whose heads build terms,
runs `(run k)` with `k ∈ [2, 5]`, and checks the final state.

The generator runs the program twice on the engine, naive, with a dump
(`(run k-1)` and `(run k)`), reads both dumps back (`Dump.lean`), and
writes two kinds of checks (`Oracle.lean`):

* fired checks: every match of every rule on the snapshot of round `k`
  (the `(run k-1)` dump), computed by the reference interpreter, has its
  consequence in the final state (`Saturate.InvLag`; `Saturate.Inv` when
  the run saturated): one `check-eq` per consequence, up to 30 per rule;
* state checks: the classes of the final state (a member per class equal to
  the class's term, distinct classes not equal).

The fixtures carry `;; EVAL: both`: the test runner runs them naive and
semi-naive, and the validation runs them under the four combinations of
`--use-semi-naive` and `--runtime-scheduling`, whose final states must
agree with the naive one the checks describe.

A consequence the model's `Fired` does not find in the naive final state is
written as a comment `;; UNFIRED` (a divergence between the model and the
engine's naive run) and counted on stdout. The same seed and engine give
byte-identical files.
-/

open Conform.Rounds

structure Summary where
  files : Nat := 0
  saturated : Nat := 0
  nMatch : Nat := 0
  fired : Nat := 0
  triv : Nat := 0
  sens : Nat := 0
  unfired : Nat := 0
  noTerm : Nat := 0
  state : Nat := 0
  engineErr : Nat := 0
  tooLarge : Nat := 0

def runEngine (engine path : String) : IO (Bool × String) := do
  let out ← IO.Process.output { cmd := "timeout", args := #["60", engine, "--types", "machine", path] }
  return (out.exitCode = 0, (out.stdout ++ out.stderr).trimAscii.toString)

def header (cs : RCase) (sat : Bool) (rp : Report) (nState : Nat) : List String :=
  [";; Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.",
   ";; SPDX-License-Identifier: Apache-2.0",
   ";; EXPECT: ok",
   ";; TYPES: machine",
   ";; EVAL: both",
   s!";; semper-conform-rounds seed={cs.seed} case={cs.idx} k={cs.k} saturated={sat} rules={cs.rules.length} tags={",".intercalate cs.tags}",
   ";; Generated by the multi-round conformance generator (proofs/lean/Conform/Rounds). The fired checks",
   ";; are the model's `InvLag` (Saturate/Invariant.lean): every match of every rule on the snapshot of",
   ";; round k, computed by the reference interpreter on the engine's naive dump after (run k-1), has its",
   ";; consequence in the final state; the state checks describe the final state of the naive run.",
   s!";; Regenerate: lake exe semper-conform-rounds {cs.seed} <count> <dir> --engine <semi-persistent>   (file {fileName cs.seed cs.idx})",
   s!";; matches: {rp.nMatch}, fired checks: {rp.fired.length}, trivial: {rp.trivial}, splice-flagged: {rp.sens}, unfired: {rp.unfired.length}, state checks: {nState}"]

/-- Nodes in the final dump beyond which `k` is lowered (a rule pair that
grows the graph geometrically): the reference interpreter enumerates AC
sub-multisets on every node. -/
def maxNodes : Nat := 600

/-- A constant of the first initial command (every initial command names one). -/
def dumpRoot (cs : RCase) : String :=
  let l := (cs.init.headD "(C0)").toList
  let rec go : List Char → Option String
    | '(' :: 'C' :: rest =>
        let ds := rest.takeWhile Char.isDigit
        if ds.isEmpty then go rest else some ("(C" ++ String.ofList ds ++ ")")
    | _ :: rest => go rest
    | [] => none
  (go l).getD "(C0)"

partial def doCase (engine outdir work : String) (seed idx : Nat) (sm : Summary) (k? : Option Nat := none) :
    IO Summary := do
  let cs0 := caseOf seed idx
  let cs := match k? with | some k => { cs0 with k := k, tags := cs0.tags ++ [s!"k-lowered-from-{cs0.k}"] } | none => cs0
  let pre := cs.prefix
  -- the dump's root term is built by `dump-egraph`: it must already be in the
  -- graph, or the snapshot holds a node the run never had (a constant that a
  -- `(rewrite (Ci) ...)` then matches)
  let root := dumpRoot cs
  let dumpA := s!"{work}/a_{idx}.json"
  let dumpB := s!"{work}/b_{idx}.json"
  let pa := s!"{work}/a_{idx}.egg"
  let pb := s!"{work}/b_{idx}.egg"
  IO.FS.writeFile pa ("\n".intercalate (pre ++ [s!"(run {cs.k - 1})", s!"(dump-egraph {root} :file \"{dumpA}\")"]) ++ "\n")
  IO.FS.writeFile pb ("\n".intercalate (pre ++ [s!"(run {cs.k})", s!"(dump-egraph {root} :file \"{dumpB}\")"]) ++ "\n")
  let (okA, outA) ← runEngine engine pa
  let (okB, outB) ← runEngine engine pb
  if !okA ∨ !okB then
    IO.eprintln s!"{fileName seed idx}: engine error: {if okA then outB else outA}"
    IO.FS.writeFile s!"{outdir}/{fileName seed idx}.engine-error"
      ("\n".intercalate (pre ++ [s!"(run {cs.k})"]) ++ s!"\n;; {if okA then outB else outA}\n")
    return { sm with engineErr := sm.engineErr + 1 }
  -- a cheap size test before parsing: one `"op"` per node
  let jb ← IO.FS.readFile dumpB
  let big := jb.length > 200 * maxNodes ∨ (jb.splitOn "\"op\"").length > maxNodes + 1
  if big then
    for f in [pa, pb, dumpA, dumpB] do IO.FS.removeFile f
    if cs.k > 2 then return ← doCase engine outdir work seed idx sm (some (cs.k - 1))
    IO.eprintln s!"{fileName seed idx}: final graph above {maxNodes} nodes at k = 2, dropped"
    return { sm with tooLarge := sm.tooLarge + 1 }
  let ja ← IO.FS.readFile dumpA
  let (some d₁, some d₂) := (Except.toOption (parseDump ja), Except.toOption (parseDump jb))
    | IO.eprintln s!"{fileName seed idx}: unreadable dump"; return { sm with engineErr := sm.engineErr + 1 }
  let sat := ja == jb
  let rp := firedReport d₁ d₂ cs 30
  let st := stateChecks d₂ 30
  let body := pre ++ [s!"(run {cs.k})"] ++ rp.fired ++ st ++
    rp.unfired.map (fun l => s!";; UNFIRED {l}")
  IO.FS.writeFile s!"{outdir}/{fileName seed idx}" ("\n".intercalate (header cs sat rp st.length ++ body) ++ "\n")
  for f in [pa, pb, dumpA, dumpB] do IO.FS.removeFile f
  IO.println s!"{fileName seed idx}\tk={cs.k}\tsat={sat}\tmatches={rp.nMatch}\tfired={rp.fired.length}\ttrivial={rp.trivial}\tsens={rp.sens}\tunfired={rp.unfired.length}\tnoterm={rp.noTerm}\tstate={st.length}\ttags={",".intercalate cs.tags}"
  let satN : Nat := if sat then 1 else 0
  return { sm with
    files := sm.files + 1
    saturated := sm.saturated + satN
    nMatch := sm.nMatch + rp.nMatch
    fired := sm.fired + rp.fired.length
    triv := sm.triv + rp.trivial
    sens := sm.sens + rp.sens
    unfired := sm.unfired + rp.unfired.length
    noTerm := sm.noTerm + rp.noTerm
    state := sm.state + st.length }

def usage : String :=
  "usage: semper-conform-rounds <seed> <count> <outdir> --engine <semi-persistent> [--only <idx>] [--dump <idx>]"

def main (args : List String) : IO UInt32 := do
  match args with
  | seed :: count :: outdir :: rest =>
      let some seed := seed.toNat? | do IO.eprintln usage; return 1
      let some count := count.toNat? | do IO.eprintln usage; return 1
      match rest with
      | ["--dump", i] =>
          let some i := i.toNat? | do IO.eprintln usage; return 1
          let cs := caseOf seed i
          IO.println ("\n".intercalate (cs.prefix ++ [s!"(run {cs.k})"]))
          return 0
      | "--engine" :: engine :: opt =>
          IO.FS.createDirAll outdir
          let outdir := (← IO.FS.realPath outdir).toString
          let work := s!"{outdir}/.work"
          IO.FS.createDirAll work
          let idxs ← match opt with
            | ["--only", i] => match i.toNat? with
                | some i => pure [i]
                | none => do IO.eprintln usage; return 1
            | [] => pure (List.range count)
            | _ => do IO.eprintln usage; return 1
          let mut sm : Summary := {}
          for i in idxs do
            sm ← doCase engine outdir work seed i sm
          IO.FS.removeDirAll work
          IO.println s!"TOTAL files={sm.files} saturated={sm.saturated} matches={sm.nMatch} fired={sm.fired} trivial={sm.triv} splice-flagged={sm.sens} unfired={sm.unfired} noterm={sm.noTerm} state={sm.state} engine-errors={sm.engineErr} too-large={sm.tooLarge}"
          return 0
      | _ => IO.eprintln usage; return 1
  | _ => IO.eprintln usage; return 1
