import SemperProofs.CC.Main
import SemperProofs.CC.Laws.Combined

/-!
# The lattice step of a cancellative operator

`lattice_round` (`egraph.rs`) runs at the completion fixpoint for every
cancellative operator and every operator with `:identity` and
`:nilpotent k` (a group of exponent `k`). It reads each node as an integer
row, adds rows for the law generators, brings the rows to echelon form over
`ℤ`, and merges two classes whose unit vectors lie in one coset of the
lattice the rows span. This file proves the algebra behind that step and
connects it to the completeness theorem.

* `vec M : Fin n → ℤ` is the count vector of a monomial; `latticeOf P` is
  the subgroup of `Fin n → ℤ` generated by `vec u - vec v` for `(u, v) ∈ P`.
* `CancelClosed L S`: `=_E` cancels a common summand. It holds when the
  operator is cancellative (`cancelClosed_of_cancellative`) and when some
  `k ≥ 1` has `aᵏ =_E ∅` for every class (`cancelClosed_of_nil`).
* `E_mem_lattice`: `x =_E y` implies `vec x - vec y` lies in the lattice
  of the asserted pairs and the law instances, for every law set.
* `E_of_mem_lattice`: the converse under `CancelClosed`, so
  `E_iff_mem_lattice` characterizes `=_E` by lattice membership. No side
  condition on emptiness is needed, because `E` relates multisets and the
  empty multiset is one of them; over a semigroup without identity the
  same argument applies to nonempty monomials.
* `combined_E_iff`: for the engine's combined law set (`:identity u`,
  `:nilpotent k`, `:inverse`), `=_E` is membership in the lattice spanned
  by the asserted pairs, `e_u`, `k • e_a` for every class `a`, and
  `e_x + e_y` for every inverse pair: the rows of `lattice_round`.
* `LatticeClosed L st`: two active nodes whose vectors are congruent modulo
  the lattice of the state's class pairs and the law instances are in one
  class. `latticeClosed_of_engineFixed` derives it from the fixpoint
  condition of `lattice_round` (`EngineFixed`), stated on the engine's rows
  `e_c - vec M`.
* `lattice_merge_sound`: a lattice merge preserves I2 under
  `CancelClosed`.
* `complete_of_latticeClosed`: at a lattice-closed state in which every
  asserted pair is a pair of classmates, `=_E`-equal active nodes are in
  one class. `completion_complete_cancellative_engine` is the completeness
  theorem of `Main.lean` with `hcancel` replaced by
  `L.cancellative → LatticeClosed L st`.
* `hcancel_not_derivable`: a converged, lattice-closed state of a
  cancellative operator at which the conclusion of `hcancel` fails. The
  hypothesis quantifies over every monomial, and lattice closure constrains
  only the classes present, so the completeness theorem for cancellative
  operators goes through lattice closure, not through `hcancel`.
-/

namespace SemperProofs.CC.Lattice

open SemperProofs.CC Relation

variable {n : ℕ}

/-! ## Count vectors and lattices -/

/-- The count vector of a monomial over `ℤ`. -/
def vec (M : Monomial n) : Fin n → ℤ := fun a => (M.count a : ℤ)

@[simp] theorem vec_add (M N : Monomial n) : vec (M + N) = vec M + vec N := by
  funext a; simp [vec, Multiset.count_add]

@[simp] theorem vec_zero : vec (0 : Monomial n) = 0 := by
  funext a; simp [vec]

theorem vec_single (a : Fin n) : vec ({a} : Monomial n) = Pi.single a 1 := by
  funext b
  by_cases h : b = a
  · subst h; simp [vec]
  · simp [vec, h]

theorem vec_replicate (k : ℕ) (a : Fin n) :
    vec (Multiset.replicate k a) = (k : ℤ) • Pi.single a 1 := by
  funext b
  by_cases h : b = a
  · subst h; simp [vec]
  · simp [vec, Multiset.count_replicate, Ne.symm h, h]

theorem vec_pair (x y : Fin n) :
    vec ({x, y} : Monomial n) = Pi.single x 1 + Pi.single y 1 := by
  rw [Multiset.insert_eq_cons, ← Multiset.singleton_add, vec_add, vec_single, vec_single]

theorem vec_injective {M N : Monomial n} (h : vec M = vec N) : M = N := by
  ext a
  have := congrFun h a
  simp only [vec, Nat.cast_inj] at this
  exact this

/-- The difference vectors of a set of pairs. -/
def pairVecs (P : Set (Monomial n × Monomial n)) : Set (Fin n → ℤ) :=
  {w | ∃ p ∈ P, w = vec p.1 - vec p.2}

/-- The lattice spanned by the difference vectors of `P`. -/
def latticeOf (P : Set (Monomial n × Monomial n)) : AddSubgroup (Fin n → ℤ) :=
  AddSubgroup.closure (pairVecs P)

theorem latticeOf_mono {P Q : Set (Monomial n × Monomial n)} (h : P ⊆ Q) :
    latticeOf P ≤ latticeOf Q :=
  AddSubgroup.closure_mono (fun _ ⟨p, hp, e⟩ => ⟨p, h hp, e⟩)

theorem pair_mem_latticeOf {P : Set (Monomial n × Monomial n)} {u v : Monomial n}
    (h : (u, v) ∈ P) : vec u - vec v ∈ latticeOf P :=
  AddSubgroup.subset_closure ⟨(u, v), h, rfl⟩

/-- The law instances of `L` as pairs. -/
def lawPairs (L : Laws n) : Set (Monomial n × Monomial n) := {p | L.lawRel p.1 p.2}

/-! ## `=_E` implies lattice membership -/

/-- **Completeness of lattice membership.** Equal monomials of the theory
differ by a member of the lattice of the asserted pairs and the law
instances. No cancellativity is needed: the lattice is a subgroup, so the
relation it induces cancels. -/
theorem E_mem_lattice {L : Laws n} {S : Set (Monomial n × Monomial n)} {x y : Monomial n}
    (h : E L S x y) : vec x - vec y ∈ latticeOf (S ∪ lawPairs L) := by
  induction h with
  | ax h => exact pair_mem_latticeOf (Or.inl h)
  | refl M => rw [sub_self]; exact zero_mem _
  | symm _ ih => rw [← neg_sub]; exact neg_mem ih
  | trans _ _ ih₁ ih₂ => rw [← sub_add_sub_cancel]; exact add_mem ih₁ ih₂
  | congr X _ ih => rwa [vec_add, vec_add, add_sub_add_right_eq_sub]
  | law h => exact pair_mem_latticeOf (Or.inr h)
  | cancel _ _ ih => rwa [vec_add, vec_add, add_sub_add_right_eq_sub] at ih

/-! ## Lattice membership implies `=_E` -/

/-- `=_E` cancels a common summand. -/
def CancelClosed (L : Laws n) (S : Set (Monomial n × Monomial n)) : Prop :=
  ∀ M N X, E L S (M + X) (N + X) → E L S M N

theorem cancelClosed_of_cancellative {L : Laws n} {S : Set (Monomial n × Monomial n)}
    (h : L.cancellative) : CancelClosed L S :=
  fun _ _ _ => E.cancel h

/-- `k • X =_E ∅` when every `aᵏ =_E ∅`. -/
theorem E_nsmul_zero {L : Laws n} {S : Set (Monomial n × Monomial n)} {k : ℕ}
    (hnil : ∀ a, E L S (Multiset.replicate k a) 0) (X : Monomial n) : E L S (k • X) 0 := by
  induction X using Multiset.induction with
  | empty => rw [nsmul_zero]; exact E.refl _
  | cons a X ih =>
    rw [← Multiset.singleton_add, nsmul_add, Multiset.nsmul_singleton]
    have h₁ := E.congr (k • X) (hnil a)
    rw [zero_add] at h₁
    exact h₁.trans ih

/-- A group of exponent `k` cancels: add `(k - 1) • X` and drop `k • X`. -/
theorem cancelClosed_of_nil {L : Laws n} {S : Set (Monomial n × Monomial n)} {k : ℕ}
    (hk : 1 ≤ k) (hnil : ∀ a, E L S (Multiset.replicate k a) 0) : CancelClosed L S := by
  intro M N X h
  have hX : X + (k - 1) • X = k • X := by
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    rw [Nat.add_sub_cancel, succ_nsmul']
  have h₁ := E.congr ((k - 1) • X) h
  rw [add_assoc, add_assoc, hX] at h₁
  have hM := E.congr M (E_nsmul_zero hnil X)
  have hN := E.congr N (E_nsmul_zero hnil X)
  rw [zero_add, add_comm] at hM hN
  exact hM.symm.trans (h₁.trans hN)

/-- Every member of the lattice of `P` is `vec A - vec B` for a pair
`A =_E B`, when every pair of `P` is `=_E`-equal. -/
theorem exists_E_of_mem {L : Laws n} {S : Set (Monomial n × Monomial n)}
    {P : Set (Monomial n × Monomial n)} (hP : ∀ p ∈ P, E L S p.1 p.2)
    {w : Fin n → ℤ} (hw : w ∈ latticeOf P) :
    ∃ A B, E L S A B ∧ w = vec A - vec B := by
  induction hw using AddSubgroup.closure_induction with
  | mem w hw =>
    obtain ⟨p, hp, rfl⟩ := hw
    exact ⟨p.1, p.2, hP p hp, rfl⟩
  | zero => exact ⟨0, 0, E.refl _, by simp⟩
  | add w w' _ _ ih ih' =>
    obtain ⟨A, B, hAB, rfl⟩ := ih
    obtain ⟨A', B', hAB', rfl⟩ := ih'
    refine ⟨A + A', B + B', ?_, by simp only [vec_add]; abel⟩
    have h₁ := E.congr A' hAB
    have h₂ := E.congr B hAB'
    rw [add_comm A' B, add_comm B' B] at h₂
    exact h₁.trans h₂
  | neg w _ ih =>
    obtain ⟨A, B, hAB, rfl⟩ := ih
    exact ⟨B, A, hAB.symm, by rw [neg_sub]⟩

/-- **Soundness of the lattice merge**, for any generating pairs that are
equations of the theory: if `vec x - vec y` lies in their lattice and `=_E`
cancels, then `x =_E y`. Write the member as `vec A - vec B` with
`A =_E B`; then `x + B = y + A`, so `x + A =_E x + B = y + A`, and
cancelling `A` gives `x =_E y`. -/
theorem E_of_mem_latticeOf {L : Laws n} {S : Set (Monomial n × Monomial n)}
    {P : Set (Monomial n × Monomial n)} (hc : CancelClosed L S)
    (hP : ∀ p ∈ P, E L S p.1 p.2) {x y : Monomial n}
    (h : vec x - vec y ∈ latticeOf P) : E L S x y := by
  obtain ⟨A, B, hAB, he⟩ := exists_E_of_mem hP h
  have hxy : x + B = y + A := vec_injective (by
    rw [vec_add, vec_add]
    have : vec x = vec y + (vec A - vec B) := by rw [← he]; abel
    rw [this]; abel)
  have h₁ := E.congr x hAB.symm
  rw [add_comm B x, hxy, add_comm A x] at h₁
  exact hc x y A h₁.symm

/-- Soundness for the lattice of the asserted pairs and the law instances. -/
theorem E_of_mem_lattice {L : Laws n} {S : Set (Monomial n × Monomial n)} (hc : CancelClosed L S)
    {x y : Monomial n} (h : vec x - vec y ∈ latticeOf (S ∪ lawPairs L)) : E L S x y :=
  E_of_mem_latticeOf hc (fun _ hp => hp.elim E.ax E.law) h

/-- **`=_E` is lattice membership** when `=_E` cancels. -/
theorem E_iff_mem_lattice {L : Laws n} {S : Set (Monomial n × Monomial n)} (hc : CancelClosed L S)
    (x y : Monomial n) : E L S x y ↔ vec x - vec y ∈ latticeOf (S ∪ lawPairs L) :=
  ⟨E_mem_lattice, E_of_mem_lattice hc⟩

/-- The cancellative case. -/
theorem E_iff_mem_lattice_of_cancellative {L : Laws n} {S : Set (Monomial n × Monomial n)}
    (hc : L.cancellative) (x y : Monomial n) :
    E L S x y ↔ vec x - vec y ∈ latticeOf (S ∪ lawPairs L) :=
  E_iff_mem_lattice (cancelClosed_of_cancellative hc) x y

/-! ## The engine's rows for the combined law set -/

/-- The law rows of `lattice_round`: `e_u` for the unit, `k • e_a` for
every class under `:nilpotent k`, `e_x + e_y` for every inverse pair. -/
def groupRows (u : Fin n) (k : ℕ) (inv : Fin n → Option (Fin n)) : Set (Fin n → ℤ) :=
  {w | w = Pi.single u 1 ∨ (∃ a, w = (k : ℤ) • Pi.single a 1) ∨
    ∃ x y, inv x = some y ∧ w = Pi.single x 1 + Pi.single y 1}

theorem pairVecs_union (P Q : Set (Monomial n × Monomial n)) :
    pairVecs (P ∪ Q) = pairVecs P ∪ pairVecs Q := by
  ext w
  constructor
  · rintro ⟨p, hp | hp, rfl⟩
    · exact Or.inl ⟨p, hp, rfl⟩
    · exact Or.inr ⟨p, hp, rfl⟩
  · rintro (⟨p, hp, rfl⟩ | ⟨p, hp, rfl⟩)
    · exact ⟨p, Or.inl hp, rfl⟩
    · exact ⟨p, Or.inr hp, rfl⟩

theorem pairVecs_combined_gen (u : Fin n) (k : ℕ) (hk : 2 ≤ k) (inv : Fin n → Option (Fin n))
    (cancel : Prop) (hu : InvUnitFree inv u) :
    pairVecs (combinedNF u k hk inv cancel hu).gen = groupRows u k inv := by
  rw [combinedNF_gen]
  ext w
  constructor
  · rintro ⟨p, (hp | hp) | ⟨x, y, hxy, rfl⟩, rfl⟩
    · simp only [unitGen, Set.mem_singleton_iff] at hp
      subst hp
      exact Or.inl (by rw [vec_single, vec_zero, sub_zero])
    · obtain ⟨a, rfl⟩ := (nilpotentNF_gen_iff p).mp hp
      exact Or.inr (Or.inl ⟨a, by rw [vec_replicate, vec_zero, sub_zero]⟩)
    · exact Or.inr (Or.inr ⟨x, y, hxy, by rw [vec_pair, vec_zero, sub_zero]⟩)
  · rintro (rfl | ⟨a, rfl⟩ | ⟨x, y, hxy, rfl⟩)
    · exact ⟨(({u} : Monomial n), 0), Or.inl (Or.inl rfl), by rw [vec_single, vec_zero, sub_zero]⟩
    · exact ⟨(Multiset.replicate k a, 0), Or.inl (Or.inr ((nilpotentNF_gen_iff _).mpr ⟨a, rfl⟩)),
        by rw [vec_replicate, vec_zero, sub_zero]⟩
    · exact ⟨(({x, y} : Monomial n), 0), Or.inr ⟨x, y, hxy, rfl⟩,
        by rw [vec_pair, vec_zero, sub_zero]⟩

/-- **The engine's law set.** For `:identity u`, `:nilpotent k` and
`:inverse` (under `InvUnitFree`), `=_E` is membership of `vec x - vec y`
in the lattice spanned by the asserted pairs and the rows of
`lattice_round`. The structure is a group of exponent `k`, so this holds
whether or not `:cancellative` is declared. -/
theorem combined_E_iff (u : Fin n) (k : ℕ) (hk : 2 ≤ k) (inv : Fin n → Option (Fin n))
    (cancel : Prop) (hu : InvUnitFree inv u) (S : Set (Monomial n × Monomial n))
    (x y : Monomial n) :
    E (combinedNF u k hk inv cancel hu).toLaws S x y ↔
      vec x - vec y ∈ AddSubgroup.closure (pairVecs S ∪ groupRows u k inv) := by
  set N := combinedNF u k hk inv cancel hu
  have hnil : ∀ a, E N.genLaws S (Multiset.replicate k a) 0 := fun a =>
    E.law (show (Multiset.replicate k a, (0 : Monomial n)) ∈ N.gen by
      rw [combinedNF_gen]; exact Or.inl (Or.inr ((nilpotentNF_gen_iff _).mpr ⟨a, rfl⟩)))
  rw [NFLaw.E_iff, E_iff_mem_lattice (cancelClosed_of_nil (by omega) hnil), latticeOf,
    pairVecs_union, ← pairVecs_combined_gen u k hk inv cancel hu]
  rfl

/-! ## Lattice closure of a state -/

/-- Pairs of nodes in one class (retired nodes included: their equations
still hold, and `lattice_round` reads them). -/
def classPairs (st : State n) : Set (Monomial n × Monomial n) :=
  {p | ∃ c d, (p.1, c) ∈ st.nodes ∧ (p.2, d) ∈ st.nodes ∧ st.find c = st.find d}

/-- The lattice of a state: class pairs and law instances. -/
def stateLattice (L : Laws n) (st : State n) : AddSubgroup (Fin n → ℤ) :=
  latticeOf (classPairs st ∪ lawPairs L)

/-- Lattice closure: active nodes whose vectors are congruent modulo the
state's lattice are in one class. -/
def LatticeClosed (L : Laws n) (st : State n) : Prop :=
  ∀ M c N d, (M, c) ∈ st.active → (N, d) ∈ st.active →
    vec M - vec N ∈ stateLattice L st → st.find c = st.find d

/-- The rows `lattice_round` builds: `e_c - vec M` for every node `(M, c)`,
the law rows, and `e_c - e_d` for classmates (the engine indexes columns by
representative, which identifies the columns of one class). -/
def engineRows (L : Laws n) (st : State n) : Set (Fin n → ℤ) :=
  {w | ∃ M c, (M, c) ∈ st.nodes ∧ w = Pi.single c 1 - vec M} ∪
    {w | ∃ c d, st.find c = st.find d ∧ w = Pi.single c 1 - Pi.single d 1} ∪
    pairVecs (lawPairs L)

/-- The fixpoint condition of `lattice_round`: two node classes whose unit
vectors are congruent modulo the row lattice are already one class (the
step finds no merge). -/
def EngineFixed (L : Laws n) (st : State n) : Prop :=
  ∀ M c N d, (M, c) ∈ st.nodes → (N, d) ∈ st.nodes →
    Pi.single c 1 - Pi.single d 1 ∈ AddSubgroup.closure (engineRows L st) →
    st.find c = st.find d

theorem stateLattice_le_engine (L : Laws n) (st : State n) :
    stateLattice L st ≤ AddSubgroup.closure (engineRows L st) := by
  rw [stateLattice, latticeOf, AddSubgroup.closure_le]
  rintro w ⟨⟨M, N⟩, ⟨c, d, hM, hN, hcd⟩ | hl, rfl⟩
  · have r₁ : Pi.single c 1 - vec M ∈ AddSubgroup.closure (engineRows L st) :=
      AddSubgroup.subset_closure (Or.inl (Or.inl ⟨M, c, hM, rfl⟩))
    have r₂ : Pi.single d 1 - vec N ∈ AddSubgroup.closure (engineRows L st) :=
      AddSubgroup.subset_closure (Or.inl (Or.inl ⟨N, d, hN, rfl⟩))
    have r₃ : Pi.single c 1 - Pi.single d 1 ∈ AddSubgroup.closure (engineRows L st) :=
      AddSubgroup.subset_closure (Or.inl (Or.inr ⟨c, d, hcd, rfl⟩))
    have e : vec M - vec N = Pi.single d 1 - vec N - (Pi.single c 1 - vec M) +
        (Pi.single c 1 - Pi.single d 1) := by abel
    exact e ▸ add_mem (sub_mem r₂ r₁) r₃
  · exact AddSubgroup.subset_closure (Or.inr ⟨_, hl, rfl⟩)

/-- **The engine's fixpoint is lattice-closed.** If `vec M - vec N` lies in
the state's lattice, then `e_c - e_d = (e_c - vec M) - (e_d - vec N) +
(vec M - vec N)` lies in the row lattice, and `EngineFixed` puts `c`, `d`
in one class. -/
theorem latticeClosed_of_engineFixed {L : Laws n} {st : State n} (h : EngineFixed L st) :
    LatticeClosed L st := by
  intro M c N d hM hN hmem
  apply h M c N d hM.1 hN.1
  have r₁ : Pi.single c 1 - vec M ∈ AddSubgroup.closure (engineRows L st) :=
    AddSubgroup.subset_closure (Or.inl (Or.inl ⟨M, c, hM.1, rfl⟩))
  have r₂ : Pi.single d 1 - vec N ∈ AddSubgroup.closure (engineRows L st) :=
    AddSubgroup.subset_closure (Or.inl (Or.inl ⟨N, d, hN.1, rfl⟩))
  have := add_mem (sub_mem r₁ r₂) (stateLattice_le_engine L st hmem)
  convert this using 1
  abel

/-- **A lattice merge is sound.** If the nodes of each class are
`=_E`-equal (I2) and `=_E` cancels, two nodes whose vectors are congruent
modulo the state's lattice are `=_E`-equal, and merging their classes
preserves I2. -/
theorem lattice_merge_sound {L : Laws n} {S : Set (Monomial n × Monomial n)} {st : State n}
    (h2 : I2 L S st) (hc : CancelClosed L S) {M N : Monomial n} {c d : Fin n}
    (hM : (M, c) ∈ st.nodes) (hN : (N, d) ∈ st.nodes) (hmem : vec M - vec N ∈ stateLattice L st) :
    E L S M N ∧ I2 L S (st.merge c d) := by
  have hE : E L S M N := by
    refine E_of_mem_latticeOf hc ?_ hmem
    rintro ⟨P, Q⟩ (⟨a, b, hP, hQ, hab⟩ | hl)
    · exact h2 P a Q b hP hQ hab
    · exact E.law hl
  exact ⟨hE, merge_I2 h2 hM hN hE⟩

/-! ## Completeness from lattice closure -/

/-- **Completeness at a lattice-closed state.** If every asserted pair is a
pair of active classmates, two `=_E`-equal active nodes are in one class.
`E_mem_lattice` puts their difference in the lattice of the asserted pairs
and the law instances, which is contained in the state's lattice. -/
theorem complete_of_latticeClosed {L : Laws n} {S : Set (Monomial n × Monomial n)}
    {st : State n} (hlat : LatticeClosed L st)
    (hS : ∀ M N, (M, N) ∈ S →
      ∃ c d, (M, c) ∈ st.active ∧ (N, d) ∈ st.active ∧ st.find c = st.find d)
    {M N : Monomial n} {c d : Fin n} (hM : (M, c) ∈ st.active) (hN : (N, d) ∈ st.active)
    (hMN : E L S M N) : st.find c = st.find d := by
  refine hlat M c N d hM hN (latticeOf_mono ?_ (E_mem_lattice hMN))
  rintro ⟨P, Q⟩ (h | h)
  · obtain ⟨a, b, hP, hQ, hab⟩ := hS P Q h
    exact Or.inl ⟨a, b, hP.1, hQ.1, hab⟩
  · exact Or.inr h

/-- **Completeness at convergence without `hcancel`.** The hypotheses of
`completion_complete_at_convergence`, with `hcancel` replaced by lattice
closure for a cancellative operator (what `lattice_round` establishes at
its fixpoint, `latticeClosed_of_engineFixed`). For a cancellative operator
the conclusion follows from lattice closure and `hS` alone; otherwise
`hcancel` is vacuous. -/
theorem completion_complete_cancellative_engine {L : Laws n}
    {S : Set (Monomial n × Monomial n)} {st : State n}
    {ss₀ ss : SlotState n}
    (h5₀ : SlotState.I5 ss₀) (hrun : SlotState.OpsStar ss₀ ss) (ha : SlotState.Agrees st ss)
    (h0 : I0Active st) (hcanon : ∀ c, L.clamp (st.rhs c) = st.rhs c) (hfix : RoundFixed L st)
    (hlaw : ∀ P Q, L.lawRel P Q → degLex P Q)
    (hnf_ax : ∀ M N, ¬ Rw (plain n) L.axRules (L.clamp M) N)
    (hcp : ∀ r₁ r₂, r₁ ∈ st.rules ∪ L.axRules → r₂ ∈ st.rules ∪ L.axRules → r₁ ≠ r₂ →
      Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) (st.rules ∪ L.axRules))
        (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2)
    (hcc : ∀ P c d, (P, c) ∈ st.nodes → (P, d) ∈ st.nodes → st.find c = st.find d)
    (hS : ∀ M N, (M, N) ∈ S →
      ∃ c d, (M, c) ∈ st.active ∧ (N, d) ∈ st.active ∧ st.find c = st.find d)
    (hlat : L.cancellative → LatticeClosed L st)
    {M N : Monomial n} {c d : Fin n} (hM : (M, c) ∈ st.active) (hN : (N, d) ∈ st.active)
    (hMN : E L S M N) : st.find c = st.find d := by
  by_cases hc : L.cancellative
  · exact complete_of_latticeClosed (hlat hc) hS hM hN hMN
  · exact completion_complete_at_convergence h5₀ hrun ha h0 hcanon hfix hlaw hnf_ax hcp hcc
      hS (fun h => absurd h hc) hM hN hMN

/-- The same theorem with the engine's fixpoint condition. -/
theorem completion_complete_cancellative_engine' {L : Laws n}
    {S : Set (Monomial n × Monomial n)} {st : State n}
    {ss₀ ss : SlotState n}
    (h5₀ : SlotState.I5 ss₀) (hrun : SlotState.OpsStar ss₀ ss) (ha : SlotState.Agrees st ss)
    (h0 : I0Active st) (hcanon : ∀ c, L.clamp (st.rhs c) = st.rhs c) (hfix : RoundFixed L st)
    (hlaw : ∀ P Q, L.lawRel P Q → degLex P Q)
    (hnf_ax : ∀ M N, ¬ Rw (plain n) L.axRules (L.clamp M) N)
    (hcp : ∀ r₁ r₂, r₁ ∈ st.rules ∪ L.axRules → r₂ ∈ st.rules ∪ L.axRules → r₁ ≠ r₂ →
      Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) (st.rules ∪ L.axRules))
        (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2)
    (hcc : ∀ P c d, (P, c) ∈ st.nodes → (P, d) ∈ st.nodes → st.find c = st.find d)
    (hS : ∀ M N, (M, N) ∈ S →
      ∃ c d, (M, c) ∈ st.active ∧ (N, d) ∈ st.active ∧ st.find c = st.find d)
    (hfixL : L.cancellative → EngineFixed L st)
    {M N : Monomial n} {c d : Fin n} (hM : (M, c) ∈ st.active) (hN : (N, d) ∈ st.active)
    (hMN : E L S M N) : st.find c = st.find d :=
  completion_complete_cancellative_engine h5₀ hrun ha h0 hcanon hfix hlaw hnf_ax hcp hcc hS
    (fun h => latticeClosed_of_engineFixed (hfixL h)) hM hN hMN

/-! ## `hcancel` is not a consequence of lattice closure

`hcancel` asks that joinability cancel a common summand for every triple of
monomials, present in the state or not. Lattice closure constrains the
nodes present only. The state below has the nodes `{c₂, c₀}` and
`{c₁, c₀}` in class `c₀`, `{c₀³}` in class `c₁` and `{c₀⁴}` in class
`c₂`, and the single rule `{c₂, c₀} → {c₁, c₀}`. It is converged and
lattice-closed (every member of its lattice has `c₀`-coordinate zero, and
the four nodes' `c₀`-counts separate the classes), and `{c₂} + {c₀}`,
`{c₁} + {c₀}` are joinable while `{c₂}`, `{c₁}` are distinct normal forms.
So the completeness theorem for a cancellative operator rests on lattice
closure (`completion_complete_cancellative_engine`), not on `hcancel`.

The model's `=_E` does not read a class as the sum of its node's children
(flattening); `lattice_round` does, through its rows `e_c - vec M`, so the
engine would merge more in this state. The witness concerns the abstract
statement of `hcancel` only. -/

/-- AC with cancellation and no further law. -/
def cancelAC (n : ℕ) : Laws n := { Laws.plainAC n with cancellative := True }

/-- The witness state. -/
def cexState : State 3 where
  find := id
  nodes := {(({2, 0} : Monomial 3), 0), (({1, 0} : Monomial 3), 0),
    (({0, 0, 0} : Monomial 3), 1), (({0, 0, 0, 0} : Monomial 3), 2)}
  retired := ∅
  rhs := ![{1, 0}, {0, 0, 0}, {0, 0, 0, 0}]

theorem cex_mem {M : Monomial 3} {c : Fin 3} (h : (M, c) ∈ cexState.nodes) :
    (M = {2, 0} ∧ c = 0) ∨ (M = {1, 0} ∧ c = 0) ∨ (M = {0, 0, 0} ∧ c = 1) ∨
      (M = {0, 0, 0, 0} ∧ c = 2) := by
  simpa only [cexState, Set.mem_insert_iff, Set.mem_singleton_iff, Prod.mk.injEq] using h

theorem cex_active {M : Monomial 3} {c : Fin 3} : (M, c) ∈ cexState.active ↔
    (M, c) ∈ cexState.nodes := by
  simp [State.active, cexState]

theorem cex_rules {p : Monomial 3 × Monomial 3} (h : p ∈ cexState.rules) :
    p = (({2, 0} : Monomial 3), {1, 0}) := by
  obtain ⟨c, c', hp, h2, hlt, -, -⟩ := h
  rcases cex_mem (cex_active.mp hp) with ⟨h1, rfl⟩ | ⟨h1, rfl⟩ | ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · exact Prod.ext h1 h2
  all_goals
    rw [h1, h2] at hlt
    exact absurd hlt (by decide)

theorem cex_rule_mem : (({2, 0} : Monomial 3), ({1, 0} : Monomial 3)) ∈ cexState.rules :=
  ⟨0, 0, cex_active.mpr (Or.inl rfl), rfl, by decide, Or.inr (Or.inl rfl), rfl⟩

/-- A step by the one rule, for any clamp-free reading. -/
theorem cex_step {L : Laws 3} (hL : ∀ M, L.clamp M = M) {R : Rules 3}
    (hR : ∀ p ∈ R, p = (({2, 0} : Monomial 3), {1, 0})) {M P : Monomial 3}
    (h : Rw L R M P) : ({2, 0} : Monomial 3) ≤ M ∧ P = M - {2, 0} + {1, 0} := by
  obtain ⟨A, B, hAB, hA, rfl⟩ := h
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj (hR _ hAB)
  exact ⟨hA, hL _⟩

theorem cex_R (p : Monomial 3 × Monomial 3) (h : p ∈ cexState.rules ∪ (cancelAC 3).axRules) :
    p = (({2, 0} : Monomial 3), {1, 0}) := by
  rcases h with h | h
  · exact cex_rules h
  · exact h.elim

theorem cex_normal {L : Laws 3} (hL : ∀ M, L.clamp M = M) {R : Rules 3}
    (hR : ∀ p ∈ R, p = (({2, 0} : Monomial 3), {1, 0})) {M : Monomial 3}
    (hM : ¬ ({2, 0} : Monomial 3) ≤ M) (P : Monomial 3) : ¬ Rw L R M P :=
  fun h => hM (cex_step hL hR h).1

theorem cex_step_rule : Rw (cancelAC 3) cexState.rules ({2, 0} : Monomial 3) {1, 0} :=
  ⟨_, _, cex_rule_mem, le_rfl, by
    show ({1, 0} : Monomial 3) = ({2, 0} - {2, 0}) + {1, 0}
    rw [tsub_self, zero_add]⟩

/-- Every member of the witness state's lattice has `c₀`-coordinate zero. -/
theorem cex_lattice_zero {w : Fin 3 → ℤ} (hw : w ∈ stateLattice (cancelAC 3) cexState) :
    w 0 = 0 := by
  induction hw using AddSubgroup.closure_induction with
  | mem w hw =>
    obtain ⟨⟨M, N⟩, ⟨c, d, hM, hN, hcd⟩ | hl, rfl⟩ := hw
    · change c = d at hcd
      subst hcd
      rcases cex_mem hM with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
      rcases cex_mem hN with ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩ <;>
      first | exact absurd h (by decide) | decide
    · exact hl.elim
  | zero => rfl
  | add w w' _ _ ih ih' => simp [ih, ih']
  | neg w _ ih => simp [ih]

/-- **`hcancel` fails at a converged, lattice-closed state of a cancellative
operator.** The state satisfies `RoundFixed`, `I0Active`, `I5`, `hcc`,
canonical right-hand sides, `hcp` (one rule, so no pair of distinct rules),
`LatticeClosed`, and `hS` for `S = {({c₂, c₀}, {c₁, c₀})}`; the conclusion
of `hcancel` fails for `M = {c₂}`, `N = {c₁}`, `X = {c₀}`. -/
theorem hcancel_not_derivable :
    (cancelAC 3).cancellative ∧ RoundFixed (cancelAC 3) cexState ∧ I0Active cexState ∧
      I5 cexState ∧ (∀ c, (cancelAC 3).clamp (cexState.rhs c) = cexState.rhs c) ∧
      (∀ P c d, (P, c) ∈ cexState.nodes → (P, d) ∈ cexState.nodes →
        cexState.find c = cexState.find d) ∧
      (∀ r₁ r₂, r₁ ∈ cexState.rules ∪ (cancelAC 3).axRules →
        r₂ ∈ cexState.rules ∪ (cancelAC 3).axRules → r₁ ≠ r₂ → False) ∧
      LatticeClosed (cancelAC 3) cexState ∧
      (∀ M N, (M, N) ∈ ({(({2, 0} : Monomial 3), ({1, 0} : Monomial 3))} :
          Set (Monomial 3 × Monomial 3)) →
        ∃ c d, (M, c) ∈ cexState.active ∧ (N, d) ∈ cexState.active ∧
          cexState.find c = cexState.find d) ∧
      ¬ (∀ M N X : Monomial 3,
        Joinable (Rw (plain 3) (cexState.rules ∪ (cancelAC 3).axRules)) (M + X) (N + X) →
        Joinable (Rw (plain 3) (cexState.rules ∪ (cancelAC 3).axRules)) M N) := by
  have nrm : ∀ {M : Monomial 3}, ¬ ({2, 0} : Monomial 3) ≤ M →
      ∀ P, ¬ Rw (cancelAC 3) cexState.rules M P :=
    fun h => cex_normal (fun _ => rfl) (fun p hp => cex_rules hp) h
  refine ⟨trivial, ⟨?_, ?_⟩, ?_, ?_, fun _ => rfl, ?_, ?_, ?_, ?_, ?_⟩
  · -- `nf_present`: a normal form of a node is a node of its class
    intro M c N hM hMN hN
    have ha := cex_active.mp hM
    rcases cex_mem ha with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · rcases hMN.cases_head with rfl | ⟨P, hP, hPN⟩
      · exact absurd (hN _) (not_not.mpr cex_step_rule)
      · obtain ⟨-, rfl⟩ := cex_step (fun _ => rfl) (fun p hp => cex_rules hp) hP
        have e : ({2, 0} : Monomial 3) - {2, 0} + {1, 0} = {1, 0} := by rw [tsub_self, zero_add]
        rw [e] at hPN
        rw [← rtg_of_normal (nrm (by decide)) hPN]
        exact ⟨0, cex_active.mpr (Or.inr (Or.inl rfl)), rfl⟩
    all_goals
      rw [← rtg_of_normal (nrm (by decide)) hMN]
      exact ⟨_, hM, rfl⟩
  · intro r₁ r₂ h₁ h₂ hne
    exact absurd ((cex_rules h₁).trans (cex_rules h₂).symm) hne
  · intro c
    refine ⟨c, cex_active.mpr ?_, rfl⟩
    fin_cases c
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl rfl))
    · exact Or.inr (Or.inr (Or.inr rfl))
  · intro M c hM
    rcases cex_mem (cex_active.mp hM) with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inr (by decide)
    all_goals exact Or.inl rfl
  · intro P c d hc hd
    rcases cex_mem hc with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    rcases cex_mem hd with ⟨h, rfl⟩ | ⟨h, rfl⟩ | ⟨h, rfl⟩ | ⟨h, rfl⟩ <;>
    first | rfl | exact absurd h (by decide)
  · intro r₁ r₂ h₁ h₂ hne
    exact hne ((cex_R _ h₁).trans (cex_R _ h₂).symm)
  · intro M c N d hM hN hw
    have h0 := cex_lattice_zero hw
    rcases cex_mem hM.1 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    rcases cex_mem hN.1 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    first | rfl | exact absurd h0 (by decide)
  · intro M N h
    simp only [Set.mem_singleton_iff, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨0, 0, cex_active.mpr (Or.inl rfl), cex_active.mpr (Or.inr (Or.inl rfl)), rfl⟩
  · intro hcan
    have hj : Joinable (Rw (plain 3) (cexState.rules ∪ (cancelAC 3).axRules))
        ({2} + {0}) ({1} + {0}) :=
      ⟨{1, 0}, ReflTransGen.single ⟨_, _, Or.inl cex_rule_mem, le_rfl, by
        show ({1, 0} : Monomial 3) = ({2, 0} - {2, 0}) + {1, 0}
        rw [tsub_self, zero_add]⟩, ReflTransGen.refl⟩
    obtain ⟨P, h₁, h₂⟩ := hcan _ _ _ hj
    have e₁ := rtg_of_normal (cex_normal (fun _ => rfl) cex_R (by decide)) h₁
    have e₂ := rtg_of_normal (cex_normal (fun _ => rfl) cex_R (by decide)) h₂
    exact absurd (e₁.trans e₂.symm) (by decide)

end SemperProofs.CC.Lattice
