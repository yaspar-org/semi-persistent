import Mathlib

/-!
# AC-congruence closure: definitions

Formalizes part (a) and (b) of the proof sketch "AC-congruence closure:
soundness and completeness" (notes.md). One AC operator `f` is implicit:
a flat `f`-node is its canonical child multiset, a *monomial* over the
fixed summand pool `C := Fin n` (invariant I4 of the sketch).

* `degLex` is the degree-lex order of `multiset.rs:297-320`: size first,
  then at the largest class on which the two monomials differ, the larger
  count wins.
* `Laws` packages the operator's laws: the ground law instances `lawRel`
  and the count-domain normalization `clamp` (`nary_canon`).
* `E L S` is the equational theory `=_E` on monomials generated by the
  asserted equalities `S`, congruence under `f` (multiset union), the law
  instances, and cancellation when the operator is cancellative.
* `Rw L R` is one rewrite step `M →_R N` by a rule `f(A) → f(B)`.
* `State` is the abstract completion state and `Infer` its inference
  steps; `I0`-`I5` are the invariants of part (b).
-/

namespace SemperProofs.CC

/-- A monomial over the summand pool `Fin n`: the canonical child multiset
of a flat `f`-node. -/
abbrev Monomial (n : ℕ) := Multiset (Fin n)

variable {n : ℕ}

/-! ## Degree-lex order (sketch (a), `multiset.rs:297-320`) -/

/-- `degLex M N` means `M ≫ N`: `M` has more children, or the same number
and, at the largest class where the counts differ, the larger count. -/
def degLex (M N : Monomial n) : Prop :=
  Multiset.card N < Multiset.card M ∨
    (Multiset.card N = Multiset.card M ∧
      ∃ c : Fin n, (∀ d : Fin n, c < d → N.count d = M.count d) ∧ N.count c < M.count c)

instance degLex.decidableRel : DecidableRel (degLex (n := n)) := fun _ _ => by
  unfold degLex; infer_instance

/-- The count vector of a monomial, read as a colexicographic tuple. -/
def countVec (M : Monomial n) : Colex (Fin n → ℕ) := toColex fun c => M.count c

/-- `degLex` as a lexicographic product: size, then the colex count vector. -/
theorem degLex_iff (M N : Monomial n) :
    degLex M N ↔ Prod.Lex (· < ·) (· < ·)
      (Multiset.card N, countVec N) (Multiset.card M, countVec M) := by
  rw [Prod.lex_def]
  constructor
  · rintro (h | ⟨hc, c, hup, hlt⟩)
    · exact Or.inl h
    · exact Or.inr ⟨hc, c, fun d hd => hup d hd, hlt⟩
  · rintro (h | ⟨hc, c, hup, hlt⟩)
    · exact Or.inl h
    · exact Or.inr ⟨hc, c, fun d hd => hup d hd, hlt⟩

/-! ## Laws of the operator (sketch (a), "Theory") -/

/-- The operator's laws beyond associativity and commutativity, which the
multiset representation absorbs. `lawRel M N` holds for each ground law
instance (identity drop, idempotent contraction, nilpotent clamp, inverse
pair cancellation); `clamp` is the count-domain normalization of
`nary_canon`, which only removes children and only by law instances. -/
structure Laws (n : ℕ) where
  lawRel : Monomial n → Monomial n → Prop
  clamp : Monomial n → Monomial n
  clamp_le : ∀ M, clamp M ≤ M
  clamp_law : ∀ M, clamp M = M ∨ lawRel M (clamp M)
  cancellative : Prop

/-- Plain AC: no laws, `clamp` is the identity. -/
def Laws.plainAC (n : ℕ) : Laws n where
  lawRel _ _ := False
  clamp := id
  clamp_le _ := le_rfl
  clamp_law _ := Or.inl rfl
  cancellative := False

/-- The equational theory `=_E` on monomials (sketch (a)): generated by the
asserted equalities `S`, closed under equivalence, congruence under `f`
(union with a common multiset), the law instances, and cancellation when
the operator is cancellative. -/
inductive E (L : Laws n) (S : Set (Monomial n × Monomial n)) :
    Monomial n → Monomial n → Prop
  | ax {M N} : (M, N) ∈ S → E L S M N
  | refl (M) : E L S M M
  | symm {M N} : E L S M N → E L S N M
  | trans {M N P} : E L S M N → E L S N P → E L S M P
  | congr {M N} (X) : E L S M N → E L S (M + X) (N + X)
  | law {M N} : L.lawRel M N → E L S M N
  | cancel {M N X} : L.cancellative → E L S (M + X) (N + X) → E L S M N

/-! ## Rewriting (sketch (a), "Rewriting") -/

/-- A rule set: pairs `(A, B)` read as `f(A) → f(B)`. -/
abbrev Rules (n : ℕ) := Set (Monomial n × Monomial n)

/-- One rewrite step `M →_R N`: some rule `(A, B) ∈ R` with `A ⊆ M` and
`N = clamp((M − A) ⊎ B)`. -/
def Rw (L : Laws n) (R : Rules n) (M N : Monomial n) : Prop :=
  ∃ A B, (A, B) ∈ R ∧ A ≤ M ∧ N = L.clamp ((M - A) + B)

/-- Invariant I1: every rule is oriented, `lhs ≫ rhs`. -/
def Oriented (R : Rules n) : Prop := ∀ A B, (A, B) ∈ R → degLex A B

/-- Joinability under a relation: a common reduct. -/
def Joinable (r : α → α → Prop) (a b : α) : Prop :=
  Relation.Join (Relation.ReflTransGen r) a b

/-- Local confluence. -/
def LocallyConfluent (r : α → α → Prop) : Prop :=
  ∀ a b c, r a b → r a c → Joinable r b c

/-- Confluence. -/
def Confluent (r : α → α → Prop) : Prop :=
  ∀ a b c, Relation.ReflTransGen r a b → Relation.ReflTransGen r a c → Joinable r b c

/-- Two left sides share a child (`egraph.rs:3003-3012`, use-list
enumeration). Disjoint left sides commute, so their pair is trivial. The
sketch's "overlap without containment" is the sub-case that survives
inter-reduction; the critical-pair lemma below quantifies over every
sharing pair, containment included. -/
def Overlap (A B : Monomial n) : Prop :=
  ∃ x, x ∈ A ∧ x ∈ B

/-- The critical pair of two rules (sketch (a); `egraph.rs:3054-3075`):
`AB = A ∪ B` is the union by maximum. -/
def criticalPair (L : Laws n) (r₁ r₂ : Monomial n × Monomial n) :
    Monomial n × Monomial n :=
  (L.clamp ((r₁.1 ∪ r₂.1 - r₁.1) + r₁.2), L.clamp ((r₁.1 ∪ r₂.1 - r₂.1) + r₂.2))

/-! ## Completion state (sketch (a), "State", and (b)) -/

/-- The abstract completion state: the partition as a representative map
`find`, the node set as pairs `(M, c)` (child multiset, class), the retired
subset (`FLAG_AC_COLLAPSED`), and the stored right-hand side `rhs c`
(`class_rhs_into`, `egraph.rs:1439-1453`), read on representatives. -/
structure State (n : ℕ) where
  find : Fin n → Fin n
  nodes : Set (Monomial n × Fin n)
  retired : Set (Monomial n × Fin n)
  rhs : Fin n → Monomial n

namespace State

variable (st : State n)

/-- Active nodes: not retired. -/
def active : Set (Monomial n × Fin n) := st.nodes \ st.retired

/-- The rule set `R` of a state: an active node `(M, c)` with
`M ≫ rhs(find c)` is the rule `f(M) → f(rhs(find c))`, provided the
right-hand side is a node of the same class (invariant I0 folded into the
definition so that rules are sound whenever nodes are). -/
def rules : Rules n :=
  { p | ∃ c c', (p.1, c) ∈ st.active ∧ p.2 = st.rhs (st.find c) ∧ degLex p.1 p.2 ∧
        (p.2, c') ∈ st.nodes ∧ st.find c' = st.find c }

/-- Merge the classes of `a` and `b`: `b`'s representative survives. -/
def merge (a b : Fin n) : State n :=
  { st with find := fun x => if st.find x = st.find a then st.find b else st.find x }

/-- Add a node. -/
def addNode (M : Monomial n) (c : Fin n) : State n :=
  { st with nodes := insert (M, c) st.nodes }

/-- Retire a node (set `FLAG_AC_COLLAPSED`). -/
def retire (M : Monomial n) (c : Fin n) : State n :=
  { st with retired := insert (M, c) st.retired }

/-- A class is fresh when no node is in it. -/
def Fresh (d : Fin n) : Prop := ∀ M c, (M, c) ∈ st.nodes → st.find c ≠ st.find d

/-- Steps the completion loop takes between two monomials of a state: a
rewrite by a rule, a law instance in either direction, or two nodes of one
class. -/
def Step (L : Laws n) (a b : Monomial n) : Prop :=
  Rw L st.rules a b ∨ L.lawRel a b ∨ L.lawRel b a ∨
    ∃ c c', (a, c) ∈ st.nodes ∧ (b, c') ∈ st.nodes ∧ st.find c = st.find c'

end State

/-- The inference steps of one completion round (sketch (a), "State"; (c)).
Minting materializes a normal form in a fresh class; `joinMerge` covers the
(A′) merge, the (B) close of a critical pair, the axiom pairs and plain
congruence; `cancelMerge` is cancel-close; `retire` sets the flag;
`setRhs` refreshes the stored minima. -/
inductive Infer (L : Laws n) : State n → State n → Prop
  | mint {st : State n} {M : Monomial n} {c : Fin n} {N : Monomial n} {d : Fin n} :
      (M, c) ∈ st.nodes → Relation.ReflTransGen (Rw L st.rules) M N → st.Fresh d →
      Infer L st (st.addNode N d)
  | joinMerge {st : State n} {M : Monomial n} {c : Fin n} {N : Monomial n} {d : Fin n} :
      (M, c) ∈ st.nodes → (N, d) ∈ st.nodes →
      Relation.ReflTransGen (st.Step L) M N → Infer L st (st.merge c d)
  | cancelMerge {st : State n} {M N X : Monomial n} {c d c' d' : Fin n} :
      L.cancellative → (M + X, c) ∈ st.nodes → (N + X, d) ∈ st.nodes →
      st.find c = st.find d → (M, c') ∈ st.nodes → (N, d') ∈ st.nodes →
      Infer L st (st.merge c' d')
  | retire {st : State n} {M : Monomial n} {c : Fin n} :
      (M, c) ∈ st.nodes → Infer L st (st.retire M c)
  | setRhs {st : State n} (rhs' : Fin n → Monomial n) :
      Infer L st { st with rhs := rhs' }

/-- Reachable states. -/
def Reachable (L : Laws n) : State n → State n → Prop :=
  Relation.ReflTransGen (Infer L)

/-! ## Invariants (sketch (b)) -/

/-- I0: every class's stored right-hand side is a node of that class. -/
def I0 (st : State n) : Prop :=
  ∀ c, ∃ c', (st.rhs (st.find c), c') ∈ st.nodes ∧ st.find c' = st.find c

/-- I2: soundness of the state. Any two nodes of one class are `=_E`-equal;
the partition is contained in `=_E`. -/
def I2 (L : Laws n) (S : Set (Monomial n × Monomial n)) (st : State n) : Prop :=
  ∀ M c M' c', (M, c) ∈ st.nodes → (M', c') ∈ st.nodes → st.find c = st.find c' →
    E L S M M'

/-- I3: every retired node rewrites, in at least one step, to a node of
its class. -/
def I3 (L : Laws n) (st : State n) : Prop :=
  ∀ M c, (M, c) ∈ st.retired →
    ∃ M' c', Relation.TransGen (Rw L st.rules) M M' ∧ (M', c') ∈ st.nodes ∧
      st.find c' = st.find c

/-- I4: fixed summand pool. Every class occurring as a child is in `pool`. -/
def I4 (pool : Finset (Fin n)) (st : State n) : Prop :=
  ∀ M c, (M, c) ∈ st.nodes → ∀ x ∈ M, x ∈ pool

/-- I5: minimality. The stored right-hand side of a class is `≫`-least
among its active nodes. -/
def I5 (st : State n) : Prop :=
  ∀ M c, (M, c) ∈ st.active → st.rhs (st.find c) = M ∨ degLex M (st.rhs (st.find c))

/-- Convergence (sketch (e)): every critical pair of two overlapping rules
is joinable and every active node rewrites to its class's right-hand side. -/
structure Converged (L : Laws n) (st : State n) : Prop where
  cp_joinable : ∀ r₁ r₂, r₁ ∈ st.rules → r₂ ∈ st.rules → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
    Joinable (Rw L st.rules) (criticalPair L r₁ r₂).1 (criticalPair L r₁ r₂).2
  nodes_reduce : ∀ M c, (M, c) ∈ st.active →
    Relation.ReflTransGen (Rw L st.rules) M (st.rhs (st.find c))

/-- A round that changes nothing (sketch (e), "changes nothing"), as the
engine's `cc_round` checks it:

* `nf_present` (the (A′) normalize pass): the normal form of every active
  node is an active node of its class. The engine materializes each
  node's normal form and merges it in before retiring the node; a normal
  form is irreducible, so it is never retired.
* `lhs_reduced` (the reducibility pass, "Kapur-reduced"): no rule's
  left-hand side is reducible by another rule. A node whose monomial
  contains another rule's left-hand side, strictly or as an equal copy,
  is rewritten to its normal form, merged and retired
  (`FLAG_AC_COLLAPSED`), so it is no rule of the fixed state. Hence no two
  distinct rules have containing left-hand sides.
* `cp_joinable` (the (B) superposition loop): both reducts of every
  critical pair of two overlapping rules, neither left-hand side
  containing the other, are joinable. The loop skips disjoint pairs
  (their critical pair is trivially joinable, `critical_pair_lemma`) and
  containing pairs (none exists, by `lhs_reduced`).

`RoundFixed.cp_joinable_all` recovers joinability for every overlapping
pair of distinct rules, which is what the critical-pair lemma needs. -/
structure RoundFixed (L : Laws n) (st : State n) : Prop where
  nf_present : ∀ M c N, (M, c) ∈ st.active →
    Relation.ReflTransGen (Rw L st.rules) M N → (∀ P, ¬ Rw L st.rules N P) →
    ∃ c', (N, c') ∈ st.active ∧ st.find c' = st.find c
  lhs_reduced : ∀ r₁ r₂, r₁ ∈ st.rules → r₂ ∈ st.rules → r₁ ≠ r₂ → ¬ r₂.1 ≤ r₁.1
  cp_joinable : ∀ r₁ r₂, r₁ ∈ st.rules → r₂ ∈ st.rules → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
    ¬ r₁.1 ≤ r₂.1 → ¬ r₂.1 ≤ r₁.1 →
    Joinable (Rw L st.rules) (criticalPair L r₁ r₂).1 (criticalPair L r₁ r₂).2

/-- Every critical pair of two distinct overlapping rules of a fixed round
is joinable: a containing pair does not exist (`lhs_reduced`), and the
other pairs are the ones the superposition loop closed (`cp_joinable`). -/
theorem RoundFixed.cp_joinable_all {L : Laws n} {st : State n} (h : RoundFixed L st) :
    ∀ r₁ r₂, r₁ ∈ st.rules → r₂ ∈ st.rules → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw L st.rules) (criticalPair L r₁ r₂).1 (criticalPair L r₁ r₂).2 :=
  fun r₁ r₂ h₁ h₂ hne hov =>
    h.cp_joinable r₁ r₂ h₁ h₂ hne hov (h.lhs_reduced r₂ r₁ h₂ h₁ (Ne.symm hne))
      (h.lhs_reduced r₁ r₂ h₁ h₂ hne)

end SemperProofs.CC
