import SemperProofs.CC.Laws.Count

/-!
# The nilpotent law `aᵏ = ∅`

The engine's nilpotent normalization of order `k` (`nary_canon.rs:125-132`)
maps every class count `c` to `c % k` (`rem_order`, `multiplicity.rs:208-210`)
and drops the class when the remainder is `0`; in particular `0 ↦ 0`, never
to `k`. This is the count map `φ c := c % k` with threshold `p := k` and
`q := 0`, so the generators are `aᵏ → ∅`.

`Laws.nilpotent k hk cancel` is the `NFLaw.toLaws` read: its law relation
`lawRel M N :↔ N = clamp M ∧ N ≠ M` is the multi-step instance (all classes
reduced at once), and `NFLaw.E_iff` shows the equational theory equals the
one generated by the one-step instances `aᵏ → ∅`.
-/

namespace SemperProofs.CC

open Relation

variable {n : ℕ}

/-- The count map `c ↦ c % k`. -/
def nilpotentMap (k : ℕ) (hk : 2 ≤ k) : CountMap where
  φ c := c % k
  p := k
  q := 0
  q_lt := by omega
  fix c h := Nat.mod_eq_of_lt h
  bound c := Nat.mod_lt _ (by omega)
  step c h := by simp only [add_zero]; exact (Nat.mod_eq_sub_mod h).symm

/-- The nilpotent law of order `k` as an `NFLaw`. -/
def nilpotentNF (k : ℕ) (hk : 2 ≤ k) (cancel : Prop) : NFLaw n :=
  (nilpotentMap k hk).toNF cancel

/-- The nilpotent law of order `k` as a `Laws`. -/
def Laws.nilpotent (k : ℕ) (hk : 2 ≤ k) (cancel : Prop) : Laws n :=
  (nilpotentNF k hk cancel).toLaws

variable {k : ℕ} {hk : 2 ≤ k} {cancel : Prop}

theorem nilpotent_clamp (M : Monomial n) :
    (Laws.nilpotent k hk cancel).clamp M = ofCounts fun a => M.count a % k := rfl

@[simp] theorem count_nilpotent_clamp (M : Monomial n) (a : Fin n) :
    ((Laws.nilpotent k hk cancel).clamp M).count a = M.count a % k := by
  rw [nilpotent_clamp]; simp

theorem nilpotent_hlaw : ∀ P Q, (Laws.nilpotent (n := n) k hk cancel).lawRel P Q → degLex P Q :=
  (nilpotentNF k hk cancel).toLaws_hlaw

theorem nilpotent_hnf_ax : ∀ M N, ¬ Rw (plain n) (Laws.nilpotent k hk cancel).axRules
    ((Laws.nilpotent k hk cancel).clamp M) N :=
  (nilpotentNF k hk cancel).toLaws_hnf_ax

theorem nilpotentNF_gen_iff (r : Monomial n × Monomial n) :
    r ∈ (nilpotentNF k hk cancel).gen ↔ ∃ a, r = (Multiset.replicate k a, 0) := by
  constructor <;> rintro ⟨a, rfl⟩ <;> exact ⟨a, rfl⟩

/-- The rule-generator critical pair of `(A, B)` with `aᵏ → ∅`. -/
theorem nilpotent_cp_rule_gen (hk : 2 ≤ k) {A B : Monomial n} {a : Fin n}
    (hA : ∀ a, A.count a < k)
    (ha : a ∈ A) :
    criticalPair (plain n) (A, B) (Multiset.replicate k a, 0) =
      (B + Multiset.replicate (k - A.count a) a, A.filter (· ≠ a)) := by
  have := (nilpotentMap k hk).cp_rule_gen (B := B) hA ha
  simpa only [nilpotentMap, Multiset.replicate_zero, add_zero] using this

end SemperProofs.CC
