import SemperProofs.CC.Main

/-!
# Concrete law sets: the normal-form presentation

The engine's count-domain normalization `nary_canon::normalize`
(`nary_canon.rs:82-145`) is a *normal-form function* `nf` on monomials;
the laws it implements are generated by finitely many *one-step*
instances `gen` (`{u} → ∅`, `aᵏ → ∅`, `{a, a} → {a}`, `{x, inv x} → ∅`).
`NFLaw` packages both with the facts that make the two presentations
agree:

* `nf M ≤ M`, the output is `Fixed`, `Fixed` is closed under
  sub-multisets and `nf` is the identity on `Fixed` monomials;
* `M →*_gen nf M` (`gen_reach`) and every generator is an `nf`-instance
  (`gen_nf`).

`NFLaw.toLaws` reads it as a `Laws` with `lawRel M N :↔ N = nf M ∧ N ≠ M`
(so `clamp_law` is immediate) and `clamp := nf`. The two hypotheses of
`completion_complete_at_convergence` that are properties of the laws
alone, `hlaw` and `hnf_ax`, hold for every `NFLaw` (`toLaws_hlaw`,
`toLaws_hnf_ax`). Plain rewriting by `R ∪ Ax` and by `R ∪ gen` have the
same reflexive-transitive closure (`rtg_iff`), so the critical-pair
hypothesis `hcp` over the infinite `Ax` reduces to the critical pairs of
`R ∪ gen` (`hcp_of_gen`), and the equational theory `E` is the one
generated by `gen` (`E_iff`).
-/

namespace SemperProofs.CC

open Relation

variable {n : ℕ}

/-! ## Count vectors -/

/-- The monomial with count `f a` of each class `a`. -/
def ofCounts (f : Fin n → ℕ) : Monomial n := ∑ a : Fin n, Multiset.replicate (f a) a

@[simp] theorem count_ofCounts (f : Fin n → ℕ) (b : Fin n) : (ofCounts f).count b = f b := by
  unfold ofCounts
  rw [Multiset.count_sum', Finset.sum_eq_single b]
  · simp
  · intro c _ hc; simp [Multiset.count_replicate, hc]
  · simp

theorem ofCounts_count (M : Monomial n) : ofCounts (fun a => M.count a) = M := by
  ext a; simp

/-! ## Rewriting helpers -/

theorem Joinable_symm {α : Type*} {r : α → α → Prop} {a b : α} (h : Joinable r a b) :
    Joinable r b a := by
  obtain ⟨c, h₁, h₂⟩ := h
  exact ⟨c, h₂, h₁⟩

theorem Joinable_mono {L : Laws n} {R S : Rules n} (hsub : R ⊆ S) {M N : Monomial n}
    (h : Joinable (Rw L R) M N) : Joinable (Rw L S) M N := by
  obtain ⟨P, h₁, h₂⟩ := h
  exact ⟨P, Rw_rtg_mono hsub h₁, Rw_rtg_mono hsub h₂⟩

theorem Joinable_of_rtg {α : Type*} {r : α → α → Prop} {a b : α} (h : ReflTransGen r a b) :
    Joinable r a b :=
  ⟨b, h, ReflTransGen.refl⟩

/-- A critical pair read in the other order is the swapped pair. -/
theorem criticalPair_comm (L : Laws n) (r₁ r₂ : Monomial n × Monomial n) :
    criticalPair L r₁ r₂ = (criticalPair L r₂ r₁).swap := by
  simp only [criticalPair, Prod.swap, Multiset.union_comm r₁.1 r₂.1]

/-- A plain step with the rule `(A, B)` from any `U ⊇ A`. -/
theorem Rw_plain_of_le {R : Rules n} {A B U : Monomial n} (h : (A, B) ∈ R) (hA : A ≤ U) :
    Rw (plain n) R U ((U - A) + B) :=
  ⟨A, B, h, hA, rfl⟩

/-- A confluent plain system joins every critical pair. -/
theorem cp_joinable_of_confluent {R : Rules n} (hconf : Confluent (Rw (plain n) R))
    (r₁ r₂ : Monomial n × Monomial n) (h₁ : r₁ ∈ R) (h₂ : r₂ ∈ R) :
    Joinable (Rw (plain n) R) (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2 := by
  obtain ⟨A, B⟩ := r₁
  obtain ⟨A', B'⟩ := r₂
  exact hconf _ _ _ (ReflTransGen.single (Rw_plain_of_le h₁ Multiset.le_union_left))
    (ReflTransGen.single (Rw_plain_of_le h₂ Multiset.le_union_right))

/-- Splitting the critical pairs of a union `R ∪ G` into the three kinds. -/
theorem hcp_split {S R G : Rules n}
    (hRR : ∀ r₁ r₂, r₁ ∈ R → r₂ ∈ R → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) S) (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2)
    (hRG : ∀ r₁ r₂, r₁ ∈ R → r₂ ∈ G → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) S) (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2)
    (hGG : ∀ r₁ r₂, r₁ ∈ G → r₂ ∈ G → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) S) (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2) :
    ∀ r₁ r₂, r₁ ∈ R ∪ G → r₂ ∈ R ∪ G → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) S) (criticalPair (plain n) r₁ r₂).1
        (criticalPair (plain n) r₁ r₂).2 := by
  intro r₁ r₂ h₁ h₂ hne hov
  rcases h₁ with h₁ | h₁ <;> rcases h₂ with h₂ | h₂
  · exact hRR r₁ r₂ h₁ h₂ hne hov
  · exact hRG r₁ r₂ h₁ h₂ hne hov
  · have hov' : Overlap r₂.1 r₁.1 := by obtain ⟨x, hx, hy⟩ := hov; exact ⟨x, hy, hx⟩
    have := hRG r₂ r₁ h₂ h₁ (Ne.symm hne) hov'
    rw [criticalPair_comm (plain n) r₁ r₂]
    exact Joinable_symm this
  · exact hGG r₁ r₂ h₁ h₂ hne hov

/-! ## Normal-form law sets -/

/-- A law set given by its normal-form function `nf` (the engine's
`normalize`) and its one-step generators `gen`. -/
structure NFLaw (n : ℕ) where
  /-- The normal-form function: the engine's count-domain normalization. -/
  nf : Monomial n → Monomial n
  /-- The one-step law instances read as rewrite rules. -/
  gen : Rules n
  /-- The `nf`-fixed monomials, characterized. -/
  Fixed : Monomial n → Prop
  /-- Whether the operator is cancellative. -/
  cancellative : Prop
  nf_le : ∀ M, nf M ≤ M
  fixed_nf : ∀ M, Fixed (nf M)
  fixed_sub : ∀ A M, A ≤ M → Fixed M → Fixed A
  nf_of_fixed : ∀ M, Fixed M → nf M = M
  gen_reach : ∀ M, ReflTransGen (Rw (plain n) gen) M (nf M)
  gen_nf : ∀ L R, (L, R) ∈ gen → nf L = R ∧ R ≠ L

namespace NFLaw

variable (N : NFLaw n)

theorem nf_sub {A M : Monomial n} (h : A ≤ N.nf M) : N.nf A = A :=
  N.nf_of_fixed A (N.fixed_sub A _ h (N.fixed_nf M))

theorem nf_idem (M : Monomial n) : N.nf (N.nf M) = N.nf M := N.nf_sub le_rfl

theorem nf_zero : N.nf 0 = 0 := le_zero_iff.mp (N.nf_le 0)

theorem fixed_zero : N.Fixed 0 := N.fixed_sub 0 _ (Multiset.zero_le _) (N.fixed_nf 0)

/-- The `Laws` read of a normal-form law set: `lawRel M N :↔ N = nf M ∧ N ≠ M`. -/
def toLaws : Laws n where
  lawRel M P := P = N.nf M ∧ P ≠ M
  clamp := N.nf
  clamp_le := N.nf_le
  clamp_law M := by
    by_cases h : N.nf M = M
    · exact Or.inl h
    · exact Or.inr ⟨rfl, h⟩
  cancellative := N.cancellative

@[simp] theorem toLaws_clamp (M : Monomial n) : N.toLaws.clamp M = N.nf M := rfl

theorem toLaws_lawRel (M P : Monomial n) : N.toLaws.lawRel M P ↔ P = N.nf M ∧ P ≠ M :=
  Iff.rfl

theorem mem_axRules {M P : Monomial n} : (M, P) ∈ N.toLaws.axRules ↔ P = N.nf M ∧ P ≠ M :=
  Iff.rfl

/-- `hlaw`: every law instance shrinks in degree-lex. -/
theorem toLaws_hlaw : ∀ P Q, N.toLaws.lawRel P Q → degLex P Q := by
  rintro P Q ⟨rfl, hne⟩
  exact degLex_of_lt (lt_of_le_of_ne (N.nf_le P) hne)

/-- `hnf_ax`: `nf` outputs are normal for the law instances. -/
theorem toLaws_hnf_ax : ∀ M P, ¬ Rw (plain n) N.toLaws.axRules (N.toLaws.clamp M) P := by
  rintro M P ⟨A, B, ⟨hB, hne⟩, hA, -⟩
  simp only at hB hne
  exact hne (hB.trans (N.nf_sub hA))

theorem gen_oriented : Oriented N.gen := by
  intro L R h
  obtain ⟨h1, h2⟩ := N.gen_nf L R h
  exact degLex_of_lt (lt_of_le_of_ne (h1 ▸ N.nf_le L) h2)

theorem gen_sub_axRules : N.gen ⊆ N.toLaws.axRules := by
  rintro ⟨L, R⟩ h
  obtain ⟨h1, h2⟩ := N.gen_nf L R h
  exact ⟨h1.symm, h2⟩

/-- The generators as a `Laws` with the identity clamp. -/
def genLaws : Laws n where
  lawRel M P := (M, P) ∈ N.gen
  clamp := id
  clamp_le _ := le_rfl
  clamp_law _ := Or.inl rfl
  cancellative := N.cancellative

/-! ### `R ∪ Ax` and `R ∪ gen` reach the same monomials -/

theorem rtg_gen_of_ax {R : Rules n} {M P : Monomial n}
    (h : Rw (plain n) (R ∪ N.toLaws.axRules) M P) :
    ReflTransGen (Rw (plain n) (R ∪ N.gen)) M P := by
  obtain ⟨A, B, hAB, hA, rfl⟩ := h
  rcases hAB with hAB | ⟨hB, -⟩
  · exact ReflTransGen.single ⟨A, B, Or.inl hAB, hA, rfl⟩
  · simp only at hB
    subst hB
    have h1 := Rw_rtg_mono (R := N.gen) (S := R ∪ N.gen) Set.subset_union_right
      (Rw_rtg_add (L := plain n) (fun _ => rfl) (M - A) (N.gen_reach A))
    rw [add_comm A, tsub_add_cancel_of_le hA, add_comm] at h1
    exact h1

theorem rtg_iff {R : Rules n} (M P : Monomial n) :
    ReflTransGen (Rw (plain n) (R ∪ N.toLaws.axRules)) M P ↔
      ReflTransGen (Rw (plain n) (R ∪ N.gen)) M P := by
  constructor
  · intro h
    induction h with
    | refl => exact ReflTransGen.refl
    | tail _ hs ih => exact ih.trans (N.rtg_gen_of_ax hs)
  · exact Rw_rtg_mono (Set.union_subset_union_right R N.gen_sub_axRules)

theorem joinable_iff {R : Rules n} (M P : Monomial n) :
    Joinable (Rw (plain n) (R ∪ N.toLaws.axRules)) M P ↔
      Joinable (Rw (plain n) (R ∪ N.gen)) M P := by
  constructor
  · rintro ⟨Q, h₁, h₂⟩
    exact ⟨Q, (N.rtg_iff _ _).mp h₁, (N.rtg_iff _ _).mp h₂⟩
  · rintro ⟨Q, h₁, h₂⟩
    exact ⟨Q, (N.rtg_iff _ _).mpr h₁, (N.rtg_iff _ _).mpr h₂⟩

theorem confluent_iff {R : Rules n} :
    Confluent (Rw (plain n) (R ∪ N.toLaws.axRules)) ↔ Confluent (Rw (plain n) (R ∪ N.gen)) := by
  constructor
  · intro h a b c hab hac
    exact (N.joinable_iff _ _).mp (h a b c ((N.rtg_iff _ _).mpr hab) ((N.rtg_iff _ _).mpr hac))
  · intro h a b c hab hac
    exact (N.joinable_iff _ _).mpr (h a b c ((N.rtg_iff _ _).mp hab) ((N.rtg_iff _ _).mp hac))

/-- Confluence of `R ∪ gen` from the critical pairs of `R ∪ gen`. -/
theorem confluent_gen {R : Rules n} (hor : Oriented R)
    (hcp : ∀ r₁ r₂, r₁ ∈ R ∪ N.gen → r₂ ∈ R ∪ N.gen → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) (R ∪ N.gen))
        (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2) :
    Confluent (Rw (plain n) (R ∪ N.gen)) := by
  have hor' : Oriented (R ∪ N.gen) := by
    intro A B h
    rcases h with h | h
    · exact hor A B h
    · exact N.gen_oriented A B h
  exact newman (Rw_wf hor') (critical_pair_lemma (plain n) (fun _ => rfl) _ hcp)

/-- The `hcp` hypothesis of `completion_complete_at_convergence` for a
normal-form law set, from the critical pairs of `R ∪ gen` only. -/
theorem hcp_of_gen {R : Rules n} (hor : Oriented R)
    (hcp : ∀ r₁ r₂, r₁ ∈ R ∪ N.gen → r₂ ∈ R ∪ N.gen → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) (R ∪ N.gen))
        (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2) :
    ∀ r₁ r₂, r₁ ∈ R ∪ N.toLaws.axRules → r₂ ∈ R ∪ N.toLaws.axRules → r₁ ≠ r₂ →
      Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) (R ∪ N.toLaws.axRules))
        (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2 := by
  intro r₁ r₂ h₁ h₂ _ _
  exact cp_joinable_of_confluent (N.confluent_iff.mpr (N.confluent_gen hor hcp)) r₁ r₂ h₁ h₂

/-- The rule-rule critical pairs under `R ∪ Ax` give them under `R ∪ gen`. -/
theorem hcp_rules_gen_of_ax {R : Rules n}
    (hRR : ∀ r₁ r₂, r₁ ∈ R → r₂ ∈ R → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) (R ∪ N.toLaws.axRules))
        (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2) :
    ∀ r₁ r₂, r₁ ∈ R → r₂ ∈ R → r₁ ≠ r₂ → Overlap r₁.1 r₂.1 →
      Joinable (Rw (plain n) (R ∪ N.gen))
        (criticalPair (plain n) r₁ r₂).1 (criticalPair (plain n) r₁ r₂).2 :=
  fun r₁ r₂ h₁ h₂ hne hov => (N.joinable_iff _ _).mp (hRR r₁ r₂ h₁ h₂ hne hov)

/-! ### The equational theory is the one generated by `gen` -/

theorem E_genLaws_of_rtg {S : Set (Monomial n × Monomial n)} {M P : Monomial n}
    (h : ReflTransGen (Rw (plain n) N.gen) M P) : E N.genLaws S M P := by
  induction h with
  | refl => exact E.refl _
  | @tail Q _ _ hs ih =>
    obtain ⟨A, B, hAB, hA, rfl⟩ := hs
    refine ih.trans ?_
    have := E.congr (L := N.genLaws) (S := S) (Q - A) (E.law (show N.genLaws.lawRel A B from hAB))
    rw [add_comm, tsub_add_cancel_of_le hA, add_comm] at this
    exact this

/-- `E` over the normal-form read and over the generators coincide. -/
theorem E_iff (S : Set (Monomial n × Monomial n)) (M P : Monomial n) :
    E N.toLaws S M P ↔ E N.genLaws S M P := by
  constructor
  · intro h
    induction h with
    | ax h => exact E.ax h
    | refl M => exact E.refl M
    | symm _ ih => exact ih.symm
    | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
    | congr X _ ih => exact ih.congr X
    | law h =>
      obtain ⟨rfl, -⟩ := h
      exact N.E_genLaws_of_rtg (N.gen_reach _)
    | cancel hc _ ih => exact E.cancel hc ih
  · intro h
    induction h with
    | ax h => exact E.ax h
    | refl M => exact E.refl M
    | symm _ ih => exact ih.symm
    | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
    | congr X _ ih => exact ih.congr X
    | law h =>
      obtain ⟨h1, h2⟩ := N.gen_nf _ _ h
      exact E.law ⟨h1.symm, h2⟩
    | cancel hc _ ih => exact E.cancel hc ih

/-! ### Composition: the engine applies its laws in sequence -/

/-- Apply `N₁`'s normalization, then `N₂`'s. The generators are pooled.
The side conditions say that `N₂` never undoes an `N₁`-instance's output
(`h₁`) and that the composite still maps each `N₂`-generator to its
right side (`h₂`). -/
def comp (N₁ N₂ : NFLaw n)
    (h₁ : ∀ L R, (L, R) ∈ N₁.gen → N₂.Fixed R)
    (h₂ : ∀ L R, (L, R) ∈ N₂.gen → N₂.nf (N₁.nf L) = R) : NFLaw n where
  nf M := N₂.nf (N₁.nf M)
  gen := N₁.gen ∪ N₂.gen
  Fixed M := N₁.Fixed M ∧ N₂.Fixed M
  cancellative := N₁.cancellative ∨ N₂.cancellative
  nf_le M := (N₂.nf_le _).trans (N₁.nf_le M)
  fixed_nf M := ⟨N₁.fixed_sub _ _ (N₂.nf_le _) (N₁.fixed_nf M), N₂.fixed_nf _⟩
  fixed_sub A M h hM := ⟨N₁.fixed_sub A M h hM.1, N₂.fixed_sub A M h hM.2⟩
  nf_of_fixed M hM := by rw [N₁.nf_of_fixed M hM.1, N₂.nf_of_fixed M hM.2]
  gen_reach M :=
    (Rw_rtg_mono Set.subset_union_left (N₁.gen_reach M)).trans
      (Rw_rtg_mono Set.subset_union_right (N₂.gen_reach _))
  gen_nf L R h := by
    rcases h with h | h
    · obtain ⟨e, hne⟩ := N₁.gen_nf L R h
      exact ⟨by rw [e, N₂.nf_of_fixed R (h₁ L R h)], hne⟩
    · exact ⟨h₂ L R h, (N₂.gen_nf L R h).2⟩

@[simp] theorem comp_nf (N₁ N₂ : NFLaw n) (h₁ h₂) (M : Monomial n) :
    (comp N₁ N₂ h₁ h₂).nf M = N₂.nf (N₁.nf M) := rfl

@[simp] theorem comp_gen (N₁ N₂ : NFLaw n) (h₁ h₂) :
    (comp N₁ N₂ h₁ h₂).gen = N₁.gen ∪ N₂.gen := rfl

end NFLaw

end SemperProofs.CC
