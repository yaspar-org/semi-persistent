import SemperProofs.CC.Laws.Basic

/-!
# The identity law `f(x, e) = x`

The engine drops every occurrence of the unit class from an AC child
list (`nary_canon.rs:122-124`, `kids.retain(|k| class(k) != u)`), after
coalescing and before the nilpotent clamp and the inverse cancellation.
Stored monomials never carry the unit, and the right-hand side of a rule
whose class is the unit class is the empty monomial (`egraph.rs:1439-1453`).

`Laws.identity u` reads this as a normal-form law set: `clamp M =
M.filter (· ≠ u)`, generated by the single rule `{u} → ∅`. `lawRel M N
:↔ N = clamp M ∧ N ≠ M` is the multi-step instance (dropping every copy
of `u` at once), which makes `clamp_law` immediate; `NFLaw.E_iff` shows
the resulting theory is the one generated by the one-step instance.
-/

namespace SemperProofs.CC

open Relation

variable {n : ℕ}

/-- Drop the unit class. -/
def unitDrop (u : Fin n) (M : Monomial n) : Monomial n := M.filter (· ≠ u)

/-- The generator `{u} → ∅`. -/
def unitGen (u : Fin n) : Rules n := {(({u} : Monomial n), (0 : Monomial n))}

@[simp] theorem count_unitDrop (u : Fin n) (M : Monomial n) (a : Fin n) :
    (unitDrop u M).count a = if a = u then 0 else M.count a := by
  unfold unitDrop
  rw [Multiset.count_filter]
  by_cases h : a = u <;> simp [h]

theorem unitDrop_le (u : Fin n) (M : Monomial n) : unitDrop u M ≤ M := Multiset.filter_le _ _

theorem unitDrop_of_notMem {u : Fin n} {M : Monomial n} (h : u ∉ M) : unitDrop u M = M := by
  ext a
  rw [count_unitDrop]
  split_ifs with ha
  · subst ha; exact (Multiset.count_eq_zero_of_notMem h).symm
  · rfl

theorem notMem_unitDrop (u : Fin n) (M : Monomial n) : u ∉ unitDrop u M := by
  rw [← Multiset.count_eq_zero, count_unitDrop]; simp

theorem unitDrop_reach (u : Fin n) (M : Monomial n) :
    ReflTransGen (Rw (plain n) (unitGen u)) M (unitDrop u M) := by
  -- peel the copies of `u` one at a time
  have key : ∀ k (X : Monomial n), u ∉ X →
      ReflTransGen (Rw (plain n) (unitGen u)) (X + Multiset.replicate k u) X := by
    intro k X hX
    induction k with
    | zero => simpa using ReflTransGen.refl
    | succ k ih =>
      refine ReflTransGen.head ?_ ih
      have hle : ({u} : Monomial n) ≤ X + Multiset.replicate (k + 1) u := by
        rw [Multiset.replicate_succ, ← Multiset.singleton_add]
        exact le_add_left (le_add_right le_rfl)
      refine ⟨{u}, 0, rfl, hle, ?_⟩
      rw [plain_clamp, add_zero]
      ext a
      rw [Multiset.count_sub, Multiset.count_add, Multiset.count_add, Multiset.count_replicate,
        Multiset.count_replicate, Multiset.count_singleton]
      by_cases h : a = u
      · subst h; simp
      · simp [h, Ne.symm h]
  have hM : M = unitDrop u M + Multiset.replicate (M.count u) u := by
    ext a
    rw [Multiset.count_add, count_unitDrop, Multiset.count_replicate]
    by_cases h : a = u
    · subst h; simp
    · simp [h, Ne.symm h]
  have := key (M.count u) (unitDrop u M) (notMem_unitDrop u M)
  rwa [← hM] at this

/-- The identity law as a normal-form law set. -/
def identityNF (u : Fin n) (cancel : Prop) : NFLaw n where
  nf := unitDrop u
  gen := unitGen u
  Fixed M := u ∉ M
  cancellative := cancel
  nf_le := unitDrop_le u
  fixed_nf := notMem_unitDrop u
  fixed_sub _ _ h hM hu := hM (Multiset.mem_of_le h hu)
  nf_of_fixed _ := unitDrop_of_notMem
  gen_reach := unitDrop_reach u
  gen_nf L R h := by
    simp only [unitGen, Set.mem_singleton_iff, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    refine ⟨?_, by simp⟩
    ext a
    rw [count_unitDrop, Multiset.count_singleton]
    by_cases h : a = u <;> simp [h]

/-- The identity law `f(x, e) = x` with unit class `u`. -/
def Laws.identity (u : Fin n) (cancel : Prop) : Laws n := (identityNF u cancel).toLaws

theorem identity_clamp (u : Fin n) (cancel : Prop) (M : Monomial n) :
    (Laws.identity u cancel).clamp M = M.filter (· ≠ u) := rfl

theorem identity_lawRel (u : Fin n) (cancel : Prop) (M N : Monomial n) :
    (Laws.identity u cancel).lawRel M N ↔ N = M.filter (· ≠ u) ∧ N ≠ M := Iff.rfl

/-- `hlaw` for the identity law. -/
theorem identity_hlaw (u : Fin n) (cancel : Prop) :
    ∀ P Q, (Laws.identity u cancel).lawRel P Q → degLex P Q :=
  (identityNF u cancel).toLaws_hlaw

/-- `hnf_ax` for the identity law: a clamp output carries no unit, so no
law instance fits inside it. -/
theorem identity_hnf_ax (u : Fin n) (cancel : Prop) :
    ∀ M N, ¬ Rw (plain n) (Laws.identity u cancel).axRules ((Laws.identity u cancel).clamp M) N :=
  (identityNF u cancel).toLaws_hnf_ax

/-! ## Overlaps with the generator -/

theorem identityNF_gen_iff (u : Fin n) (cancel : Prop) (r : Monomial n × Monomial n) :
    r ∈ (identityNF u cancel).gen ↔ r = ({u}, 0) := Iff.rfl

/-- Two generators never form a non-trivial pair: there is one. -/
theorem unitGen_gen_gen {u : Fin n} {r₁ r₂ : Monomial n × Monomial n}
    (h₁ : r₁ ∈ unitGen u) (h₂ : r₂ ∈ unitGen u) : r₁ = r₂ := by
  simp only [unitGen, Set.mem_singleton_iff] at h₁ h₂
  rw [h₁, h₂]

/-- A rule overlaps the generator exactly when its left side carries the unit. -/
theorem overlap_unitGen_iff {u : Fin n} (A : Monomial n) :
    Overlap A ({u} : Monomial n) ↔ u ∈ A := by
  constructor
  · rintro ⟨x, hx, hxu⟩
    rw [Multiset.mem_singleton] at hxu
    exact hxu ▸ hx
  · intro h; exact ⟨u, h, Multiset.mem_singleton_self u⟩

end SemperProofs.CC
