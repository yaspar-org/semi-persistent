(sort E)
(constructor A () E)
(constructor C () E)
(constructor D () E)
(constructor Zero () E)
(constructor Neg (E) E)
(constructor Add (E) E :assoc :comm :identity (Zero) :inverse Neg)
(set-option :completion eager)
(union (Neg (A)) (Neg (C)))
(let s (Add (A) (Neg (A)) (C)))
(check-eq s (C))
