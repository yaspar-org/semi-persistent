(sort E)
(function p () E) (function q () E) (function Kc () E)
(function And (E) E :assoc-comm-idem)
(function Pick (E E) E)
(let k (Kc))
(let top (And (p) k))
(union k (And (p) (q)))
(rewrite (And x ..rest) (Pick x (And ..rest)) :flatten)
(run 1)
(check-eq top (Pick (p) k))
(check-eq top (Pick (q) (And (p))))
(check-eq top (Pick (p) (q)))
