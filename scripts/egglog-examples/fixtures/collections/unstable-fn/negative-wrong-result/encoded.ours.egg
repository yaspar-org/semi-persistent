(ruleset dispatch)
(datatype Math (Num i64) (Var String) (Add Math Math) (Mul Math Math))
(datatype MathList (Nil) (Cons Math MathList))
(datatype MathFn (SquareFn) (MulBy Math) (Compose MathFn MathFn))
(datatype IntFn (TimesBy i64))
(constructor Apply (MathFn Math) Math :cost 100)
(constructor square (Math) Math)
(constructor list_map_math (MathList MathFn) MathList)
(constructor list_multiply_by (MathList Math) MathList)
(constructor composed_math (MathFn MathFn Math) Math)
(constructor composed_i64_math (MathFn IntFn i64) Math)
(rewrite (Apply (SquareFn) x) (square x) :ruleset dispatch)
(rewrite (Apply (MulBy a) x) (Mul a x) :ruleset dispatch)
(rewrite (Apply (Compose f g) x) (composed_math f g x) :ruleset dispatch)
(rewrite (Mul (Num x) (Num y)) (Num (i64::* x y)))
(rewrite (square x) (Mul x x))
(let global_square_fn (SquareFn))
(let global_squared_3 (Apply global_square_fn (Num 3)))
(run dispatch 4)
(check-eq global_squared_3 (square (Num 3)))
(rewrite (list_map_math (Nil) fn) (Nil))
(rewrite (list_map_math (Cons x xs) fn) (Cons (Apply fn x) (list_map_math xs fn)))
(let global_x (Cons (Num 1) (Cons (Num 2) (Cons (Num 3) (Nil)))))
(let global_squared_x (list_map_math global_x global_square_fn))
(run dispatch 100)
