; Adapted from egglog tests/web-demo/unstable-fn.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(ruleset dispatch)
(datatype Math (Num i64) (Var String) (Add Math Math) (Mul Math Math))
(datatype MathList (Nil) (Cons Math MathList))
(datatype MathFn (SquareFn) (MulBy Math) (Compose MathFn MathFn))
(datatype IntFn (TimesBy i64))
(constructor Apply (MathFn Math) Math :cost 100)
(constructor square (Math) Math)
(constructor list-map-math (MathList MathFn) MathList)
(constructor list-multiply-by (MathList Math) MathList)
(constructor composed-math (MathFn MathFn Math) Math)
(constructor composed-i64-math (MathFn IntFn i64) Math)
(rewrite (Apply (SquareFn) x) (square x) :ruleset dispatch)
(rewrite (Apply (MulBy a) x) (Mul a x) :ruleset dispatch)
(rewrite (Apply (Compose f g) x) (composed-math f g x) :ruleset dispatch)
(rewrite (Mul (Num x) (Num y)) (Num (* x y)))
(rewrite (square x) (Mul x x))
(let $square-fn (SquareFn))
(let $squared-3 (Apply $square-fn (Num 3)))
(run dispatch 4)
(check (= $squared-3 (square (Num 3))))
(rewrite (list-map-math (Nil) fn) (Nil))
(rewrite (list-map-math (Cons x xs) fn) (Cons (Apply fn x) (list-map-math xs fn)))
(let $x (Cons (Num 1) (Cons (Num 2) (Cons (Num 3) (Nil)))))
(let $squared-x (list-map-math $x $square-fn))
(run dispatch 100)
(run 100)
(run dispatch 100)
(run 100)
(run dispatch 100)
(run 100)
(run dispatch 100)
(run 100)
(run dispatch 100)
