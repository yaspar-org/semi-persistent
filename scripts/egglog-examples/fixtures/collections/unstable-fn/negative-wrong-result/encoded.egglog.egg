(run 100)
(run dispatch 100)
(run 100)

(check (= $squared-x (Cons (Num 1) (Cons (Num 4) (Cons (Num 9) (Nil))))))
(rewrite (list-multiply-by l i) (list-map-math l (MulBy i)))
(let $doubled-x (list-multiply-by $x (Num 2)))
(run dispatch 100)
