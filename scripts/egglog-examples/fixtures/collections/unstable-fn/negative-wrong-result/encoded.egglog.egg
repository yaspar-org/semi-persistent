(check (= $squared-doubled-x (Cons (Num 4) (Cons (Num 16) (Cons (Num 36) (Nil))))))
(rewrite (composed-i64-math f (TimesBy k) v) (Apply f (Num (* k v))))
(let $res (composed-i64-math $square-fn (TimesBy 2) 4))
