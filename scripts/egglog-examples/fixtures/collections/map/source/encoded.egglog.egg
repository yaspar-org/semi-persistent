; Adapted from egglog tests/map.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.

(ruleset eval)
(datatype M (MNil) (MCons i64 String M))
(datatype Text (TextVal String))
(constructor MInsert (M i64 String) M :cost 100)
(constructor MGet (M i64) Text :cost 100)
(rewrite (MInsert (MNil) k v) (MCons k v (MNil)) :ruleset eval)
(rewrite (MInsert (MCons k old xs) k v) (MCons k v xs) :ruleset eval)
(rewrite (MInsert (MCons k old xs) q v) (MCons q v (MCons k old xs))
         :when ((< q k)) :ruleset eval)
(rewrite (MInsert (MCons k old xs) q v) (MCons k old (MInsert xs q v))
         :when ((> q k)) :ruleset eval)
(rewrite (MGet (MCons k v xs) k) (TextVal v) :ruleset eval)
(rewrite (MGet (MCons k v xs) q) (MGet xs q)
         :when ((!= k q)) :ruleset eval)
(let $my_map1 (MInsert (MNil) 1 "one"))
(let $my_map2 (MInsert $my_map1 2 "two"))
(let $lhs15 (TextVal "one"))
(let $rhs15 (MGet $my_map1 1))
(run eval 1000)
(check (= $lhs15 $rhs15))
(run eval 1000)
(extract $my_map2)
