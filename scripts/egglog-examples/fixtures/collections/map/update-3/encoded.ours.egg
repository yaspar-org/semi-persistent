; Adapted from egglog tests/map.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(ruleset eval)
(datatype M (MNil) (MCons i64 String M))
(datatype Text (TextVal String))
(constructor MInsert (M i64 String) M :cost 100)
(constructor MGet (M i64) Text :cost 100)
(rewrite (MInsert (MNil) k v) (MCons k v (MNil)) :ruleset eval)
(rewrite (MInsert (MCons k old xs) k v) (MCons k v xs) :ruleset eval)
(rewrite (MInsert (MCons k old xs) q v) (MCons q v (MCons k old xs)) :when ((i64::< q k)) :ruleset eval)
(rewrite (MInsert (MCons k old xs) q v) (MCons k old (MInsert xs q v)) :when ((i64::> q k)) :ruleset eval)
(rewrite (MGet (MCons k v xs) k) (TextVal v) :ruleset eval)
(rewrite (MGet (MCons k v xs) q) (MGet xs q) :when ((i64::!= k q)) :ruleset eval)
(let global_my_map1 (MInsert (MNil) 1 "one"))
(let global_my_map2 (MInsert global_my_map1 2 "two"))
(let global_lhs68 (TextVal "one"))
(let global_rhs68 (MGet global_my_map1 1))
(run eval 1000)
(check-eq global_lhs68 global_rhs68)
(run eval 1000)
(extract global_my_map2)
(let global_updated (MInsert (MInsert global_my_map2 3 "extra") 1 "changed"))
(let global_lhs69 (MGet global_updated 1))
(let global_rhs69 (TextVal "changed"))
(run eval 1000)
(check-eq global_lhs69 global_rhs69)
(let global_lhs70 (MGet global_my_map1 1))
(let global_rhs70 (TextVal "one"))
(run eval 1000)
(check-eq global_lhs70 global_rhs70)
(let global_lhs71 (MGet global_updated 3))
(let global_rhs71 (TextVal "extra"))
(run eval 1000)
(check-eq global_lhs71 global_rhs71)
(run eval 1000)
(extract global_updated)
