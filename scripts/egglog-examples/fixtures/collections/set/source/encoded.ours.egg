(ruleset eval)
(datatype N (NVal i64))
(constructor NAdd (N N) N :cost 100)
(rewrite (NAdd (NVal a) (NVal b)) (NVal (i64::+ a b)) :ruleset eval)
(ruleset enumerate)
(datatype S (SNil) (SCons i64 S))
(constructor SInsert (S i64) S :cost 100)
(constructor SUnion (S S) S :cost 100)
(constructor SRemove (S i64) S :cost 100)
(constructor SLength (S) N :cost 100)
(constructor SGet (S i64) N :cost 100)
(datatype Fact (Present) (Before i64 i64))
(rule ((SInsert (SCons a tail) b) (i64::< a b) (i64::>= a 0) (i64::>= b 0)) ((union (Before a b) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (i64::< a b) (i64::< a 0) (i64::< b 0)) ((union (Before a b) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (i64::>= a 0) (i64::< b 0)) ((union (Before a b) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (i64::< b a) (i64::>= a 0) (i64::>= b 0)) ((union (Before b a) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (i64::< b a) (i64::< a 0) (i64::< b 0)) ((union (Before b a) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (i64::< a 0) (i64::>= b 0)) ((union (Before b a) (Present))) :ruleset eval)
(rewrite (SInsert (SNil) x) (SCons x (SNil)) :ruleset eval)
(rewrite (SInsert (SCons x xs) x) (SCons x xs) :ruleset eval)
(rewrite (SInsert (SCons a xs) b) (SCons a (SInsert xs b)) :when ((= (Before a b) (Present))) :ruleset eval)
(rewrite (SInsert (SCons a xs) b) (SCons b (SCons a xs)) :when ((= (Before b a) (Present))) :ruleset eval)
(rewrite (SUnion a (SNil)) a :ruleset eval)
(rewrite (SUnion a (SCons x xs)) (SUnion (SInsert a x) xs) :ruleset eval)
(rewrite (SRemove (SNil) x) (SNil) :ruleset eval)
(rewrite (SRemove (SCons x xs) x) xs :ruleset eval)
(rewrite (SRemove (SCons a xs) b) (SCons a (SRemove xs b)) :when ((i64::!= a b)) :ruleset eval)
(rewrite (SLength (SNil)) (NVal 0) :ruleset eval)
(rewrite (SLength (SCons x xs)) (NAdd (NVal 1) (SLength xs)) :ruleset eval)
(rewrite (SGet (SCons x xs) 0) (NVal x) :ruleset eval)
(rewrite (SGet (SCons x xs) i) (SGet xs (i64::- i 1)) :when ((i64::> i 0)) :ruleset eval)
(datatype ISet (IS S))
(constructor ISetGet (ISet i64) N)
(constructor Stored (ISet i64) Fact)
(rule ((IS x)) ((SLength x) (SGet x 0)) :ruleset eval)
(rule ((IS x) (= (SLength x) (NVal n)) (i64::> n 0) (= (SGet x 0) (NVal v))) ((union (ISetGet (IS x) 0) (NVal v)) (union (Stored (IS x) 0) (Present))) :ruleset enumerate)
(rule ((= (Stored (IS x) j) (Present)) (= (SLength x) (NVal n)) (i64::< (i64::+ j 1) n)) ((SGet x (i64::+ j 1))) :ruleset eval)
(rule ((= (Stored (IS x) j) (Present)) (= (SLength x) (NVal n)) (i64::< (i64::+ j 1) n) (= (SGet x i) (NVal v)) (i64::== i (i64::+ j 1))) ((union (ISetGet (IS x) (i64::+ j 1)) (NVal v)) (union (Stored (IS x) (i64::+ j 1)) (Present))) :ruleset enumerate)
(let global_lhs0 (SInsert (SInsert (SNil) 1) 2))
(let global_rhs0 (SInsert (SInsert (SNil) 1) 2))
(run eval 32)
(check-eq global_lhs0 global_rhs0)
(let global_lhs1 (SInsert (SInsert (SNil) 1) 2))
(let global_rhs1 (SInsert (SInsert (SNil) 2) 1))
(run eval 32)
(check-eq global_lhs1 global_rhs1)
(let global_lhs2 (SUnion (SInsert (SInsert (SNil) 1) 2) (SInsert (SInsert (SNil) 3) 4)))
(let global_rhs2 (SInsert (SInsert (SInsert (SInsert (SNil) 1) 2) 3) 4))
(run eval 32)
(check-eq global_lhs2 global_rhs2)
(let global_lhs3 (NVal 0))
(let global_rhs3 (SLength (SNil)))
(run eval 32)
(check-eq global_lhs3 global_rhs3)
(let global_lhs4 (NVal 1))
(let global_rhs4 (SLength (SInsert (SInsert (SInsert (SNil) 1) 1) 1)))
(run eval 32)
(check-eq global_lhs4 global_rhs4)
(let global_lhs5 (NVal 2))
(let global_rhs5 (SLength (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 1) 1)))
(run eval 32)
(check-eq global_lhs5 global_rhs5)
(let global_lhs6 (NVal 1))
(let global_rhs6 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 0))
(run eval 32)
(check-eq global_lhs6 global_rhs6)
(let global_lhs7 (NVal 2))
(let global_rhs7 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 1))
(run eval 32)
(check-eq global_lhs7 global_rhs7)
(let global_lhs8 (NVal 4))
(let global_rhs8 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 2))
(run eval 32)
(check-eq global_lhs8 global_rhs8)
(let global_lhs9 (NVal -1))
(let global_rhs9 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 3))
(run eval 32)
(check-eq global_lhs9 global_rhs9)
(let global_lhs10 (SRemove (SInsert (SInsert (SInsert (SNil) 1) 2) 3) 3))
(let global_rhs10 (SInsert (SInsert (SNil) 1) 2))
(run eval 32)
(check-eq global_lhs10 global_rhs10)
(let global_myset (IS (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 2) 4) 1) 4) -1)))
(run eval 32)
