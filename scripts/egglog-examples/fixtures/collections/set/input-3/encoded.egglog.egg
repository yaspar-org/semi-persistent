; Adapted from egglog tests/web-demo/set.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(ruleset eval)

(datatype N (NVal i64))
(constructor NAdd (N N) N :cost 100)
(rewrite (NAdd (NVal a) (NVal b)) (NVal (+ a b)) :ruleset eval)


(ruleset enumerate)
(datatype S (SNil) (SCons i64 S))
(constructor SInsert (S i64) S :cost 100)
(constructor SUnion (S S) S :cost 100)
(constructor SRemove (S i64) S :cost 100)
(constructor SLength (S) N :cost 100)
(constructor SGet (S i64) N :cost 100)
(datatype Fact (Present) (Before i64 i64))
; Value order for i64 is its unsigned 64-bit representation.
(rule ((SInsert (SCons a tail) b) (< a b) (>= a 0) (>= b 0))
      ((union (Before a b) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (< a b) (< a 0) (< b 0))
      ((union (Before a b) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (>= a 0) (< b 0))
      ((union (Before a b) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (< b a) (>= a 0) (>= b 0))
      ((union (Before b a) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (< b a) (< a 0) (< b 0))
      ((union (Before b a) (Present))) :ruleset eval)
(rule ((SInsert (SCons a tail) b) (< a 0) (>= b 0))
      ((union (Before b a) (Present))) :ruleset eval)
(rewrite (SInsert (SNil) x) (SCons x (SNil)) :ruleset eval)
(rewrite (SInsert (SCons x xs) x) (SCons x xs) :ruleset eval)
(rewrite (SInsert (SCons a xs) b) (SCons a (SInsert xs b))
         :when ((= (Before a b) (Present))) :ruleset eval)
(rewrite (SInsert (SCons a xs) b) (SCons b (SCons a xs))
         :when ((= (Before b a) (Present))) :ruleset eval)
(rewrite (SUnion a (SNil)) a :ruleset eval)
(rewrite (SUnion a (SCons x xs)) (SUnion (SInsert a x) xs) :ruleset eval)
(rewrite (SRemove (SNil) x) (SNil) :ruleset eval)
(rewrite (SRemove (SCons x xs) x) xs :ruleset eval)
(rewrite (SRemove (SCons a xs) b) (SCons a (SRemove xs b))
         :when ((!= a b)) :ruleset eval)
(rewrite (SLength (SNil)) (NVal 0) :ruleset eval)
(rewrite (SLength (SCons x xs)) (NAdd (NVal 1) (SLength xs)) :ruleset eval)
(rewrite (SGet (SCons x xs) 0) (NVal x) :ruleset eval)
(rewrite (SGet (SCons x xs) i) (SGet xs (- i 1))
         :when ((> i 0)) :ruleset eval)
(datatype ISet (IS S))
(constructor ISetGet (ISet i64) N)
; Positive table row witnesses are separate from constructed lookup terms.
(constructor Stored (ISet i64) Fact)
(rule ((IS x)) ((SLength x) (SGet x 0)) :ruleset eval)
(rule ((IS x) (= (SLength x) (NVal n)) (> n 0) (= (SGet x 0) (NVal v)))
      ((union (ISetGet (IS x) 0) (NVal v))
       (union (Stored (IS x) 0) (Present))) :ruleset enumerate)
(rule ((= (Stored (IS x) j) (Present)) (= (SLength x) (NVal n))
       (< (+ j 1) n))
      ((SGet x (+ j 1))) :ruleset eval)
(rule ((= (Stored (IS x) j) (Present)) (= (SLength x) (NVal n))
       (< (+ j 1) n) (= (SGet x i) (NVal v)) (= i (+ j 1)))
      ((union (ISetGet (IS x) (+ j 1)) (NVal v))
       (union (Stored (IS x) (+ j 1)) (Present))) :ruleset enumerate)
(let $lhs34 (SInsert (SInsert (SNil) 1) 2))
(let $rhs34 (SInsert (SInsert (SNil) 1) 2))
(run eval 32)
(check (= $lhs34 $rhs34))
(let $lhs35 (SInsert (SInsert (SNil) 1) 2))
(let $rhs35 (SInsert (SInsert (SNil) 2) 1))
(run eval 32)
(check (= $lhs35 $rhs35))
(let $lhs36 (SUnion (SInsert (SInsert (SNil) 1) 2) (SInsert (SInsert (SNil) 3) 4)))
(let $rhs36 (SInsert (SInsert (SInsert (SInsert (SNil) 1) 2) 3) 4))
(run eval 32)
(check (= $lhs36 $rhs36))
(let $lhs37 (NVal 0))
(let $rhs37 (SLength (SNil)))
(run eval 32)
(check (= $lhs37 $rhs37))
(let $lhs38 (NVal 1))
(let $rhs38 (SLength (SInsert (SInsert (SInsert (SNil) 1) 1) 1)))
(run eval 32)
(check (= $lhs38 $rhs38))
(let $lhs39 (NVal 2))
(let $rhs39 (SLength (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 1) 1)))
(run eval 32)
(check (= $lhs39 $rhs39))
(let $lhs40 (NVal 1))
(let $rhs40 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 0))
(run eval 32)
(check (= $lhs40 $rhs40))
(let $lhs41 (NVal 2))
(let $rhs41 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 1))
(run eval 32)
(check (= $lhs41 $rhs41))
(let $lhs42 (NVal 4))
(let $rhs42 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 2))
(run eval 32)
(check (= $lhs42 $rhs42))
(let $lhs43 (NVal -1))
(let $rhs43 (SGet (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 1) -1) 2) 4) 1) 3))
(run eval 32)
(check (= $lhs43 $rhs43))
(let $lhs44 (SRemove (SInsert (SInsert (SInsert (SNil) 1) 2) 3) 3))
(let $rhs44 (SInsert (SInsert (SNil) 1) 2))
(run eval 32)
(check (= $lhs44 $rhs44))
(let $myset (IS (SInsert (SInsert (SInsert (SInsert (SInsert (SNil) 2) 4) 1) 4) -1)))
(run eval 32)
