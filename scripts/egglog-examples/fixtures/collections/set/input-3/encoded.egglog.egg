(let $lhs45 (NVal 1))
(let $rhs45 (ISetGet $myset 0))
(run eval 32)
(check (= $lhs45 $rhs45))
(let $lhs46 (NVal 2))
(let $rhs46 (ISetGet $myset 1))
(run eval 32)
(check (= $lhs46 $rhs46))
