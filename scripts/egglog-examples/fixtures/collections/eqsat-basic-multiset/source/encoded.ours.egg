(sort Math)
(sort Bag)
(constructor Num (i64) Math)
(constructor Var (String) Math)
(constructor Add (Math Math) Math)
(constructor Mul (Math Math) Math)
(constructor Product (Bag) Math)
(constructor Sum (Bag) Math)
(constructor Empty () Bag)
(constructor One (Math) Bag)
(constructor Join (Bag Bag) Bag)
(datatype N (NVal i64))
(constructor NAdd (N N) N :cost 100)
(constructor Length (Bag) N :cost 100)
(constructor Remove (Bag Math) Bag :cost 100)
(constructor Pick (Bag) Math :cost 100)
(datatype Fact (Present) (Contains Bag Math))
(constructor MapTmp (Bag Bag) Bag :cost 100)
(constructor tmp_fn (Bag Math) Math)
(rewrite (Join a b) (Join b a))
(rewrite (Join (Join a b) c) (Join a (Join b c)))
(rewrite (Join a (Empty)) a)
(rewrite (NAdd (NVal a) (NVal b)) (NVal (i64::+ a b)))
(rewrite (Length (Empty)) (NVal 0))
(rewrite (Length (One x)) (NVal 1))
(rewrite (Length (Join a b)) (NAdd (Length a) (Length b)))
(rule ((One x)) ((union (Contains (One x) x) (Present))))
(rule ((= (Contains a x) (Present)) (Join a b)) ((union (Contains (Join a b) x) (Present))))
(rewrite (Remove (One x) x) (Empty))
(rewrite (Remove (Join a b) x) (Join (Remove a x) b) :when ((= (Contains a x) (Present))))
(rewrite (Pick (One x)) x)
(rewrite (MapTmp a (Empty)) (Empty))
(rewrite (MapTmp a (One x)) (One (tmp_fn a x)))
(rewrite (MapTmp a (Join b c)) (Join (MapTmp a b) (MapTmp a c)))
(rewrite (tmp_fn xs x) (Product (Join xs (One x))))
(rewrite (Add a b) (Sum (Join (One a) (One b))))
(rewrite (Mul a b) (Product (Join (One a) (One b))))
(rule ((Sum xs)) ((Length xs)))
(rule ((Product xs)) ((Length xs)))
(rule ((= sum (Sum xs)) (= (Length xs) (NVal 0))) ((union sum (Num 0))))
(rule ((= sum (Sum xs)) (= (Length xs) (NVal 1))) ((union sum (Pick xs))))
(rule ((= product (Product xs)) (= (Length xs) (NVal 0))) ((union product (Num 1))))
(rule ((= product (Product xs)) (= (Length xs) (NVal 1))) ((union product (Pick xs))))
(rule ((= sum (Sum bc)) (= product (Product inner)) (= (Contains inner sum) (Present)) (= (Length inner) (NVal n)) (i64::> n 1)) ((Remove inner sum)))
(rule ((= sum (Sum bc)) (= product (Product inner)) (= (Contains inner sum) (Present)) (= (Length inner) (NVal n)) (i64::> n 1) (= removed (Remove inner sum))) ((union product (Sum (MapTmp removed bc)))))
(rule ((Sum xs) (= a (Num av)) (= (Contains xs a) (Present))) ((Remove xs a)))
(rule ((Product xs) (= a (Num av)) (= (Contains xs a) (Present))) ((Remove xs a)))
(rule ((= sum (Sum xs)) (= a (Num av)) (= (Contains xs a) (Present)) (= without (Remove xs a)) (= b (Num bv)) (= (Contains without b) (Present))) ((union sum (Sum (Join (Remove without b) (One (Num (i64::+ av bv))))))))
(rule ((= product (Product xs)) (= a (Num av)) (= (Contains xs a) (Present)) (= without (Remove xs a)) (= b (Num bv)) (= (Contains without b) (Present))) ((union product (Product (Join (Remove without b) (One (Num (i64::* av bv))))))))
(let global_expr1 (Mul (Num 2) (Add (Var "x") (Num 3))))
(let global_expr2 (Add (Num 6) (Mul (Num 2) (Var "x"))))
(run 100)
(check-eq global_expr1 global_expr2)
