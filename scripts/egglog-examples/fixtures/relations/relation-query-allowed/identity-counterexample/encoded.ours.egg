; Adapted from egglog tests/relation-query-allowed.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort Math)
(constructor Num (i64) Math)
(constructor myrel (i64) AuditTruth)
(constructor shouldappear () AuditTruth)
(constructor shouldnotappear () AuditTruth)
(union (myrel 1) (AuditPresent))
(union (myrel 2) (AuditPresent))
(rule ((= (myrel 1) (AuditPresent)) (= (myrel 1) (AuditPresent)) (= (myrel 1) (myrel 1))) ((union (shouldappear) (AuditPresent))))
(rule ((= (myrel 1) (AuditPresent)) (= (myrel 2) (AuditPresent)) (= (myrel 1) (myrel 2))) ((union (shouldnotappear) (AuditPresent))))
(run 1)
(check-eq (shouldappear) (AuditPresent))
(check-neq (shouldnotappear) (AuditPresent))
