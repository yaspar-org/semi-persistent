; Adapted from egglog tests/relation-query-allowed.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort Math)
(constructor Num (i64) Math)
(sort AuditRow_myrel)
(constructor myrel (i64) AuditRow_myrel)
(constructor AuditHolds_myrel (AuditRow_myrel) AuditTruth)
(sort AuditRow_shouldappear)
(constructor shouldappear () AuditRow_shouldappear)
(constructor AuditHolds_shouldappear (AuditRow_shouldappear) AuditTruth)
(sort AuditRow_shouldnotappear)
(constructor shouldnotappear () AuditRow_shouldnotappear)
(constructor AuditHolds_shouldnotappear (AuditRow_shouldnotappear) AuditTruth)
(union (AuditHolds_myrel (myrel 1)) (AuditPresent))
(union (AuditHolds_myrel (myrel 2)) (AuditPresent))
(rule ((= (AuditHolds_myrel (myrel 1)) (AuditPresent)) (= (AuditHolds_myrel (myrel 1)) (AuditPresent)) (= (myrel 1) (myrel 1))) ((union (AuditHolds_shouldappear (shouldappear)) (AuditPresent))))
(rule ((= (AuditHolds_myrel (myrel 1)) (AuditPresent)) (= (AuditHolds_myrel (myrel 2)) (AuditPresent)) (= (myrel 1) (myrel 2))) ((union (AuditHolds_shouldnotappear (shouldnotappear)) (AuditPresent))))
(run 1)
(check-eq (AuditHolds_shouldappear (shouldappear)) (AuditPresent))
(check-neq (AuditHolds_shouldnotappear (shouldnotappear)) (AuditPresent))
