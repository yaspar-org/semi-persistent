; Adapted from egglog tests/stratified.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort AuditRow_path)
(constructor path (i64 i64) AuditRow_path)
(constructor AuditHolds_path (AuditRow_path) AuditTruth)
(sort AuditRow_edge)
(constructor edge (i64 i64) AuditRow_edge)
(constructor AuditHolds_edge (AuditRow_edge) AuditTruth)
(rule ((= (AuditHolds_edge (edge x y)) (AuditPresent))) ((union (AuditHolds_path (path x y)) (AuditPresent))))
(union (AuditHolds_edge (edge 1 2)) (AuditPresent))
(union (AuditHolds_edge (edge 2 3)) (AuditPresent))
(union (AuditHolds_edge (edge 3 4)) (AuditPresent))
(check-eq (AuditHolds_edge (edge 1 2)) (AuditPresent))
(run 3)
(check-eq (AuditHolds_path (path 1 2)) (AuditPresent))
(ruleset path_rules)
(rule ((= (AuditHolds_path (path x y)) (AuditPresent)) (= (AuditHolds_edge (edge y z)) (AuditPresent))) ((union (AuditHolds_path (path x z)) (AuditPresent))) :ruleset path_rules)
(union (AuditHolds_edge (edge 3 8)) (AuditPresent))
(run path_rules 1)
(check-eq (AuditHolds_path (path 1 3)) (AuditPresent))
(check-neq (AuditHolds_path (path 1 4)) (AuditPresent))
(check-neq (AuditHolds_path (path 3 8)) (AuditPresent))
(run 1)
(check-eq (AuditHolds_path (path 3 8)) (AuditPresent))
(run path_rules 3)
(check-eq (AuditHolds_path (path 1 8)) (AuditPresent))
(check-neq (AuditHolds_path (path 8 1)) (AuditPresent))
