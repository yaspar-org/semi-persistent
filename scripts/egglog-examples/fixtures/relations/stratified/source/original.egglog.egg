; Adapted from egglog tests/stratified.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(relation path (i64 i64))
(relation edge (i64 i64))

(rule ((edge x y))
      ((path x y)))

(edge 1 2)
(edge 2 3)
(edge 3 4)
(check (edge 1 2))
(run 3)
(check (path 1 2))

(ruleset path-rules)

(rule ((path x y) (edge y z))
      ((path x z))
      :ruleset path-rules)

(edge 3 8)
(run path-rules 1)
(check (path 1 3))



