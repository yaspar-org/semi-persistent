; Adapted from egglog tests/web-demo/schedule-demo.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort AuditRow_left)
(constructor left (i64) AuditRow_left)
(constructor AuditHolds_left (AuditRow_left) AuditTruth)
(sort AuditRow_right)
(constructor right (i64) AuditRow_right)
(constructor AuditHolds_right (AuditRow_right) AuditTruth)
(union (AuditHolds_left (left 0)) (AuditPresent))
(union (AuditHolds_right (right 0)) (AuditPresent))
(ruleset step_left)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right x)) (AuditPresent))) ((union (AuditHolds_left (left (i64::+ x 1))) (AuditPresent))) :ruleset step_left)
(ruleset step_right)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right y)) (AuditPresent)) (i64::== x (i64::+ y 1))) ((union (AuditHolds_right (right x)) (AuditPresent))) :ruleset step_right)
(run step_right 2)
(run step_left 2)
(run step_right 2)
(run step_left 2)
(check-eq (AuditHolds_left (left 2)) (AuditPresent))
(check-eq (AuditHolds_right (right 1)) (AuditPresent))
(check-neq (AuditHolds_left (left 3)) (AuditPresent))
(check-neq (AuditHolds_right (right 2)) (AuditPresent))
