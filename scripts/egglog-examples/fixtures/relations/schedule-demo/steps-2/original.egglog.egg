; Adapted from egglog tests/web-demo/schedule-demo.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(relation left (i64))
(relation right (i64))
(left 0)
(right 0)
(ruleset step-left)
(rule ((left x) (right x)) ((left (+ x 1))) :ruleset step-left)
(ruleset step-right)
(rule ((left x) (right y) (= x (+ y 1))) ((right x)) :ruleset step-right)
(run-schedule (repeat 2 (saturate step-right) (saturate step-left)))
(check (left 2))
(check (right 1))
(fail (check (left 3)))
(fail (check (right 2)))
