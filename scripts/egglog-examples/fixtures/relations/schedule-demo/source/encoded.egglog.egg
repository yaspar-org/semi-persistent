; Adapted from egglog tests/web-demo/schedule-demo.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort AuditRow_left)
(constructor left (i64) AuditRow_left)
(constructor AuditHolds_left (AuditRow_left) AuditTruth)
(sort AuditRow_right)
(constructor right (i64) AuditRow_right)
(constructor AuditHolds_right (AuditRow_right) AuditTruth)
(union (AuditHolds_left (left 0)) (AuditPresent))
(union (AuditHolds_right (right 0)) (AuditPresent))
(ruleset step-left)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right x)) (AuditPresent))) ((union (AuditHolds_left (left (+ x 1))) (AuditPresent))) :ruleset step-left)
(ruleset step-right)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right y)) (AuditPresent)) (= x (+ y 1))) ((union (AuditHolds_right (right x)) (AuditPresent))) :ruleset step-right)
(run-schedule (repeat 10 (saturate step-right) (saturate step-left)))
(check (= (AuditHolds_left (left 10)) (AuditPresent)))
(check (= (AuditHolds_right (right 9)) (AuditPresent)))
(fail (check (= (AuditHolds_left (left 11)) (AuditPresent))))
(fail (check (= (AuditHolds_right (right 10)) (AuditPresent))))
