; Adapted from egglog tests/test-combined-steps.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort AuditRow_left)
(constructor left (i64) AuditRow_left)
(constructor AuditHolds_left (AuditRow_left) AuditTruth)
(sort AuditRow_right)
(constructor right (i64) AuditRow_right)
(constructor AuditHolds_right (AuditRow_right) AuditTruth)
(sort AuditRow_middle)
(constructor middle (i64) AuditRow_middle)
(constructor AuditHolds_middle (AuditRow_middle) AuditTruth)
(union (AuditHolds_left (left 0)) (AuditPresent))
(union (AuditHolds_right (right 0)) (AuditPresent))
(ruleset step-left)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right x)) (AuditPresent))) ((union (AuditHolds_left (left (+ x 1))) (AuditPresent))) :ruleset step-left)
(ruleset step-right)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right y)) (AuditPresent)) (= x (+ y 1))) ((union (AuditHolds_right (right x)) (AuditPresent))) :ruleset step-right)
(ruleset step-middle)
(rule ((= (AuditHolds_left (left x)) (AuditPresent))) ((union (AuditHolds_middle (middle x)) (AuditPresent))) :ruleset step-middle)
(unstable-combined-ruleset my-combination step-left step-right step-middle)
(run-schedule (repeat 1 step-left step-right step-middle))
(check (= (AuditHolds_left (left 1)) (AuditPresent)))
(check (= (AuditHolds_right (right 0)) (AuditPresent)))
(check (= (AuditHolds_middle (middle 0)) (AuditPresent)))
(fail (check (= (AuditHolds_left (left 2)) (AuditPresent))))
(fail (check (= (AuditHolds_right (right 1)) (AuditPresent))))
(fail (check (= (AuditHolds_middle (middle 1)) (AuditPresent))))
(fail (check (= (AuditHolds_middle (middle 2)) (AuditPresent))))
(run-schedule (repeat 9 (saturate step-right) my-combination (saturate step-right)))
(check (= (AuditHolds_left (left 10)) (AuditPresent)))
(check (= (AuditHolds_right (right 10)) (AuditPresent)))
(check (= (AuditHolds_middle (middle 9)) (AuditPresent)))
(fail (check (= (AuditHolds_middle (middle 10)) (AuditPresent))))
(fail (check (= (AuditHolds_left (left 11)) (AuditPresent))))
(fail (check (= (AuditHolds_right (right 11)) (AuditPresent))))
