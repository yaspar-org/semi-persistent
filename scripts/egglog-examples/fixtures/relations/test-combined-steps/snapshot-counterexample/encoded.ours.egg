; Adapted from egglog tests/test-combined-steps.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort AuditRow_left)
(constructor left (i64) AuditRow_left)
(constructor AuditHolds_left (AuditRow_left) AuditTruth)
(sort AuditRow_right)
(constructor right (i64) AuditRow_right)
(constructor AuditHolds_right (AuditRow_right) AuditTruth)
(sort AuditRow_middle)
(constructor middle (i64) AuditRow_middle)
(constructor AuditHolds_middle (AuditRow_middle) AuditTruth)
(union (AuditHolds_left (left 0)) (AuditPresent))
(union (AuditHolds_right (right 0)) (AuditPresent))
(ruleset step_left)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right x)) (AuditPresent))) ((union (AuditHolds_left (left (i64::+ x 1))) (AuditPresent))) :ruleset step_left)
(ruleset step_right)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right y)) (AuditPresent)) (i64::== x (i64::+ y 1))) ((union (AuditHolds_right (right x)) (AuditPresent))) :ruleset step_right)
(ruleset step_middle)
(rule ((= (AuditHolds_left (left x)) (AuditPresent))) ((union (AuditHolds_middle (middle x)) (AuditPresent))) :ruleset step_middle)
(ruleset my_combination)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right x)) (AuditPresent))) ((union (AuditHolds_left (left (i64::+ x 1))) (AuditPresent))) :ruleset my_combination)
(rule ((= (AuditHolds_left (left x)) (AuditPresent)) (= (AuditHolds_right (right y)) (AuditPresent)) (i64::== x (i64::+ y 1))) ((union (AuditHolds_right (right x)) (AuditPresent))) :ruleset my_combination)
(rule ((= (AuditHolds_left (left x)) (AuditPresent))) ((union (AuditHolds_middle (middle x)) (AuditPresent))) :ruleset my_combination)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(check-eq (AuditHolds_left (left 1)) (AuditPresent))
(check-eq (AuditHolds_right (right 0)) (AuditPresent))
(check-eq (AuditHolds_middle (middle 0)) (AuditPresent))
(check-neq (AuditHolds_left (left 2)) (AuditPresent))
(check-neq (AuditHolds_right (right 1)) (AuditPresent))
(check-neq (AuditHolds_middle (middle 1)) (AuditPresent))
(check-neq (AuditHolds_middle (middle 2)) (AuditPresent))
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(run step_right 2)
(run step_left 1)
(run step_right 1)
(run step_middle 1)
(run step_right 2)
(check-eq (AuditHolds_left (left 10)) (AuditPresent))
(check-eq (AuditHolds_right (right 10)) (AuditPresent))
(check-eq (AuditHolds_middle (middle 9)) (AuditPresent))
(check-neq (AuditHolds_middle (middle 10)) (AuditPresent))
(check-neq (AuditHolds_left (left 11)) (AuditPresent))
(check-neq (AuditHolds_right (right 11)) (AuditPresent))
