(relation left (i64))
(relation right (i64))
(relation middle (i64))
(left 0)
(right 0)
(ruleset step-left)
(rule ((left x) (right x)) ((left (+ x 1))) :ruleset step-left)
(ruleset step-right)
(rule ((left x) (right y) (= x (+ y 1))) ((right x)) :ruleset step-right)
(ruleset step-middle)
(rule ((left x)) ((middle x)) :ruleset step-middle)
(unstable-combined-ruleset my-combination step-left step-right step-middle)
(run-schedule (repeat 1 my-combination))
(check (left 1))
(check (right 0))
(check (middle 0))
(fail (check (left 2)))
(fail (check (right 1)))
(fail (check (middle 1)))
(fail (check (middle 2)))
(run-schedule (repeat 2 (saturate step-right) my-combination (saturate step-right)))
(check (left 3))
(check (right 3))
(check (middle 2))
(fail (check (middle 3)))
(fail (check (left 4)))
(fail (check (right 4)))
