; Adapted from egglog tests/test-combined.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(sort AuditRow_edge)
(constructor edge (i64 i64) AuditRow_edge)
(constructor AuditHolds_edge (AuditRow_edge) AuditTruth)
(sort AuditRow_path)
(constructor path (i64 i64) AuditRow_path)
(constructor AuditHolds_path (AuditRow_path) AuditTruth)
(ruleset myrules1)
(rule ((= (AuditHolds_edge (edge x y)) (AuditPresent))) ((union (AuditHolds_path (path x y)) (AuditPresent))) :ruleset myrules1)
(ruleset myrules2)
(rule ((= (AuditHolds_path (path x y)) (AuditPresent)) (= (AuditHolds_edge (edge y z)) (AuditPresent))) ((union (AuditHolds_path (path x z)) (AuditPresent))) :ruleset myrules2)
(ruleset myrules_combined)
(rule ((= (AuditHolds_edge (edge x y)) (AuditPresent))) ((union (AuditHolds_path (path x y)) (AuditPresent))) :ruleset myrules_combined)
(rule ((= (AuditHolds_path (path x y)) (AuditPresent)) (= (AuditHolds_edge (edge y z)) (AuditPresent))) ((union (AuditHolds_path (path x z)) (AuditPresent))) :ruleset myrules_combined)
(union (AuditHolds_edge (edge 0 1)) (AuditPresent))
(union (AuditHolds_edge (edge 1 2)) (AuditPresent))
(union (AuditHolds_edge (edge 2 3)) (AuditPresent))
(union (AuditHolds_edge (edge 2 4)) (AuditPresent))
(run myrules_combined 1)
(run myrules_combined 1)
(run myrules_combined 1)
(check-eq (AuditHolds_path (path 0 1)) (AuditPresent))
(check-eq (AuditHolds_path (path 0 2)) (AuditPresent))
(check-eq (AuditHolds_path (path 0 3)) (AuditPresent))
(check-eq (AuditHolds_path (path 0 4)) (AuditPresent))
(check-eq (AuditHolds_path (path 1 2)) (AuditPresent))
(check-eq (AuditHolds_path (path 1 3)) (AuditPresent))
(check-eq (AuditHolds_path (path 1 4)) (AuditPresent))
