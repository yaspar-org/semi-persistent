; Adapted from egglog tests/web-demo/points-to.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype AuditTruth (AuditPresent))
(datatype ClassT (Class String))
(datatype FieldT (Field String))
(datatype Stmt (New String ClassT) (Assign String String) (Store String FieldT String) (Load String String FieldT))
(sort AuditRow_VarPointsTo)
(constructor VarPointsTo (String ClassT) AuditRow_VarPointsTo)
(constructor AuditHolds_VarPointsTo (AuditRow_VarPointsTo) AuditTruth)
(sort AuditRow_HeapPointsTo)
(constructor HeapPointsTo (ClassT FieldT ClassT) AuditRow_HeapPointsTo)
(constructor AuditHolds_HeapPointsTo (AuditRow_HeapPointsTo) AuditTruth)
(rule ((= x (New a b))) ((union (AuditHolds_VarPointsTo (VarPointsTo a b)) (AuditPresent))))
(rule ((= x (Assign v1 v2)) (= (AuditHolds_VarPointsTo (VarPointsTo v2 c2)) (AuditPresent))) ((union (AuditHolds_VarPointsTo (VarPointsTo v1 c2)) (AuditPresent))))
(rule ((= x (Load v1 v2 f)) (= (AuditHolds_VarPointsTo (VarPointsTo v2 c1)) (AuditPresent)) (= (AuditHolds_HeapPointsTo (HeapPointsTo c1 f c2)) (AuditPresent))) ((union (AuditHolds_VarPointsTo (VarPointsTo v1 c2)) (AuditPresent))))
(rule ((= x (Store v1 f v2)) (= (AuditHolds_VarPointsTo (VarPointsTo v1 c1)) (AuditPresent)) (= (AuditHolds_VarPointsTo (VarPointsTo v2 c2)) (AuditPresent))) ((union (AuditHolds_HeapPointsTo (HeapPointsTo c1 f c2)) (AuditPresent))))
(let A (Class "A"))
(let B (Class "B"))
(let f (Field "f"))
(let l1 (New "o1" A))
(let l2 (New "o2" B))
(let l3 (Assign "o3" "o2"))
(let l4 (Store "o2" f "o1"))
(let l5 (Load "r" "o3" f))
(run 3)
(check-eq (AuditHolds_VarPointsTo (VarPointsTo "o1" A)) (AuditPresent))
(check-eq (AuditHolds_VarPointsTo (VarPointsTo "o2" B)) (AuditPresent))
(check-eq (AuditHolds_VarPointsTo (VarPointsTo "o3" B)) (AuditPresent))
(check-eq (AuditHolds_HeapPointsTo (HeapPointsTo B f A)) (AuditPresent))
(check-eq (AuditHolds_VarPointsTo (VarPointsTo "r" A)) (AuditPresent))
