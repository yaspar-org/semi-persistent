; Adapted from egglog tests/web-demo/points-to.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype ClassT (Class String))
(datatype FieldT (Field String))
(datatype Stmt (New String ClassT) (Assign String String) (Store String FieldT String) (Load String String FieldT))
(relation VarPointsTo (String ClassT))
(relation HeapPointsTo (ClassT FieldT ClassT))
(rule ((= x (New a b))) ((VarPointsTo a b)))
(rule ((= x (Assign v1 v2)) (VarPointsTo v2 c2)) ((VarPointsTo v1 c2)))
(rule ((= x (Load v1 v2 f)) (VarPointsTo v2 c1) (HeapPointsTo c1 f c2)) ((VarPointsTo v1 c2)))
(rule ((= x (Store v1 f v2)) (VarPointsTo v1 c1) (VarPointsTo v2 c2)) ((HeapPointsTo c1 f c2)))
(let $A (Class "A"))
(let $B (Class "B"))
(let $f (Field "f"))
(let $l1 (New "o1" $A))
(let $l2 (New "o2" $B))
(let $l3 (Assign "o3" "o2"))
(let $l4 (Store "o2" $f "o1"))
(let $l5 (Load "r" "o3" $f))
(run 3)
(check (VarPointsTo "o1" $A))
(check (VarPointsTo "o2" $B))
(check (VarPointsTo "o3" $B))
(check (HeapPointsTo $B $f $A))
(check (VarPointsTo "r" $A))
(fail (check (VarPointsTo "unknown" (Class "A"))))
(fail (check (HeapPointsTo (Class "A") (Field "f") (Class "B"))))
(push)
(New "o4" (Class "C"))
(Store "o2" (Field "f") "o4")
(Load "rg" "o2" (Field "g"))
(run 3)
(check (VarPointsTo "r" (Class "A")))
(check (VarPointsTo "r" (Class "C")))
(fail (check (VarPointsTo "rg" (Class "C"))))
(Assign "cycle1" "r")
(Assign "r" "cycle1")
(run 3)
(check (VarPointsTo "cycle1" (Class "A")))
(check (VarPointsTo "cycle1" (Class "C")))
(pop)
(fail (check (VarPointsTo "r" (Class "C"))))
(fail (check (VarPointsTo "cycle1" (Class "A"))))
(check (VarPointsTo "r" (Class "A")))
