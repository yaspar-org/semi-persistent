; Adapted from egglog (MIT); see LICENSE.egglog at corpus root.
(datatype TextVal (Text String) (Decimal i64) (Digits i64) (Digit i64)
 (Cat TextVal TextVal))
(rewrite (Cat (Text a) (Text b)) (Text (String::concat a b)))
(rewrite (Decimal x) (Digits x) :when ((i64::>= x 0)))
(rewrite (Decimal x) (Cat (Text "-") (Digits x)) :when ((i64::< x 0)))
(rewrite (Digits x) (Digit x) :when ((i64::>= x -9) (i64::<= x 9)))
(rewrite (Digits x) (Cat (Digits (i64::/ x 10)) (Digit (i64::% x 10))) :when ((i64::>= x 10)))
(rewrite (Digits x) (Cat (Digits (i64::/ x 10)) (Digit (i64::% x 10))) :when ((i64::<= x -10)))
(rewrite (Digit -9) (Text "9"))
(rewrite (Digit -8) (Text "8"))
(rewrite (Digit -7) (Text "7"))
(rewrite (Digit -6) (Text "6"))
(rewrite (Digit -5) (Text "5"))
(rewrite (Digit -4) (Text "4"))
(rewrite (Digit -3) (Text "3"))
(rewrite (Digit -2) (Text "2"))
(rewrite (Digit -1) (Text "1"))
(rewrite (Digit 0) (Text "0"))
(rewrite (Digit 1) (Text "1"))
(rewrite (Digit 2) (Text "2"))
(rewrite (Digit 3) (Text "3"))
(rewrite (Digit 4) (Text "4"))
(rewrite (Digit 5) (Text "5"))
(rewrite (Digit 6) (Text "6"))
(rewrite (Digit 7) (Text "7"))
(rewrite (Digit 8) (Text "8"))
(rewrite (Digit 9) (Text "9"))
(Decimal 20)
(run 200)
(check-eq (Decimal 20) (Text "20"))
(check-eq (Decimal 20) (Text "02"))
