(datatype Math (Add Math Math) (Num i64))
(datatype Flag (Clean) (Conflict))
(let zero (Num 0))
(rewrite (Add zero x) x)
(let a (Add (Num 0) (Num 3)))
(let b (Add (Num 7) (Num 9)))
(let c (Num 16))
(union b c)
(rule ((= r (Num x)) (= r (Num y)) (i64::!= x y)) ((union (Clean) (Conflict))))
(run 10)
(check-neq (Clean) (Conflict))

(check-eq a (Num 3))
(check-eq b (Num 16))
(check-neq b (Num 9))
(union (Num 1) (Num 2))
(run 1)
(check-neq (Clean) (Conflict))
