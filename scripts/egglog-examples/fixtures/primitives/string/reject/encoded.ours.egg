; Adapted from egglog (MIT); see LICENSE.egglog at corpus root.
(sort Chars)
(sort Answer)
(sort CountVal)
(constructor Empty () Chars)
(constructor Cons (String Chars) Chars)
(constructor Yes () Answer)
(constructor No () Answer)
(constructor N (i64) CountVal)
(constructor Prefix (Chars Chars) Answer)
(constructor Drop (Chars Chars) Chars)
(constructor Append (Chars Chars) Chars)
(constructor Count (Chars Chars) CountVal)
(constructor CountEmpty (Chars) CountVal)
(constructor CountChoice (Answer Chars Chars) CountVal)
(constructor Inc (CountVal) CountVal)
(constructor Replace (Chars Chars Chars) Chars)
(constructor ReplaceEmpty (Chars Chars) Chars)
(constructor ReplaceChoice (Answer Chars Chars Chars) Chars)
(rewrite (Prefix (Empty) s) (Yes))
(rewrite (Prefix (Cons x xs) (Empty)) (No))
(rewrite (Prefix (Cons x xs) (Cons y ys)) (Prefix xs ys) :when ((String::== x y)))
(rewrite (Prefix (Cons x xs) (Cons y ys)) (No) :when ((String::!= x y)))
(rewrite (Drop (Empty) s) s)
(rewrite (Drop (Cons x xs) (Cons y ys)) (Drop xs ys))
(rewrite (Append (Empty) s) s)
(rewrite (Append (Cons x xs) s) (Cons x (Append xs s)))
(rewrite (Inc (N n)) (N (i64::+ n 1)))
(rewrite (Count s (Empty)) (CountEmpty s))
(rewrite (CountEmpty (Empty)) (N 1))
(rewrite (CountEmpty (Cons x xs)) (Inc (CountEmpty xs)))
(rewrite (Count (Empty) (Cons x xs)) (N 0))
(rewrite (Count (Cons x xs) (Cons y ys)) (CountChoice (Prefix (Cons y ys) (Cons x xs)) (Cons x xs) (Cons y ys)))
(rewrite (CountChoice (Yes) s p) (Inc (Count (Drop p s) p)))
(rewrite (CountChoice (No) (Cons x xs) p) (Count xs p))
(rewrite (Replace s (Empty) r) (ReplaceEmpty s r))
(rewrite (ReplaceEmpty (Empty) r) r)
(rewrite (ReplaceEmpty (Cons x xs) r) (Append r (Cons x (ReplaceEmpty xs r))))
(rewrite (Replace (Empty) (Cons x xs) r) (Empty))
(rewrite (Replace (Cons x xs) (Cons y ys) r) (ReplaceChoice (Prefix (Cons y ys) (Cons x xs)) (Cons x xs) (Cons y ys) r))
(rewrite (ReplaceChoice (Yes) s p r) (Append r (Replace (Drop p s) p r)))
(rewrite (ReplaceChoice (No) (Cons x xs) p r) (Cons x (Replace xs p r)))
(Append (Cons "a" (Empty)) (Append (Cons "b" (Cons "c" (Empty))) (Append (Cons "d" (Cons "e" (Empty))) (Empty))))
(Cons "a" (Cons "b" (Cons "c" (Cons "d" (Cons "e" (Empty))))))
(run 1000)
(check-eq (Append (Cons "a" (Empty)) (Append (Cons "b" (Cons "c" (Empty))) (Append (Cons "d" (Cons "e" (Empty))) (Empty)))) (Cons "a" (Cons "b" (Cons "c" (Cons "d" (Cons "e" (Empty)))))))
(Count (Cons "a" (Cons "b" (Cons " " (Cons "a" (Cons "b" (Empty)))))) (Cons "a" (Cons "b" (Empty))))
(N 2)
(run 1000)
(check-eq (Count (Cons "a" (Cons "b" (Cons " " (Cons "a" (Cons "b" (Empty)))))) (Cons "a" (Cons "b" (Empty)))) (N 2))
(Replace (Cons "a" (Cons "b" (Cons " " (Cons "a" (Cons "b" (Empty)))))) (Cons "a" (Cons "b" (Empty))) (Cons "c" (Cons "d" (Empty))))
(Cons "c" (Cons "d" (Cons " " (Cons "c" (Cons "d" (Empty))))))
(run 1000)
(check-eq (Replace (Cons "a" (Cons "b" (Cons " " (Cons "a" (Cons "b" (Empty)))))) (Cons "a" (Cons "b" (Empty))) (Cons "c" (Cons "d" (Empty)))) (Cons "c" (Cons "d" (Cons " " (Cons "c" (Cons "d" (Empty)))))))
(Replace (Cons "a" (Cons "b" (Cons " " (Cons "a" (Cons "b" (Empty)))))) (Cons "a" (Cons "b" (Empty))) (Cons "c" (Cons "d" (Empty))))
(Cons "c" (Cons "d" (Cons " " (Cons "a" (Cons "b" (Empty))))))
(run 1000)
(check-eq (Replace (Cons "a" (Cons "b" (Cons " " (Cons "a" (Cons "b" (Empty)))))) (Cons "a" (Cons "b" (Empty))) (Cons "c" (Cons "d" (Empty)))) (Cons "c" (Cons "d" (Cons " " (Cons "a" (Cons "b" (Empty)))))))
