(datatype NVal (N i64))
(datatype Flag (Present))
(constructor F () NVal)
(constructor G () NVal)
(constructor Known (NVal) Flag)
(rule ((= x (N n))) ((union (Known x) (Present))))
(union (F) (N 0))
(run 1)
(check-eq (Known (F)) (Present))
(let x (F))
(check-neq (Known (G)) (Present))
