(check-eq (N 8) (SL (N 1) 3))

(N 1)
(SR (N 8) 3)
(run 1000)
(check-eq (N 1) (SR (N 8) 3))

(N 2)
(Mod (N 8) (N 3))
(run 1000)
(check-eq (N 2) (Mod (N 8) (N 3)))

(N 2)
(Div (N 8) (N 3))
(run 1000)
(check-eq (N 2) (Div (N 8) (N 3)))

(N -1)
(Not (N 0))
(run 1000)
(check-eq (N -1) (Not (N 0)))

(And (N -1) (N 255))
(N 255)
(run 1000)
(check-eq (And (N -1) (N 255)) (N 255))

(Or (N -8) (N 3))
(N -5)
(run 1000)
(check-eq (Or (N -8) (N 3)) (N -5))

(Xor (N -1) (N -8))
(N 7)
(run 1000)
(check-eq (Xor (N -1) (N -8)) (N 7))

(SR (N -7) 1)
(N -4)
(run 1000)
(check-eq (SR (N -7) 1) (N -4))

(SR (N -9223372036854775808) 63)
(N -1)
(run 1000)
(check-eq (SR (N -9223372036854775808) 63) (N -1))

(SL (N 1) 63)
(N -9223372036854775808)
(run 1000)
(check-eq (SL (N 1) 63) (N -9223372036854775808))

(SL (N 9223372036854775807) 1)
(N -2)
(run 1000)
(check-eq (SL (N 9223372036854775807) 1) (N -2))

(Not (N -9223372036854775808))
(N 9223372036854775807)
(run 1000)
(check-eq (Not (N -9223372036854775808)) (N 9223372036854775807))

(Mod (N -8) (N 3))
(N -2)
(run 1000)
(check-eq (Mod (N -8) (N 3)) (N -2))

(Div (N -8) (N 3))
(N -2)
(run 1000)
(check-eq (Div (N -8) (N 3)) (N -2))
