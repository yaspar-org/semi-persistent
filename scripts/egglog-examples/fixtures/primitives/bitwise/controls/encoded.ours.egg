; Adapted from egglog (MIT); see LICENSE.egglog at corpus root.
(datatype NVal (N i64) (Bits i64 NVal NVal i64)
 (Half NVal) (Combine NVal NVal) (SL NVal i64) (SR NVal i64)
 (And NVal NVal) (Or NVal NVal) (Xor NVal NVal) (Not NVal)
 (Div NVal NVal) (Mod NVal NVal))
(datatype Flag (Present))
(constructor Known (NVal) Flag)
(rule ((= x (N n))) ((union (Known x) (Present))))
(rewrite (Half (N x)) (N (i64::/ x 2)) :when ((i64::>= x 0)))
(rewrite (Half (N x)) (N (i64::+ (i64::/ x 2) (i64::% x 2))) :when ((i64::< x 0)))
(rewrite (Combine (N bit) (N tail)) (N (i64::+ (i64::* tail 2) bit)))
(rewrite (And a b) (Bits 0 a b 64))
(rewrite (Or a b) (Bits 1 a b 64))
(rewrite (Xor a b) (Bits 2 a b 64))
(rewrite (Not (N x)) (N (i64::- -1 x)))
(rewrite (Div (N x) (N y)) (N (i64::/ x y)))
(rewrite (Mod (N x) (N y)) (N (i64::% x y)))
(rewrite (SL (N x) 0) (N x))
(rewrite (SR a 0) a)
(rewrite (SL (N x) k) (SL (N (i64::wrapping_add x x)) (i64::- k 1)) :when ((i64::> k 0) (i64::< k 64)))
(rewrite (SR a k) (SR (Half a) (i64::- k 1)) :when ((i64::> k 0) (i64::< k 64)))

(rewrite (Bits 0 (N x) (N y) 1) (N (i64::- 0 (i64::* (i64::% (i64::+ (i64::% x 2) 2) 2) (i64::% (i64::+ (i64::% y 2) 2) 2)))))
(rewrite (Bits 0 (N x) (N y) k)
 (Combine (N (i64::* (i64::% (i64::+ (i64::% x 2) 2) 2) (i64::% (i64::+ (i64::% y 2) 2) 2))) (Bits 0 (Half (N x)) (Half (N y)) (i64::- k 1)))
 :when ((i64::> k 1)))

(rewrite (Bits 1 (N x) (N y) 1) (N (i64::- 0 (i64::min (i64::+ (i64::% (i64::+ (i64::% x 2) 2) 2) (i64::% (i64::+ (i64::% y 2) 2) 2)) 1))))
(rewrite (Bits 1 (N x) (N y) k)
 (Combine (N (i64::min (i64::+ (i64::% (i64::+ (i64::% x 2) 2) 2) (i64::% (i64::+ (i64::% y 2) 2) 2)) 1)) (Bits 1 (Half (N x)) (Half (N y)) (i64::- k 1)))
 :when ((i64::> k 1)))

(rewrite (Bits 2 (N x) (N y) 1) (N (i64::- 0 (i64::% (i64::+ (i64::% (i64::+ (i64::% x 2) 2) 2) (i64::% (i64::+ (i64::% y 2) 2) 2)) 2))))
(rewrite (Bits 2 (N x) (N y) k)
 (Combine (N (i64::% (i64::+ (i64::% (i64::+ (i64::% x 2) 2) 2) (i64::% (i64::+ (i64::% y 2) 2) 2)) 2)) (Bits 2 (Half (N x)) (Half (N y)) (i64::- k 1)))
 :when ((i64::> k 1)))

(N 0)
(And (N 10) (N 0))
(run 1000)
(check-eq (N 0) (And (N 10) (N 0)))

(N 8)
(And (N 8) (N 10))
(run 1000)
(check-eq (N 8) (And (N 8) (N 10)))

(N 10)
(Or (N 8) (N 10))
(run 1000)
(check-eq (N 10) (Or (N 8) (N 10)))

(N 2)
(Xor (N 8) (N 10))
(run 1000)
(check-eq (N 2) (Xor (N 8) (N 10)))

