;; fib, boxed, ours; generated by generate.py
(datatype Flag (Present) (Clean) (Conflict))
(datatype Scalar (Box i64))
(ruleset compute)
(ruleset validate)
(constructor Fib (i64) Scalar)
(constructor KnownFib (i64) Flag)
(rule ((= result1 (Fib key0)) (= result1 (Box value))) ((union (KnownFib key0) (Present))) :ruleset validate)
(rule ((= result2 (Fib key0)) (= result2 (Box leftValue)) (= result3 (Fib key0)) (= result3 (Box rightValue)) (i64::!= leftValue rightValue)) ((union (Clean) (Conflict))) :ruleset validate)
(rule ((= result4 (Fib x)) (= result4 (Box f0)) (= result5 (Fib y)) (= result5 (Box f1)) (i64::< x 9223372036854775807) (i64::== y (i64::+ x 1))) ((union (Fib (i64::+ x 2)) (Box (i64::+ f0 f1)))) :ruleset compute)
(union (Fib 0) (Box 0))
(union (Fib 1) (Box 1))
(run validate 1)
(check-neq (Clean) (Conflict))
(run compute 5)
(print-stats)
(run validate 1)
(check-neq (Clean) (Conflict))
(check-eq (Fib 0) (Box 0))
(check-eq (Fib 1) (Box 1))
(check-eq (Fib 2) (Box 1))
(check-eq (Fib 3) (Box 2))
(check-eq (Fib 4) (Box 3))
(check-eq (Fib 5) (Box 5))
(check-eq (Fib 6) (Box 8))
(check-neq (KnownFib 7) (Present))
