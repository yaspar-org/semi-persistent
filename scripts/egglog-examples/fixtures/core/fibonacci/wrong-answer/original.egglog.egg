;; fib, original, egglog; generated by generate.py
(function fib (i64) i64 :no-merge)
(rule ((= f0 (fib x)) (= f1 (fib (+ x 1)))) ((set (fib (+ x 2)) (+ f0 f1))))
(set (fib 0) 0)
(set (fib 1) 1)
(run 3)
(check (= (fib 0) 0))
(check (= (fib 1) 1))
(check (= (fib 2) 1))
(check (= (fib 3) 2))
(check (= (fib 4) 3))
(fail (check (= (fib 5) anyValue)))
(check (= (fib 3) 999))
