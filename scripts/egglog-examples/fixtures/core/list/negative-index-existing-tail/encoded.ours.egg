;; list, boxed, ours; generated by generate.py
(datatype Flag (Present) (Clean) (Conflict))
(datatype Scalar (Box i64))
(datatype List (Nil) (Cons i64 List))
(ruleset compute)
(ruleset validate)
(constructor Length (List) Scalar)
(constructor KnownLength (List) Flag)
(rule ((= result1 (Length key0)) (= result1 (Box value))) ((union (KnownLength key0) (Present))) :ruleset validate)
(rule ((= result2 (Length key0)) (= result2 (Box leftValue)) (= result3 (Length key0)) (= result3 (Box rightValue)) (i64::!= leftValue rightValue)) ((union (Clean) (Conflict))) :ruleset validate)
(constructor Get (List i64) Scalar)
(constructor KnownGet (List i64) Flag)
(rule ((= result4 (Get key0 key1)) (= result4 (Box value))) ((union (KnownGet key0 key1) (Present))) :ruleset validate)
(rule ((= result5 (Get key0 key1)) (= result5 (Box leftValue)) (= result6 (Get key0 key1)) (= result6 (Box rightValue)) (i64::!= leftValue rightValue)) ((union (Clean) (Conflict))) :ruleset validate)
(constructor LengthDemand (List) Flag)
(constructor GetDemand (List i64) Flag)
(constructor Append (List List) List)
(constructor Set (List i64 i64) List)
(rule ((= fact7 (LengthDemand (Nil))) (= fact7 (Present))) ((union (Length (Nil)) (Box 0))) :ruleset compute)
(rule ((= fact8 (LengthDemand (Cons head tail))) (= fact8 (Present))) ((union (LengthDemand tail) (Present))) :ruleset compute)
(rule ((= fact9 (LengthDemand (Cons head tail))) (= fact9 (Present)) (= result10 (Length tail)) (= result10 (Box tailLength))) ((union (Length (Cons head tail)) (Box (i64::+ tailLength 1)))) :ruleset compute)
(rule ((= fact11 (GetDemand (Cons head tail) 0)) (= fact11 (Present))) ((union (Get (Cons head tail) 0) (Box head))) :ruleset compute)
(rule ((= fact12 (GetDemand (Cons head tail) n)) (= fact12 (Present)) (i64::> n 0)) ((union (GetDemand tail (i64::- n 1)) (Present))) :ruleset compute)
(rule ((= fact13 (GetDemand (Cons head tail) n)) (= fact13 (Present)) (= result14 (Get tail previous)) (= result14 (Box item)) (i64::> n -9223372036854775808) (i64::== previous (i64::- n 1))) ((union (Get (Cons head tail) n) (Box item))) :ruleset compute)
(rewrite (Append (Nil) xs) xs :ruleset compute)
(rewrite (Append (Cons head tail) xs) (Cons head (Append tail xs)) :ruleset compute)
(rewrite (Set (Cons head tail) 0 item) (Cons item tail) :ruleset compute)
(rewrite (Set (Cons head tail) i item) (Cons head (Set tail (i64::- i 1) item)) :when ((i64::> i 0)) :ruleset compute)
(let inputA (Cons 7 (Nil)))
(union (Get (Nil) -2) (Box 42))
(union (GetDemand inputA -1) (Present))
(run validate 1)
(check-neq (Clean) (Conflict))
(run compute 10000)
(print-stats)
(run validate 1)
(check-neq (Clean) (Conflict))
(check-eq (Get inputA -1) (Box 42))
