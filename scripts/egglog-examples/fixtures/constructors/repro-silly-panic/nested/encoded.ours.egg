; Adapted from egglog (MIT); see LICENSE.egglog at corpus root.
(datatype KAT
    (par KAT KAT)
)
(constructor AConst () KAT)
(let audit_A (AConst))

(rewrite (par p p) p)
(rule ((= r (par q r)) (= q (par q r))) ((union r q)))

; tests
(let audit_q (par audit_A audit_A))
(run 10)
(let audit_n (par audit_q (par audit_A audit_A)))
(run 10)
(check-eq audit_n audit_A)
