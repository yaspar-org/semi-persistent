; Adapted from egglog tests/cykjson.egg at 593df10e1465904e8b7a3dc85d8ef3976842b509 (MIT); see LICENSE.egglog at corpus root.
(datatype tree (NT String tree tree)
                  (T String String))

(function getString (i64) String :no-merge)

(relation Prod (String String String))
(relation End (String String))


(relation P (i64 i64 String))
(function B (i64 i64 String) tree :no-merge)

(rule ((End a s)
       (= s (getString pos)))
      ((P 1 pos a)
       (set (B 1 pos a) (T a s)))) 

(rule ((Prod a b c) ;; a -> bc
       (P p1 s b)
       (P p2 (+ s p1) c))
      ((P (+ p1 p2) s a)))


(rule ((Prod a b c)
       (= f1 (B p1 s b))
       (= f2 (B p2 (+ s p1) c)))
      ((set (B (+ p1 p2) s a) 
       (NT a f1 f2))))



(Prod "VAL" "H0" "H1")
(Prod "VAL" "H2" "H1")
(Prod "VAL" "H3" "H4")
(Prod "VAL" "H5" "H4")
(Prod "MEM" "H6" "MEM")
(Prod "MEM" "H7" "VAL")
(Prod "PR" "H7" "VAL")
(Prod "ELM" "H8" "ELM")
(Prod "ELM" "H0" "H1")
(Prod "ELM" "H2" "H1")
(Prod "ELM" "H3" "H4")
(Prod "ELM" "H5" "H4")
(Prod "H2" "H0" "MEM")
(Prod "H5" "H3" "ELM")
(Prod "H6" "PR" "H9")
(Prod "H7" "H10" "H11")
(Prod "H8" "VAL" "H9")
(End "VAL" "str")
(End "VAL" "num")
(End "VAL" "true")
(End "VAL" "false")
(End "VAL" "null")
(End "ELM" "str")
(End "ELM" "num")
(End "ELM" "true")
(End "ELM" "false")
(End "ELM" "null")
(End "H0" "{")
(End "H1" "}")
(End "H3" "[")
(End "H4" "]")
(End "H9" ",")
(End "H10" "str")
(End "H11" ":")
(set (getString 1) "[")
(set (getString 2) "num")
(set (getString 3) ",")
(set (getString 4) "num")
(set (getString 5) ",")
(set (getString 6) "num")
(set (getString 7) ",")
(set (getString 8) "num")
(set (getString 9) "]")
(run 10000)
(let $root (B 9 1 "VAL"))
(check (P 9 1 "VAL"))
(check (P 1 1 "H3"))
(check (P 1 2 "ELM"))
(check (P 1 2 "VAL"))
(check (P 1 3 "H9"))
(check (P 1 4 "ELM"))
(check (P 1 4 "VAL"))
(check (P 1 5 "H9"))
(check (P 1 6 "ELM"))
(check (P 1 6 "VAL"))
(check (P 1 7 "H9"))
(check (P 1 8 "ELM"))
(check (P 1 8 "VAL"))
(check (P 1 9 "H4"))
(check (P 2 1 "H5"))
(check (P 2 2 "H8"))
(check (P 2 4 "H8"))
(check (P 2 6 "H8"))
(check (P 3 2 "ELM"))
(check (P 3 4 "ELM"))
(check (P 3 6 "ELM"))
(check (P 4 1 "H5"))
(check (P 5 2 "ELM"))
(check (P 5 4 "ELM"))
(check (P 6 1 "H5"))
(check (P 7 2 "ELM"))
(check (P 8 1 "H5"))
(check (P 9 1 "ELM"))
(check (P 9 1 "VAL"))
(fail (check (P 1 0 "ELM")))
(fail (check (P 1 0 "PR")))
(fail (check (P 1 1 "MEM")))
(fail (check (P 1 2 "H9")))
(fail (check (P 1 4 "H9")))
(fail (check (P 1 9 "H9")))
(fail (check (P 1 10 "H7")))
