(datatype tree (NT String tree tree) (T String String))
(datatype Fact (Present))
(constructor Prod (String String String) Fact)
(constructor End (String String) Fact)
(constructor Tok (i64 String) Fact)
(constructor P (i64 i64 String) Fact)
(constructor B (i64 i64 String tree) Fact)
(constructor HasB (i64 i64 String) Fact)
(constructor Pair (tree tree) Fact)
(constructor Different (tree tree) Fact)
(constructor Conflict () Fact)
(ruleset compute)
(ruleset validate)
(rule ((= w0 (End a s)) (= w0 (Present)) (= w1 (Tok pos s)) (= w1 (Present))) ((union (P pos (i64::+ pos 1) a) (Present)) (union (B pos (i64::+ pos 1) a (T a s)) (Present))) :ruleset compute)
(rule ((= w0 (Prod a b c)) (= w0 (Present)) (= w1 (P start mid b)) (= w1 (Present)) (= w2 (P mid end c)) (= w2 (Present))) ((union (P start end a) (Present))) :ruleset compute)
(rule ((= w0 (Prod a b c)) (= w0 (Present)) (= w1 (B start mid b t1)) (= w1 (Present)) (= w2 (B mid end c t2)) (= w2 (Present))) ((union (B start end a (NT a t1 t2)) (Present))) :ruleset compute)
(rule ((= w0 (B p s a t)) (= w0 (Present))) ((union (HasB p s a) (Present))) :ruleset validate)
(rule ((= w0 (Tok pos s)) (= w0 (Present)) (= w1 (Tok pos t)) (= w1 (Present)) (String::!= s t)) ((union (Conflict) (Present))) :ruleset validate)
(rule ((= w0 (B p s a x)) (= w0 (Present)) (= w1 (B p s a y)) (= w1 (Present))) ((union (Pair x y) (Present))) :ruleset validate)
(rule ((= w0 (Pair (T a s) (T b t))) (= w0 (Present)) (String::!= a b)) ((union (Different (T a s) (T b t)) (Present))) :ruleset validate)
(rule ((= w0 (Pair (T a s) (T b t))) (= w0 (Present)) (String::!= s t)) ((union (Different (T a s) (T b t)) (Present))) :ruleset validate)
(rule ((= w0 (Pair (T a s) (NT b x y))) (= w0 (Present))) ((union (Different (T a s) (NT b x y)) (Present))) :ruleset validate)
(rule ((= w0 (Pair (NT a x y) (T b s))) (= w0 (Present))) ((union (Different (NT a x y) (T b s)) (Present))) :ruleset validate)
(rule ((= w0 (Pair (NT a x y) (NT b u v))) (= w0 (Present)) (String::!= a b)) ((union (Different (NT a x y) (NT b u v)) (Present))) :ruleset validate)
(rule ((= w0 (Pair (NT a x y) (NT b u v))) (= w0 (Present))) ((union (Pair x u) (Present)) (union (Pair y v) (Present))) :ruleset validate)
(rule ((= w0 (Pair (NT a x y) (NT b u v))) (= w0 (Present)) (= w1 (Different x u)) (= w1 (Present))) ((union (Different (NT a x y) (NT b u v)) (Present))) :ruleset validate)
(rule ((= w0 (Pair (NT a x y) (NT b u v))) (= w0 (Present)) (= w1 (Different y v)) (= w1 (Present))) ((union (Different (NT a x y) (NT b u v)) (Present))) :ruleset validate)
(rule ((= w0 (B p s a x)) (= w0 (Present)) (= w1 (B p s a y)) (= w1 (Present)) (= w2 (Different x y)) (= w2 (Present))) ((union (Conflict) (Present))) :ruleset validate)
