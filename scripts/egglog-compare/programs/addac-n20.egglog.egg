;; add-ac width-scaling sweep, n = 20.  Generated by gen-addac-sweep.py.
;; Generalises the `add-ac` ruleset block of egglog tests/web-demo/math.egg (7b1adf2,
;; lines 138-160) from its fixed seven-term sum to sum width n, keeping both the
;; right-nested input and the fully reversed goal term of the original block.
;; See addac-sweep.md.

(datatype Math
    (Add Math Math)
    (Const f64))

(ruleset add-ac)
(rewrite (Add a b) (Add b a) :ruleset add-ac)
(rewrite (Add a (Add b c)) (Add (Add a b) c) :ruleset add-ac)
;; Add one through 20, right-nested
(let $res
  (Add (Const 1.0)
     (Add (Const 2.0)
          (Add (Const 3.0)
               (Add (Const 4.0)
                    (Add (Const 5.0)
                         (Add (Const 6.0)
                              (Add (Const 7.0)
                                   (Add (Const 8.0)
                                        (Add (Const 9.0)
                                             (Add (Const 10.0)
                                                  (Add (Const 11.0)
                                                       (Add (Const 12.0)
                                                            (Add (Const 13.0)
                                                                 (Add (Const 14.0)
                                                                      (Add (Const 15.0)
                                                                           (Add (Const 16.0)
                                                                                (Add (Const 17.0)
                                                                                     (Add (Const 18.0)
                                                                                          (Add (Const 19.0)
                                                                                               (Const 20.0)))))))))))))))))))))
;; The goal term, 20 down to one, bound rather than left inline: our `check` and our
;; `:until` build their terms, egglog's query them, so binding it here is what makes the
;; three programs start from the same e-graph.  See addac-sweep.md.
(let $goal
  (Add (Const 20.0)
     (Add (Const 19.0)
          (Add (Const 18.0)
               (Add (Const 17.0)
                    (Add (Const 16.0)
                         (Add (Const 15.0)
                              (Add (Const 14.0)
                                   (Add (Const 13.0)
                                        (Add (Const 12.0)
                                             (Add (Const 11.0)
                                                  (Add (Const 10.0)
                                                       (Add (Const 9.0)
                                                            (Add (Const 8.0)
                                                                 (Add (Const 7.0)
                                                                      (Add (Const 6.0)
                                                                           (Add (Const 5.0)
                                                                                (Add (Const 4.0)
                                                                                     (Add (Const 3.0)
                                                                                          (Add (Const 2.0)
                                                                                               (Const 1.0)))))))))))))))))))))
(run add-ac 50 :until (= $res $goal))
(check (= $res $goal))
(print-size)
(print-stats)
(print-stats :file "addac-n20.egglog.stats.json")
