;; EXPECT: ok
;; EVAL: both
;; Sequence patterns match ordered contiguous windows.

(sort E)
(function a () E)
(function b () E)
(function c () E)
(function d () E)

;; ANCHOR: sequence-ends
(function Front (E) E :assoc)
(function Back (E) E :assoc)
(function First (E) E)
(function Last (E) E)

(rewrite (Front x ..rest) (First x))
(rewrite (Back ..rest x) (Last x))

(let front (Front a b c))
(let back (Back a b c))
(run 1)

(check-eq front (First a))
(check-eq back (Last c))
(check-neq front (First b))
(check-neq back (Last a))
;; ANCHOR_END: sequence-ends

;; ANCHOR: sequence-window
(function Window (E) E :assoc)
(function Adjacent (E E) E)
(rewrite (Window ..prefix x y ..suffix) (Adjacent x y))

(let window (Window a b c d))
(run 1)

(check-eq window (Adjacent a b))
(check-eq window (Adjacent b c))
(check-eq window (Adjacent c d))
(check-neq window (Adjacent a c))
;; ANCHOR_END: sequence-window

;; Exact patterns account for the complete sequence.
(function Exact (E) E :assoc)
(function PairOnly () E)
(rewrite (Exact x y) (PairOnly))

(let exact_pair (Exact a b))
(let exact_triple (Exact a b c))
(run 1)
(check-eq exact_pair (PairOnly))
(check-neq exact_triple (PairOnly))

;; Repeated variables constrain adjacent positions.
(function Repeated (E) E :assoc)
(function HasRun () E)
(rewrite (Repeated ..prefix x x ..suffix) (HasRun))

(let adjacent_repeat (Repeated a a b))
(let separated_repeat (Repeated a b a))
(run 1)
(check-eq adjacent_repeat (HasRun))
(check-neq separated_repeat (HasRun))

;; Construction flattens nested applications before matching.
;; ANCHOR: construction-flattens
(function Flat (E) E :assoc)
(function Spans (E E) E)
(rewrite (Flat ..prefix x y ..suffix) (Spans x y))

(let flat (Flat (Flat a b) (Flat c d)))
(run 1)
(check-eq flat (Flat a b c d))
(check-eq flat (Spans b c))
;; ANCHOR_END: construction-flattens
