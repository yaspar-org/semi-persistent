;; EXPECT: ok
(set-option :completion eager)
;; ANCHOR: completion-example
(sort E)
(function add (E) E :assoc :comm)
(function a () E)
(function b () E)
(function c () E)
(function d () E)
(function n () E)

(union (add a b) c)
(union (add a b d) n)

(function f (E) E)
(check-eq (f (add a b)) (f c))

;; Eager completion has retained the substituted sum.
(print-size)
(check-eq n (add c d))
;; ANCHOR_END: completion-example
