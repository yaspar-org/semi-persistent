;; EXPECT: ok
;; EVAL: both
;; Book chapter 7: nested scopes, restoration, shrinking, and global names.

;; ANCHOR: push-pop
(sort E)
(function a () E)
(function b () E)
(function f (E) E)
(function g (E) E)

(let left (f (a)))
(let right (f (b)))
(print-size)

(push)
(union (a) (b))
(prove (= left right))

(push)
(let nested (g left))
(print-size)
(pop)

;; The inner pop keeps the equality from the outer scope.
(prove (= left right))
(pop)

(prove (!= left right))
(print-size)
;; ANCHOR_END: push-pop

;; ANCHOR: push-shrink
(push :shrink)
(prove (!= left right))
(pop)
;; ANCHOR_END: push-shrink

;; ANCHOR: shadowed-global
(let chosen (a))
(push)
(let chosen (b))
(prove (= chosen (b)))
(pop)
(prove (= chosen (a)))
;; ANCHOR_END: shadowed-global
