;; EXPECT: ok
;; TYPES: machine,bignum
;; Book chapter 3: literal tokens classified by their expected argument sorts.

;; ANCHOR: literals
(sort Expr)
(constructor Lit (bool) Expr)
(constructor Big (IBig) Expr)
(constructor Machine (i64) Expr)
(constructor Real (f64) Expr)
(constructor Text (String) Expr)

(let truth (Lit true))
(let big (Big 42))
(let machine (Machine 42))
(let real (Real 3.5))
(let text (Text "Semper"))

(check (= truth (Lit true)))
(check (= big (Big 42)))
(check (= machine (Machine 42)))
(check (= real (Real 3.5)))
(check (= text (Text "Semper")))
(check (!= big machine))
;; ANCHOR_END: literals
