;; EXPECT: ok
;; ANCHOR: directional-flattening
(sort E)
(function a () E)
(function b () E)
(function c () E)

(function L (E) E :assoc-left)
(prove (= (L (L a b) c) (L a b c)))
(prove (!= (L a (L b c)) (L a b c)))

(function R (E) E :assoc-right)
(prove (= (R a (R b c)) (R a b c)))
(prove (!= (R (R a b) c) (R a b c)))

(function A (E) E :assoc)
(prove (= (A (A a b) c) (A a b c)))
(prove (= (A a (A b c)) (A a b c)))
(prove (!= (A a b c) (A c b a)))
;; ANCHOR_END: directional-flattening
