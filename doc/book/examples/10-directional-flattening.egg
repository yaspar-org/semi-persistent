;; EXPECT: ok
;; ANCHOR: directional-flattening
(sort E)
(function a () E)
(function b () E)
(function c () E)

(function L (E) E :assoc-left)
(check (= (L (L a b) c) (L a b c)))
(check (!= (L a (L b c)) (L a b c)))

(function R (E) E :assoc-right)
(check (= (R a (R b c)) (R a b c)))
(check (!= (R (R a b) c) (R a b c)))

(function A (E) E :assoc)
(check (= (A (A a b) c) (A a b c)))
(check (= (A a (A b c)) (A a b c)))
(check (!= (A a b c) (A c b a)))
;; ANCHOR_END: directional-flattening
