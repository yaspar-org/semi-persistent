;; EXPECT: ok
;; ANCHOR: directional-flattening
(sort E)
(function a () E)
(function b () E)
(function c () E)

(function L (E) E :assoc-left)
(check-eq (L (L a b) c) (L a b c))
(check-neq (L a (L b c)) (L a b c))

(function R (E) E :assoc-right)
(check-eq (R a (R b c)) (R a b c))
(check-neq (R (R a b) c) (R a b c))

(function A (E) E :assoc)
(check-eq (A (A a b) c) (A a b c))
(check-eq (A a (A b c)) (A a b c))
(check-neq (A a b c) (A c b a))
;; ANCHOR_END: directional-flattening
