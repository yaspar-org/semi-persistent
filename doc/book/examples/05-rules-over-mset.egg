;; EXPECT: ok
;; EVAL: both
;; Multiset patterns bind complete child multiplicities.

(sort E)
(function zero () E)
(function a () E)
(function b () E)
(function c () E)
(function g () E)

;; ANCHOR: multiset-remainder
(function Add (E) E :assoc-comm :identity zero)
(function Selected (E E) E)

(rewrite (Add x:count>=2 ..rest)
         (Selected x (Add ..rest)))

(let sum (Add a a a b b))
(run 1)

(check (= sum (Selected a (Add b b))))
(check (= sum (Selected b (Add a a a))))
;; ANCHOR_END: multiset-remainder

;; ANCHOR: multiplicity-patterns
(function Mul (E) E :assoc-comm)
(function Twice (E) E)
(rewrite (Mul x:2 ..rest) (Twice x))

(let exact (Mul a a b))
(run 1)
(check (= exact (Twice a)))
(check (!= exact (Twice b)))

(function Sum (E) E :assoc-comm)
(function Balanced () E)
(rewrite (Sum x:count y:count ..rest) (Balanced))

(let balanced (Sum c c g g))
(let unbalanced (Sum c c c g g))
(run 1)
(check (= balanced (Balanced)))
(check (!= unbalanced (Balanced)))
;; ANCHOR_END: multiplicity-patterns

;; Identity removal and multiplicity preservation are independent.
(check (!= (Add a a) a))
(check (= (Add a zero) a))
