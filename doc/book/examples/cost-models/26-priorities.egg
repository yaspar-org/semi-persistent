;; ANCHOR: priorities
(sort E)
(function V (String) E)
(function F (E) E)
(function Add (E E) E)
(function Twice (E) E)
(rewrite (Twice x) (Add x x))

(let e (Twice (F (F (V "a")))))
(run 1)

(cost-model classes-then-adds :asp "26-priorities.lp")
(extract e :cost classes-then-adds :solver (asp "clingo"))
;; ANCHOR_END: priorities
