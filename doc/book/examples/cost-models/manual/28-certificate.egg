;; Needs RoundingSat, so the book test does not run it. Run from this directory:
;; semi-persistent 28-certificate.egg --types machine
;; ANCHOR: certificate
(sort IntervalSort)
(function Interval (i64 i64) IntervalSort)
(sort MLTL)
(function Var (String) MLTL)
(function And (MLTL) MLTL :assoc-comm-idem)
(function Global (IntervalSort MLTL) MLTL)
(function Future (IntervalSort MLTL) MLTL)

(let e (And (Global (Interval 0 9) (Var "a0")) (Future (Interval 2 3) (Var "a1"))
            (Global (Interval 1 4) (Var "a1")) (Future (Interval 0 7) (Var "a0"))))

(cost-model memory :script "../memory.roto")
(extract e :cost memory :solver roundingsat :proof "proofs")
(extract e :cost memory :rung splits :solver (opb "roundingsat" "--print-sol=1") :proof "proofs-splits")
;; ANCHOR_END: certificate
