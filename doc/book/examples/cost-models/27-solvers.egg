;; ANCHOR: solvers
(sort IntervalSort)
(function Interval (i64 i64) IntervalSort)
(sort MLTL)
(function Var (String) MLTL)
(function And (MLTL) MLTL :assoc-comm-idem)
(function Global (IntervalSort MLTL) MLTL)
(function Future (IntervalSort MLTL) MLTL)

(let e (And (Global (Interval 0 9) (Var "a0")) (Future (Interval 2 3) (Var "a1"))
            (Global (Interval 1 4) (Var "a1")) (Future (Interval 0 7) (Var "a0"))))

(cost-model memory :minizinc "memory.mzn")
(extract e :cost memory :rung splits :solver (minizinc "chuffed"))
(extract e :cost memory :rung splits :solver (minizinc "gecode"))
(extract e :cost memory :rung splits :solver (minizinc "highs"))
(extract e :cost memory :rung splits :solver (minizinc "coin-bc"))
; A time limit in milliseconds, passed to minizinc after the solver's name.
(extract e :cost memory :rung splits :solver (minizinc "cp-sat" "--time-limit" "60000"))
;; ANCHOR_END: solvers
