;; ANCHOR: depth
(sort E)
(function V (String) E)
(function And (E) E :assoc-comm)
(let e (And (V "a") (V "b") (V "c") (V "d")))

(cost-model depth :minizinc "27-depth.mzn")
(extract e :cost depth :rung selection :solver (minizinc "cp-sat"))
(extract e :cost depth :rung levels :solver (minizinc "cp-sat"))
(extract e :cost depth :rung binary :solver (minizinc "cp-sat"))
