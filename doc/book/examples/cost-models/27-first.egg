;; ANCHOR: first
(sort E)
(function V (String) E)
(function F (E) E)
(function Add (E E) E)
(function Twice (E) E)
(rewrite (Twice x) (Add x x))

(let e (Twice (F (F (V "a")))))
(run 1)

(cost-model dag :minizinc "27-first.mzn")
(extract e :cost dag :solver (minizinc "cp-sat"))
;; ANCHOR_END: first
