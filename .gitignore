# Ignore the `build/` directory in the package root.
/build
.DS_Store
target/

# LaTeX build artifacts
*.aux
*.log
*.out
# Not LaTeX: the expected output of the book's cost-model examples, included by chapter 24
# and compared by tests/cost_models.rs.
!doc/book/examples/cost-models/*.out
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf

# Kiro
.kiro/
session*.json
session*.md

# Claude Code: agent state, transcripts, per-tool config, and internal working
# documents that must remain available locally but are excluded from releases.
.claude/
CLAUDE.md

# Codex
.codex/
.codex-worktrees/

# sdd run evidence (ephemeral; distilled into <crate>/doc/verification/)
runs/

# bare `verus` invocations emit this into cwd
liblib.rlib

# Verus SMT solver traces (local debugging artifact, machine-specific)
.verus-solver-log/

# Regenerated by every benchmark run; the committed CSVs are the artifacts.
*.stats.json

# mdbook output for the user-facing book (doc/book/book.toml build-dir)
/doc/book/book/

# Scratch verification dumps at the repository root: never commit these.
/*.txt

# Python bytecode
__pycache__/
