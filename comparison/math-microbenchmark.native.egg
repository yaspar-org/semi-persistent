;; TYPES: machine
;; Translation of egglog tests/math-microbenchmark.egg (7b1adf2).
;; Config: native AC. Add and Mul are declared variadic :assoc-comm (one element sort),
;; the four commutativity/associativity rewrite rules are deleted, and every remaining
;; rule that matched an Add or a Mul is restated in its n-ary form with a rest variable.
;; The n-ary restatements are the load-bearing deviation; see
;; math-microbenchmark.deviations.md.
(datatype Math
    (Diff Math Math)
    (Integral Math Math)

    (Add Math :assoc-comm)
    (Sub Math Math)
    (Mul Math :assoc-comm)
    (Div Math Math)
    (Pow Math Math)
    (Ln Math)
    (Sqrt Math)

    (Sin Math)
    (Cos Math)

    (Const i64)
    (Var String))

;; The four A/C rules of the rules encoding are deleted here: the declarations above
;; give Add and Mul multiset semantics.

(rewrite (Sub a b) (Add a (Mul (Const -1) b)))
;; (rewrite (Div a b) (Mul a (Pow b (Const -1))) :when ((is-not-zero b)))

(rewrite (Add (Const 0) ..rest) (Add ..rest))
(rewrite (Mul (Const 0) ..rest) (Const 0))
(rewrite (Mul (Const 1) ..rest) (Mul ..rest))
;; Coincidence twins for the three identities: an element requires its child's
;; total multiplicity to satisfy its annotation (default exactly 1), so a 0 or
;; 1 occurring k >= 2 times needs its own rule. This file has no constant fold
;; to normalize multiplicities, so the identities cover k directly.
(rewrite (Add (Const 0):k>=2 ..rest) (Add ..rest))
(rewrite (Mul (Const 0):k>=2 ..rest) (Const 0))
(rewrite (Mul (Const 1):k>=2 ..rest) (Mul ..rest))

(rewrite (Sub a a) (Const 0))

;; Distribution, n-ary: peel one summand off the Add factor.
(rewrite (Mul (Add b ..s) ..rest) (Add (Mul b ..rest) (Mul (Add ..s) ..rest)))
;; Coincidence twin: the Add factor at multiplicity k >= 2 distributes one
;; copy and keeps k-1 (RHS multiplicity expression; 0 omits).
(rewrite (Mul (Add b ..s):k>=2 ..rest)
         (Add (Mul b (Add b ..s):(u64::- k 1) ..rest)
              (Mul (Add ..s) (Add b ..s):(u64::- k 1) ..rest)))
;; Factoring, n-ary: two Mul summands sharing a factor, inside any Add.
(rewrite (Add (Mul a ..p) (Mul a ..q) ..rest)
         (Add (Mul a (Add (Mul ..p) (Mul ..q))) ..rest))
;; Coincidence twin: an element consumes its child's whole multiplicity and two
;; elements bind distinct children (partition semantics), so the same Mul
;; summand at multiplicity k >= 2 needs its own rule; k is readable as an i64.
(rewrite (Add (Mul a ..p):k>=2 ..rest)
         (Add (Mul a (Const k) ..p) ..rest))

(rewrite (Mul (Pow a b) (Pow a c) ..rest) (Mul (Pow a (Add b c)) ..rest))
;; Coincidence twin: the same Pow factor taken k times ((a^b)^k = a^(b*k)).
(rewrite (Mul (Pow a b):k>=2 ..rest) (Mul (Pow a (Mul (Const k) b)) ..rest))
(rewrite (Pow x (Const 1)) x)
(rewrite (Pow x (Const 2)) (Mul x x))

;; Sum rule and product rule, n-ary: peel one operand, recurse on the remainder.
(rewrite (Diff x (Add a ..s)) (Add (Diff x a) (Diff x (Add ..s))))
(rewrite (Diff x (Mul a ..s)) (Add (Mul a (Diff x (Mul ..s))) (Mul (Mul ..s) (Diff x a))))

(rewrite (Diff x (Sin x)) (Cos x))
(rewrite (Diff x (Cos x)) (Mul (Const -1) (Sin x)))

(rewrite (Integral (Const 1) x) x)
(rewrite (Integral (Cos x) x) (Sin x))
(rewrite (Integral (Sin x) x) (Mul (Const -1) (Cos x)))
(rewrite (Integral (Add f ..s) x) (Add (Integral f x) (Integral (Add ..s) x)))
(rewrite (Integral (Sub f g) x) (Sub (Integral f x) (Integral g x)))
(rewrite (Integral (Mul a ..s) x)
(Sub (Mul a (Integral (Mul ..s) x))
    (Integral (Mul (Diff x a) (Integral (Mul ..s) x)) x)))

(Integral (Ln (Var "x")) (Var "x"))
(Integral (Add (Var "x") (Cos (Var "x"))) (Var "x"))
(Integral (Mul (Cos (Var "x")) (Var "x")) (Var "x"))
(Diff (Var "x") (Add (Const 1) (Mul (Const 2) (Var "x"))))
(Diff (Var "x") (Sub (Pow (Var "x") (Const 3)) (Mul (Const 7) (Pow (Var "x") (Const 2)))))
(Add (Mul (Var "y") (Add (Var "x") (Var "y"))) (Sub (Add (Var "x") (Const 2)) (Add (Var "x") (Var "x"))))
(Div (Const 1)
                        (Sub (Div (Add (Const 1)
                                    (Sqrt (Var "five")))
                                (Const 2))
                            (Div (Sub (Const 1)
                                    (Sqrt (Var "five")))
                                (Const 2))))
(run 11)
(print-size Add)
(print-size Mul)

(print-size)

(print-stats :file "math-microbenchmark.native.stats.json")
