;; TYPES: machine
;; Translation of egglog tests/web-demo/eqsolve.egg (7b1adf2).
;; Config: associativity and commutativity supplied as explicit rewrite rules, their
;; encoding. No native-AC dual ships; see eqsolve.deviations.md.
(datatype Expr
  (Add Expr Expr)
  (Neg Expr)
  (Num i64)
  (Mul Expr Expr)
  (Var String))

(rewrite (Add x y) (Add y x))
(rewrite (Add (Add x y) z) (Add x (Add y z)))
(rewrite (Add (Num x) (Num y)) (Num (i64::+ x y)))
(rule ((= (Add x y) z))
      ((union (Add z (Neg y)) x)))
(rewrite (Neg (Neg x)) x)
(rewrite (Neg (Num n)) (Num (i64::neg n)))

(rule ((= x (Var v))) ((union (Mul (Num 1) x) x)))
(rule ((= x (Add x1 x2))) ((union (Mul (Num 1) x) x)))
(rewrite (Add (Mul y x) (Mul z x)) (Mul (Add y z) x))
(rewrite (Mul x y) (Mul y x))
;; The rule that turns 3y = 12 into y = 4. The two patterns share a root e-class, and
;; the divisibility test is a primitive predicate over the two bound literals.
;; The x /= 0 guard has no counterpart in theirs: their `%` is partial and yields no
;; value at zero, so their rule silently does not fire; ours is total and traps. Guards
;; are lowered in the order written, so this one rejects the match before the remainder
;; is computed. See eqsolve.deviations.md.
(rule ((= (Mul (Num x) y) (Num z))
       (i64::!= x 0)
       (i64::== (i64::% z x) 0))
      ((union y (Num (i64::/ z x)))))

; system 1: x + 2 = 7
(union (Add (Var "x") (Num 2)) (Num 7))
; system 2: z + y = 6, 2z = y
(union (Add (Var "z") (Var "y")) (Num 6))
(union (Add (Var "z") (Var "z")) (Var "y"))

;; (run 5) upstream. Raised to 6 in both configurations so that both engines reach the
;; benchmark's three answers; see eqsolve.deviations.md.
(run 6)
(extract (Var "x"))
(extract (Var "y"))
(extract (Var "z"))
(check (= (Var "z") (Add (Num 6) (Neg (Var "y")))))
(check (= (Var "y") (Add (Add (Num 6) (Neg (Var "y"))) (Add (Num 6) (Neg (Var "y"))))))
(check (= (Var "y") (Add (Add (Num 12) (Neg (Var "y"))) (Neg (Var "y")))))
(check (= (Add (Var "y") (Var "y"))
          (Add (Num 12) (Neg (Var "y")))))
(check (= (Add (Add (Var "y") (Var "y")) (Var "y"))
          (Num 12)))
(check (= (Add (Mul (Num 2) (Var "y")) (Var "y"))
          (Num 12)))
(check (= (Mul (Num 3) (Var "y"))
          (Num 12)))
;; The three answers the extractions above print, asserted rather than only printed;
;; added to both configurations. Our extractor prints (Var "x") where theirs prints
;; (Num 5): the classes agree, the cost tie breaks the other way. See
;; eqsolve.deviations.md.
(check (= (Var "x") (Num 5)))
(check (= (Var "y") (Num 4)))
(check (= (Var "z") (Num 2)))

(print-size)
(print-stats :file "eqsolve.rules.stats.json")
