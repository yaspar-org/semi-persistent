
(datatype Num (N i64) (Add Num Num))
; instead of (rewrite (Add a b) (Add b a))
(rule ((= e (Add a b))) ((union (Add b a) e)))
; instead of (rewrite (Add a (Add b c)) (Add (Add a b) c))
(rule ((= e (Add a (Add b c)))) ((union (Add (Add a b) c) e)))

(let _lit0 (N 0))
(let _lit1 (N 1))
(let _lit2 (N 2))
(let _lit3 (N 3))
(let _lit4 (N 4))
(let _lit5 (N 5))
(let _lit6 (N 6))
(let _lit7 (N 7))
(let _lit8 (N 8))
(let _lit9 (N 9))
(let _lit10 (N 10))
(let _v0 (Add _lit0 _lit1))
(let _v1 (Add _lit2 _v0))
(let _v2 (Add _lit3 _v1))
(let _v3 (Add _lit4 _v2))
(let _v4 (Add _lit5 _v3))
(let _v5 (Add _lit6 _v4))
(let _v6 (Add _lit7 _v5))
(let _v7 (Add _lit8 _v6))
(let _v8 (Add _lit9 _v7))
(let _v9 (Add _lit10 _v8))
(let _r0 (Add _lit10 _lit9))
(let _r1 (Add _r0 _lit0))
(let _r2 (Add _r1 _lit1))
(let _r3 (Add _r2 _lit2))
(let _r4 (Add _r3 _lit3))
(let _r5 (Add _r4 _lit4))
(let _r6 (Add _r5 _lit5))
(let _r7 (Add _r6 _lit6))
(let _r8 (Add _r7 _lit7))
(let _r9 (Add _r8 _lit8))
(run 10000)
(check (= _r9 _v9))
