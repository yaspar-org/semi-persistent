;; TYPES: machine
;; add-ac width-scaling sweep, n = 11.  Generated by gen-addac-sweep.py.
;; Config: native AC.  Add is declared variadic :assoc-comm and the two rewrite rules
;; are deleted; the ruleset is kept declared and still run, so the command sequence
;; matches addac-n11.rules.egg.  The goal holds at construction, so the run is (run 1)
;; rather than the :until form.  See addac-sweep.md.

(datatype Math
    (Add Math :assoc-comm)
    (Const f64))

(ruleset add_ac)
;; Add one through 11, right-nested
(let res
  (Add (Const 1.0)
     (Add (Const 2.0)
          (Add (Const 3.0)
               (Add (Const 4.0)
                    (Add (Const 5.0)
                         (Add (Const 6.0)
                              (Add (Const 7.0)
                                   (Add (Const 8.0)
                                        (Add (Const 9.0)
                                             (Add (Const 10.0)
                                                  (Const 11.0))))))))))))
;; The goal term, 11 down to one.  It flattens to the same multiset as res at
;; construction, so the two are already one class before the run.
(let goal
  (Add (Const 11.0)
     (Add (Const 10.0)
          (Add (Const 9.0)
               (Add (Const 8.0)
                    (Add (Const 7.0)
                         (Add (Const 6.0)
                              (Add (Const 5.0)
                                   (Add (Const 4.0)
                                        (Add (Const 3.0)
                                             (Add (Const 2.0)
                                                  (Const 1.0))))))))))))
(run add_ac 1)
(check (= res goal))
(print-size)
(print-stats :file "addac-n11.native.stats.json")
