;; TYPES: machine
;; add-ac width-scaling sweep, n = 24.  Generated by gen-addac-sweep.py.
;; Config: A/C modelled as explicit rewrite rules, egglog's own encoding.
;; Same datatype, same two rules, same budget and same goal as addac-n24.egglog.egg.
;; See addac-sweep.md.

(datatype Math
    (Add Math Math)
    (Const f64))

(ruleset add_ac)
(rewrite (Add a b) (Add b a) :ruleset add_ac)
(rewrite (Add a (Add b c)) (Add (Add a b) c) :ruleset add_ac)
;; Add one through 24, right-nested
(let res
  (Add (Const 1.0)
     (Add (Const 2.0)
          (Add (Const 3.0)
               (Add (Const 4.0)
                    (Add (Const 5.0)
                         (Add (Const 6.0)
                              (Add (Const 7.0)
                                   (Add (Const 8.0)
                                        (Add (Const 9.0)
                                             (Add (Const 10.0)
                                                  (Add (Const 11.0)
                                                       (Add (Const 12.0)
                                                            (Add (Const 13.0)
                                                                 (Add (Const 14.0)
                                                                      (Add (Const 15.0)
                                                                           (Add (Const 16.0)
                                                                                (Add (Const 17.0)
                                                                                     (Add (Const 18.0)
                                                                                          (Add (Const 19.0)
                                                                                               (Add (Const 20.0)
                                                                                                    (Add (Const 21.0)
                                                                                                         (Add (Const 22.0)
                                                                                                              (Add (Const 23.0)
                                                                                                                   (Const 24.0)))))))))))))))))))))))))
;; The goal term, 24 down to one.
(let goal
  (Add (Const 24.0)
     (Add (Const 23.0)
          (Add (Const 22.0)
               (Add (Const 21.0)
                    (Add (Const 20.0)
                         (Add (Const 19.0)
                              (Add (Const 18.0)
                                   (Add (Const 17.0)
                                        (Add (Const 16.0)
                                             (Add (Const 15.0)
                                                  (Add (Const 14.0)
                                                       (Add (Const 13.0)
                                                            (Add (Const 12.0)
                                                                 (Add (Const 11.0)
                                                                      (Add (Const 10.0)
                                                                           (Add (Const 9.0)
                                                                                (Add (Const 8.0)
                                                                                     (Add (Const 7.0)
                                                                                          (Add (Const 6.0)
                                                                                               (Add (Const 5.0)
                                                                                                    (Add (Const 4.0)
                                                                                                         (Add (Const 3.0)
                                                                                                              (Add (Const 2.0)
                                                                                                                   (Const 1.0)))))))))))))))))))))))))
(run add_ac 50 :until (= res goal))
(check (= res goal))
(print-size)
(print-stats :file "addac-n24.rules.stats.json")
